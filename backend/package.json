{
    "name": "wendo-rms-backend",
    "version": "1.0.0",
    "private": true,
    "description": "Wendo RMS backend service",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "pnpm prisma:generate && node -e \"const fs=require('fs');if(fs.existsSync('dist'))fs.rmSync('dist',{recursive:true})\" && tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "lint": "eslint .",
        "check:imports": "depcruise src tests --config .dependency-cruiser.cjs",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "seed:admin": "tsx src/scripts/seed-admin.ts",
        "seed:reports": "tsx src/scripts/seed-report-orders.ts",
        "menu:import": "tsx src/scripts/import-menu.ts",
        "menu:import-images": "tsx src/scripts/import-menu-images.ts",
        "socket:test-client": "tsx src/scripts/socket-test-client.ts",
        "verify:schema": "tsx src/scripts/verify-schema.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1142.0",
        "@aws-sdk/s3-request-presigner": "^3.1142.0",
        "@prisma/client": "^6.16.2",
        "@sentry/node": "^10.51.0",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.70.0",
        "cloudinary": "^2.9.0",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "firebase-admin": "^13.6.1",
        "ioredis": "^5.9.2",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.0.2",
        "pdfkit": "^0.17.2",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "socket.io": "^4.8.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcryptjs": "^3.0.0",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^25.3.0",
        "@types/pdfkit": "^0.17.5",
        "@types/supertest": "^6.0.3",
        "dependency-cruiser": "^17.4.3",
        "eslint": "^10.0.1",
        "eslint-config-prettier": "^10.1.8",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.8.1",
        "prisma": "^6.16.2",
        "socket.io-client": "^4.8.3",
        "supertest": "^7.2.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.0",
        "vitest": "^4.0.18"
    },
    "prisma": {
        "schema": "prisma/schema"
    }
}
