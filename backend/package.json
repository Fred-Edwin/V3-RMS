{
    "name": "wendo-rms-backend",
    "version": "1.0.0",
    "private": true,
    "description": "Wendo RMS backend service",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "seed:admin": "tsx src/scripts/seed-admin.ts",
        "socket:test-client": "tsx src/scripts/socket-test-client.ts",
        "verify:schema": "tsx src/scripts/verify-schema.ts"
    },
    "dependencies": {
        "@prisma/client": "^6.16.2",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.70.0",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "ioredis": "^5.9.2",
        "jsonwebtoken": "^9.0.3",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "socket.io": "^4.8.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcryptjs": "^3.0.0",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.3.0",
        "@types/supertest": "^6.0.3",
        "eslint": "^10.0.1",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.8.1",
        "prisma": "^6.16.2",
        "socket.io-client": "^4.8.3",
        "supertest": "^7.2.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.0",
        "vitest": "^4.0.18"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@prisma/client",
            "prisma"
        ]
    }
}
