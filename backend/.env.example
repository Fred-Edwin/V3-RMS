JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
SYSTEM_ADMIN_EMAIL=admin@wendo.co.ke
SYSTEM_ADMIN_PASSWORD=ChangeMe123!
LOG_LEVEL=info
LOG_PRETTY=false
START_BULLMQ_WORKERS=false



