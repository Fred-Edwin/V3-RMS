// ============================================================================
// Milestone Two — Receiving & Supplier AP
// Stage 1 (Buying/estimate), Stage 2 (Receiving), Stage 10 (Supplier payment).
// Plan: docs/features/inventory/milestone-2-plan.md.
// ============================================================================

/// Reference-number counters (GRN-, EXP-, …), one row per (org, prefix).
/// Incremented inside the same transaction as the document it numbers, so
/// numbers stay gap-free — a printed, signed document with a missing number
/// looks like a lost record with no way to prove otherwise. Same pattern as
/// OrderCounter, generalized across document types instead of reset per day.
model ReferenceCounter {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  prefix         String // "GRN", "EXP"
  lastNumber     Int      @default(0) @map("last_number")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, prefix])
  @@index([organizationId])
  @@map("reference_counters")
}

enum ExpectedDeliveryStatus {
  AWAITING
  FULFILLED
  CANCELLED
}

/// Stage 1 (Buying) — an estimate, explicitly NOT a purchase order
/// (01-description.md §3 Stage 1, §7: "Purchase orders are removed
/// entirely"). Writes no ledger entry; the goods receipt (below) is the only
/// thing that ever moves stock.
model ExpectedDelivery {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  reference      String // "EXP-0091", generated via ReferenceCounter
  // AMENDMENT 2026-09-17 (New purchase redesign, receiving-validators.ts):
  // nullable — a purchase list may be saved with no supplier (a pure shopping
  // list). paymentTerms is nullable in lockstep: terms are meaningless without
  // a supplier to owe them to, and the New-purchase screen greys the field out
  // until a supplier is picked. See receiving-validators.ts's header comment
  // for the full amendment record.
  supplierId     String?                @map("supplier_id")
  paymentTerms   SupplierPaymentTerms?  @map("payment_terms") // defaulted from supplier, per-record; null when supplierId is null
  status         ExpectedDeliveryStatus @default(AWAITING)
  expectedDate   DateTime?              @map("expected_date")
  // Stored, not derived: an estimate that never needs to reconcile with
  // anything (the receipt supersedes it) — storing avoids a per-row line
  // aggregation on the Purchasing hub's hottest query. See plan §1.1.
  estimatedTotal Decimal                @default(0) @map("estimated_total") @db.Decimal(12, 2)
  createdById    String                 @map("created_by_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  organization  Organization           @relation(fields: [organizationId], references: [id])
  supplier      Supplier?              @relation(fields: [supplierId], references: [id])
  createdBy     User                   @relation("ExpectedDeliveryCreatedBy", fields: [createdById], references: [id])
  lines         ExpectedDeliveryLine[]
  goodsReceipts GoodsReceipt[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([supplierId])
  @@map("expected_deliveries")
}

model ExpectedDeliveryLine {
  id                 String  @id @default(uuid())
  expectedDeliveryId String  @map("expected_delivery_id")
  inventoryItemId    String  @map("inventory_item_id")
  quantity           Decimal @db.Decimal(12, 4) // in the item's BUY unit
  estimatedUnitPrice Decimal @map("estimated_unit_price") @db.Decimal(12, 4)
  lineOrder          Int     @map("line_order")

  expectedDelivery ExpectedDelivery @relation(fields: [expectedDeliveryId], references: [id], onDelete: Cascade)
  inventoryItem    InventoryItem    @relation(fields: [inventoryItemId], references: [id])

  @@index([expectedDeliveryId])
  @@index([inventoryItemId])
  @@map("expected_delivery_lines")
}

/// DRAFT holds an unsigned receipt (UQE-0's "Save draft" vs "Sign & save");
/// no ledger rows exist while DRAFT. RECEIVED_INVOICE_PENDING vs RECEIVED_PAID
/// is the payment-terms branch that decides whether AP is ever created
/// (01-description.md §3 Stage 2). INVOICE_RECORDED is set once Flow 14 runs.
enum GoodsReceiptStatus {
  DRAFT
  RECEIVED_INVOICE_PENDING
  RECEIVED_PAID
  INVOICE_RECORDED
  CANCELLED
}

/// Stage 2 (Receiving) — every item entering the company lands here first
/// (01-description.md §3 Stage 2: "There is no other inbound path"). The
/// first writer to InventoryTransaction (plan §0, §1.6).
model GoodsReceipt {
  id                 String               @id @default(uuid())
  organizationId     String               @map("organization_id")
  reference          String // "GRN-1042", generated via ReferenceCounter
  supplierId         String               @map("supplier_id")
  expectedDeliveryId String?              @map("expected_delivery_id") // nullable: receiving without an estimate is allowed (Flow 1)
  paymentTerms       SupplierPaymentTerms @map("payment_terms") // defaulted from supplier, editable per receipt
  status             GoodsReceiptStatus   @default(DRAFT)
  supplierDocNumber  String?              @map("supplier_doc_number") // "INVOICE / DELIVERY NOTE No." — nullable per Flow 2a
  supplierDocDate    DateTime?            @map("supplier_doc_date")
  receiptTotal       Decimal              @default(0) @map("receipt_total") @db.Decimal(12, 2) // snapshot at signing, immutable
  locationId         String               @map("location_id") // the CENTRAL_STORE location
  signedById         String?              @map("signed_by_id")
  signedAt           DateTime?            @map("signed_at")
  createdById        String               @map("created_by_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  organization      Organization             @relation(fields: [organizationId], references: [id])
  supplier          Supplier                 @relation(fields: [supplierId], references: [id])
  expectedDelivery  ExpectedDelivery?        @relation(fields: [expectedDeliveryId], references: [id])
  location          Location                 @relation(fields: [locationId], references: [id])
  signedBy          User?                    @relation("GoodsReceiptSignedBy", fields: [signedById], references: [id])
  createdBy         User                     @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id])
  lines             GoodsReceiptLine[]
  invoices          SupplierInvoiceReceipt[]
  supplierDocuments SupplierDocument[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([supplierId])
  @@index([expectedDeliveryId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                     String   @id @default(uuid())
  goodsReceiptId         String   @map("goods_receipt_id")
  inventoryItemId        String   @map("inventory_item_id")
  quantityBuyUnit        Decimal  @map("quantity_buy_unit") @db.Decimal(12, 4) // as entered ("18.0 kg", "2 pkt")
  quantityUsageUnit      Decimal  @map("quantity_usage_unit") @db.Decimal(12, 4) // computed at save via conversionFactor; what hits the ledger
  unitPrice              Decimal  @map("unit_price") @db.Decimal(12, 4) // per BUY unit, as invoiced
  lineTotal              Decimal  @map("line_total") @db.Decimal(12, 2)
  lineOrder              Int      @map("line_order")
  // Price-alert snapshot — persisted, never recomputed. By the time the
  // signed receipt is read back, latest-price costing has already
  // overwritten InventoryItem.currentCost, so the comparison price is gone.
  // See plan §1.2.
  priceAlertPct          Decimal? @map("price_alert_pct") @db.Decimal(6, 2) // null = no alert fired
  priceAlertPrevPrice    Decimal? @map("price_alert_prev_price") @db.Decimal(12, 4)
  priceAlertAcceptedById String?  @map("price_alert_accepted_by_id")
  // The pack the goods were bought in (what the supplier catalog line key matches on).
  // Null = not stated. `packNotOnFile` is stamped at signing when the supplier had lines
  // for the item but none matched, so no catalog price was written.
  packBuyUnit            String?  @map("pack_buy_unit")
  packSize               Decimal? @map("pack_size") @db.Decimal(12, 4)
  packNotOnFile          Boolean  @default(false) @map("pack_not_on_file")

  goodsReceipt         GoodsReceipt           @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  inventoryItem        InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  priceAlertAcceptedBy User?                  @relation("GoodsReceiptLinePriceAlertAcceptedBy", fields: [priceAlertAcceptedById], references: [id])
  ledgerTransactions   InventoryTransaction[]

  @@index([goodsReceiptId])
  @@index([inventoryItemId])
  @@map("goods_receipt_lines")
}

enum SupplierInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

/// Deliberately NOT folded into SupplierInvoiceStatus — a disputed invoice
/// still ages and can still be paid (Flow 17a), so dispute and payment status
/// must be independently representable. See plan §1.3.
enum DisputeStatus {
  OPEN
  RESOLVED
}

/// Stage 10 (Supplier payment) — a running tab per supplier, Flow 14.
model SupplierInvoice {
  id               String                @id @default(uuid())
  organizationId   String                @map("organization_id")
  supplierId       String                @map("supplier_id")
  invoiceNumber    String                @map("invoice_number") // supplier's own number
  invoiceDate      DateTime              @map("invoice_date")
  // Computed once at creation as invoiceDate + supplier.paymentDays, then
  // stored — a later change to the supplier's terms must not retroactively
  // shift the due date of an invoice already on the books. See plan §1.3.
  dueDate          DateTime              @map("due_date")
  amountBilled     Decimal               @map("amount_billed") @db.Decimal(12, 2) // as stated on their document
  status           SupplierInvoiceStatus @default(UNPAID)
  disputeStatus    DisputeStatus?        @map("dispute_status")
  disputeOurFigure Decimal?              @map("dispute_our_figure") @db.Decimal(12, 2)
  disputeReason    String?               @map("dispute_reason")
  recordedById     String                @map("recorded_by_id")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  organization      Organization                @relation(fields: [organizationId], references: [id])
  supplier          Supplier                    @relation(fields: [supplierId], references: [id])
  recordedBy        User                        @relation("SupplierInvoiceRecordedBy", fields: [recordedById], references: [id])
  receipts          SupplierInvoiceReceipt[]
  adjustments       SupplierInvoiceAdjustment[]
  allocations       SupplierPaymentAllocation[]
  supplierDocuments SupplierDocument[]

  @@unique([organizationId, supplierId, invoiceNumber])
  @@index([organizationId, status])
  @@index([supplierId, dueDate])
  @@map("supplier_invoices")
}

/// Join — an invoice bundles MANY receipts (UZJ-0's "RECEIPTS TO BUNDLE"
/// checkbox list; Flow 14: "One invoice covers multiple receipts").
model SupplierInvoiceReceipt {
  supplierInvoiceId String @map("supplier_invoice_id")
  goodsReceiptId    String @map("goods_receipt_id")

  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  goodsReceipt    GoodsReceipt    @relation(fields: [goodsReceiptId], references: [id])

  @@id([supplierInvoiceId, goodsReceiptId])
  @@index([goodsReceiptId])
  @@map("supplier_invoice_receipts")
}

/// The Accountant's reconciliation adjustment (Flow 17) — mandatory reason,
/// changes the invoice's outstanding figure. No stock ledger entry; the
/// Accountant cannot move stock (01-description.md §2).
model SupplierInvoiceAdjustment {
  id                String   @id @default(uuid())
  supplierInvoiceId String   @map("supplier_invoice_id")
  amount            Decimal  @db.Decimal(12, 2)
  reason            String
  recordedById      String   @map("recorded_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  recordedBy      User            @relation("SupplierInvoiceAdjustmentRecordedBy", fields: [recordedById], references: [id])

  @@index([supplierInvoiceId])
  @@map("supplier_invoice_adjustments")
}

enum SupplierPaymentMethod {
  BANK
  CASH
  MPESA
  CHEQUE
}

/// Flow 15 — payments are immutable once saved; a correction is a reversal
/// (negative allocation) with a reason, never an edit or delete.
model SupplierPayment {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  supplierId     String                @map("supplier_id")
  amount         Decimal               @db.Decimal(12, 2) // may exceed the sum of allocations -> credit
  paidAt         DateTime              @map("paid_at")
  method         SupplierPaymentMethod
  reference      String? // "EFT-88213"
  reversalOfId   String?               @map("reversal_of_id")
  reversalReason String?               @map("reversal_reason")
  recordedById   String                @map("recorded_by_id")
  createdAt      DateTime              @default(now()) @map("created_at")

  organization Organization                @relation(fields: [organizationId], references: [id])
  supplier     Supplier                    @relation(fields: [supplierId], references: [id])
  recordedBy   User                        @relation("SupplierPaymentRecordedBy", fields: [recordedById], references: [id])
  reversalOf   SupplierPayment?            @relation("SupplierPaymentReversal", fields: [reversalOfId], references: [id])
  reversals    SupplierPayment[]           @relation("SupplierPaymentReversal")
  allocations  SupplierPaymentAllocation[]

  @@index([organizationId, supplierId])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id                String  @id @default(uuid())
  supplierPaymentId String  @map("supplier_payment_id")
  supplierInvoiceId String  @map("supplier_invoice_id")
  amount            Decimal @db.Decimal(12, 2) // negative allowed ONLY on a reversal payment's allocation

  supplierPayment SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id])

  @@unique([supplierPaymentId, supplierInvoiceId])
  @@index([supplierInvoiceId])
  @@map("supplier_payment_allocations")
}
