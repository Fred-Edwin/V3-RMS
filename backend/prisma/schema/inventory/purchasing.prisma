// ============================================================================
// Purchasing: the reference-number counters. The purchase file itself (orders, deliveries, invoices,
// payments, documents, audit) is in purchase-orders.prisma. The old Milestone Two models (ExpectedDelivery,
// GoodsReceipt, SupplierInvoice, SupplierPayment and their lines) were dropped in `drop_old_purchasing`.
// ============================================================================

/// Reference-number counters (LPO-, GRN-, PAY-, …), one row per (site, prefix).
/// Incremented inside the same transaction as the document it numbers, so
/// numbers stay gap-free — a printed, signed document with a missing number
/// looks like a lost record with no way to prove otherwise. Same pattern as
/// OrderCounter, generalized across document types instead of reset per day.
model ReferenceCounter {
  id         String   @id @default(uuid())
  siteId     String   @map("organization_id")
  prefix     String // "LPO", "GRN", "PAY"
  lastNumber Int      @default(0) @map("last_number")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id])

  @@unique([siteId, prefix])
  @@index([siteId])
  @@map("reference_counters")
}
