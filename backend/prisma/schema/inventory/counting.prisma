// ── Count thresholds ─────────────────────────────────────────────────────────
// The old StockCount and StockCountLine models, their enums and the ledger's
// `stock_count_line_id` link were dropped by `stock_count_waste_contract`
// (8 Oct 2026); counts now live in `inventory/counts.prisma`.

/// One row per organization, created lazily with defaults (plan §1.9). Values
/// are whole KES of |variance| × unit cost. Hub row: reasonRequiredKes (Store
/// Manager) + directorAlertKes (Director, company-wide). Branch rows (Session
/// 3): reasonRequiredKes + overnightAlertKes.
model CountingThresholds {
  id                   String    @id @default(uuid())
  siteId               String    @unique @map("organization_id")
  reasonRequiredKes    Int       @map("reason_required_kes")
  overnightAlertKes    Int?      @map("overnight_alert_kes")
  directorAlertKes     Int?      @map("director_alert_kes")
  // The Central Store rebuild (contract §2.3): the range's "at most" percent and the repeat-shortfall switch.
  rangePercent         Decimal   @default(5) @map("range_percent") @db.Decimal(5, 2)
  flagRepeatShortfalls Boolean   @default(true) @map("flag_repeat_shortfalls")
  updatedById          String?   @map("updated_by_id")
  directorUpdatedById  String?   @map("director_updated_by_id")
  directorUpdatedAt    DateTime? @map("director_updated_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  site              Site  @relation(fields: [siteId], references: [id])
  updatedBy         User? @relation("CountingThresholdsUpdatedBy", fields: [updatedById], references: [id])
  directorUpdatedBy User? @relation("CountingThresholdsDirectorUpdatedBy", fields: [directorUpdatedById], references: [id])

  @@map("counting_thresholds")
}
