// ============================================================================
// Milestone Three — Prep
// Stage 3 (after-the-fact prep run recording: inputs consumed -> output
// produced, one atomic ledger transaction). Second writer to the stock
// ledger after Milestone Two, and the first writer of a negative-signed
// ledger row (PREP_CONSUME) — see PrepRunInputLine's comment.
// Plan: docs/features/inventory/milestone-3-plan.md §1.
// ============================================================================

/// One run = one output item produced from N input lines, in one atomic
/// transaction. No reference number (unlike GoodsReceipt/ExpectedDelivery) —
/// checked against all 8 approved Paper screens, none show one; a run is
/// identified by when/output/attendant instead (plan §1.1). No updatedAt, no
/// status enum, no signature fields — immutable from the instant it's
/// confirmed (Flow 3's "prep runs are immutable once confirmed... to keep the
/// ledger append-only"); there is no PATCH/DELETE endpoint, ever.
model PrepRun {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  outputItemId          String   @map("output_item_id")
  actualYield           Decimal  @map("actual_yield") @db.Decimal(12, 4)
  /// Snapshot: totalInputCost / actualYield. Becomes InventoryItem.currentCost
  /// on the output item at write time (latest-price costing, no averaging).
  outputUnitCost        Decimal  @map("output_unit_cost") @db.Decimal(12, 4)
  /// Snapshot, sum of input lines' lineCost — stored, not derived, so an
  /// immutable record doesn't drift if a later query changes how it's
  /// computed (same rationale as GoodsReceipt.receiptTotal).
  totalInputCost        Decimal  @map("total_input_cost") @db.Decimal(12, 2)
  /// The rolling-average figure shown on the Confirm screen at the moment of
  /// this run, snapshotted — null only when no prior runs exist for this
  /// output item yet (plan §1.3). Never recomputed against a later, now-
  /// different rolling average.
  typicalYieldAtRunTime Decimal? @map("typical_yield_at_run_time") @db.Decimal(12, 4)
  /// 'normal' | 'low yield' | 'high yield', derived at write time from
  /// actualYield vs typicalYieldAtRunTime against the ±15% warn threshold
  /// (plan §6 Q1). Null ONLY when typicalYieldAtRunTime is null (no data to
  /// compare against, unflaggable) — once a typical exists, this is always
  /// one of the three string values, never left null, so a 'normal' run and
  /// an "insufficient data" run stay distinguishable (contract gap resolved
  /// at S0 build time, prep-validators.ts's own header comment).
  yieldVarianceLabel    String?  @map("yield_variance_label")
  /// Did this run cross the ±35% notify-Store-Manager threshold (plan §6
  /// Q1)? Records the fact only — no notification delivery is built this
  /// milestone (plan §0).
  notifiedStoreManager  Boolean  @default(false) @map("notified_store_manager")
  locationId            String   @map("location_id") // Central Store, same pattern as GoodsReceipt.locationId
  createdById           String   @map("created_by_id") // the Attendant (or SM, desktop) who recorded it
  createdAt             DateTime @default(now()) @map("created_at")

  organization Organization           @relation(fields: [organizationId], references: [id])
  outputItem   InventoryItem          @relation("PrepRunOutput", fields: [outputItemId], references: [id])
  location     Location               @relation(fields: [locationId], references: [id])
  createdBy    User                   @relation("PrepRunCreatedBy", fields: [createdById], references: [id])
  inputLines   PrepRunInputLine[]
  transactions InventoryTransaction[] @relation("PrepRunTransactions")

  @@index([organizationId])
  @@index([organizationId, outputItemId]) // rolling-average query, History "Output" filter
  @@index([locationId])
  @@map("prep_runs")
}

model PrepRunInputLine {
  id                String  @id @default(uuid())
  prepRunId         String  @map("prep_run_id")
  /// May itself be a prepped item — two-stage prep is allowed (Flow 3): the
  /// output of one PrepRun can be the input of another.
  inputItemId       String  @map("input_item_id")
  quantity          Decimal @db.Decimal(12, 4)
  /// Snapshot of InventoryItem.currentCost at the moment consumed — must
  /// never be recomputed later, since the input's cost keeps moving after
  /// this run (more receipts, more prep). Same immutability principle as
  /// GoodsReceiptLine.priceAlertPrevPrice.
  unitCostAtRunTime Decimal @map("unit_cost_at_run_time") @db.Decimal(12, 4)
  /// quantity * unitCostAtRunTime, stored.
  lineCost          Decimal @map("line_cost") @db.Decimal(12, 2)
  lineOrder         Int     @map("line_order")

  prepRun   PrepRun       @relation(fields: [prepRunId], references: [id], onDelete: Cascade)
  inputItem InventoryItem @relation("PrepRunInputItem", fields: [inputItemId], references: [id])

  @@index([prepRunId])
  @@index([inputItemId])
  @@map("prep_run_input_lines")
}
