// ============================================================================
// Prep — runs (inputs consumed, one output produced, one atomic ledger
// transaction). Rebuilt in the Prep rebuild (docs/features/inventory/prep-plan.md §1).
// Usual recipes live in prep-recipes.prisma. The stock ledger is written only
// through postStockMovement (backend/src/modules/inventory/stock/ledger/).
// ============================================================================

enum PrepRunStatus {
  RECORDED
  CORRECTED
  CANCELLED
}

enum PrepCorrectReason {
  TYPO
  WRONG_ITEM
  WRONG_QUANTITY
  OTHER
}

enum PrepCancelReason {
  ENTERED_TWICE
  NEVER_MADE
  WRONG_ITEM
  OTHER
}

enum PrepYieldReason {
  TRIMMED_MORE
  SPILLAGE
  BURNT
  OTHER
}

enum PrepExpectedSource {
  RECIPE
  PAST_RUNS
  NONE
}

/// One run = one output item made from N input lines, in one atomic
/// transaction, numbered PREP-nnnn per site. Immutable once recorded: a slip
/// is fixed by a correction (the old run becomes CORRECTED, a new RECORDED run
/// points back at it through replacesRunId) or a cancel (status CANCELLED);
/// the ledger rows are never edited, only reversed by linked rows.
model PrepRun {
  id                   String   @id @default(uuid())
  siteId               String   @map("organization_id")
  /// PREP-0131. Nullable only because the old code did not write it; the new
  /// service always sets it from the reference counter (prefix PREP).
  reference            String?
  outputItemId         String   @map("output_item_id")
  actualYield          Decimal  @map("actual_yield") @db.Decimal(12, 4)
  /// Snapshot: totalInputCost / actualYield. Becomes InventoryItem.currentCost
  /// on the output item when this is the latest RECORDED run of that item.
  outputUnitCost       Decimal  @map("output_unit_cost") @db.Decimal(12, 4)
  /// Snapshot, sum of input lines' lineCost — stored, not derived.
  totalInputCost       Decimal  @map("total_input_cost") @db.Decimal(12, 2)
  /// 'normal' | 'low yield' | 'high yield'; null when there was nothing to judge by.
  yieldVarianceLabel   String?  @map("yield_variance_label")
  /// Crossed the 35% notify threshold. In-app flag only, no push.
  notifiedStoreManager Boolean  @default(false) @map("notified_store_manager")
  locationId           String   @map("location_id")
  createdById          String   @map("created_by_id")
  createdAt            DateTime @default(now()) @map("created_at")

  status           PrepRunStatus      @default(RECORDED)
  /// A correction points at the run it replaces; a run is replaced once.
  replacesRunId    String?            @unique @map("replaces_run_id")
  /// When and who corrected or cancelled this run.
  closedAt         DateTime?          @map("closed_at")
  closedById       String?            @map("closed_by_id")
  /// Set on the NEW run of a correction.
  correctionReason PrepCorrectReason? @map("correction_reason")
  /// Set on the cancelled run.
  cancelReason     PrepCancelReason?  @map("cancel_reason")
  /// Free text when a reason is OTHER.
  reasonNote       String?            @map("reason_note")
  /// The Attendant's optional "Say why" for an off-target yield.
  yieldReason      PrepYieldReason?   @map("yield_reason")
  /// The figure this run was judged against, and where it came from.
  expectedYield    Decimal?           @map("expected_yield") @db.Decimal(12, 4)
  expectedSource   PrepExpectedSource @default(NONE) @map("expected_source")
  recipeVersionId  String?            @map("recipe_version_id")
  /// Silent flag: an input exceeded the stock the ledger showed. Never sent to an Attendant.
  stockFlag        Boolean            @default(false) @map("stock_flag")
  /// In the manager's Needs a look queue until Mark reviewed.
  needsLook        Boolean            @default(false) @map("needs_look")
  reviewedAt       DateTime?          @map("reviewed_at")
  reviewedById     String?            @map("reviewed_by_id")
  /// Double-tap guard: unique per (site, user, key).
  idempotencyKey   String?            @map("idempotency_key")

  site          Site                   @relation(fields: [siteId], references: [id])
  outputItem    InventoryItem          @relation("PrepRunOutput", fields: [outputItemId], references: [id])
  location      Location               @relation(fields: [locationId], references: [id])
  createdBy     User                   @relation("PrepRunCreatedBy", fields: [createdById], references: [id])
  closedBy      User?                  @relation("PrepRunClosedBy", fields: [closedById], references: [id])
  reviewedBy    User?                  @relation("PrepRunReviewedBy", fields: [reviewedById], references: [id])
  replacesRun   PrepRun?               @relation("PrepRunReplaces", fields: [replacesRunId], references: [id])
  replacedByRun PrepRun?               @relation("PrepRunReplaces")
  recipeVersion PrepRecipeVersion?     @relation(fields: [recipeVersionId], references: [id])
  inputLines    PrepRunInputLine[]
  transactions  InventoryTransaction[] @relation("PrepRunTransactions")

  @@unique([siteId, reference])
  @@unique([siteId, createdById, idempotencyKey])
  @@index([siteId])
  @@index([siteId, outputItemId]) // past-runs expected figure, History "Output" filter
  @@index([siteId, status, createdAt])
  @@index([siteId, createdById, createdAt])
  @@index([siteId, needsLook])
  @@index([locationId])
  @@map("prep_runs")
}

model PrepRunInputLine {
  id                String   @id @default(uuid())
  prepRunId         String   @map("prep_run_id")
  /// May itself be a prepped item — two-stage prep is allowed.
  inputItemId       String   @map("input_item_id")
  quantity          Decimal  @db.Decimal(12, 4)
  /// Snapshot of InventoryItem.currentCost when consumed; never recomputed.
  unitCostAtRunTime Decimal  @map("unit_cost_at_run_time") @db.Decimal(12, 4)
  /// quantity * unitCostAtRunTime, stored.
  lineCost          Decimal  @map("line_cost") @db.Decimal(12, 2)
  lineOrder         Int      @map("line_order")
  /// Stock the run was judged against (the manager drawer's "expected in stock").
  onHandAtRunTime   Decimal? @map("on_hand_at_run_time") @db.Decimal(12, 4)

  prepRun   PrepRun       @relation(fields: [prepRunId], references: [id], onDelete: Cascade)
  inputItem InventoryItem @relation("PrepRunInputItem", fields: [inputItemId], references: [id])

  @@index([prepRunId])
  @@index([inputItemId])
  @@map("prep_run_input_lines")
}
