// Full ledger enum ships now per feature plan §1 — only receive, prep_consume,
// prep_produce, waste, adjustment are written in Phase 1. dispatch_out,
// dispatch_in, market_receive, sale are reserved for Phase 2/3 and must not
// be restructured when those phases land.
enum InventoryTransactionType {
  RECEIVE
  PREP_CONSUME
  PREP_PRODUCE
  WASTE
  ADJUSTMENT
  DISPATCH_OUT
  DISPATCH_IN
  MARKET_RECEIVE
  SALE
}

// stockCountLineId/marketPurchaseLineId are retained as unlinked
// nullable columns: the models they referenced were dropped by Milestone One
// (plan §1.3/§4), and those ledger paths are still out of scope. Each is
// restored as a real FK when the milestone that rebuilds that flow lands.
// goodsReceiptLineId (formerly purchaseOrderLineId) was the first of these
// restored — Milestone Two (Receiving & Supplier AP) is the first writer to
// this ledger; see milestone-2-plan.md §1.6. prepRecordId is the second —
// Milestone Three (Prep) restores it as a real FK to PrepRun; see
// milestone-3-plan.md §1.2. dispatchLineId is the third — Milestone Five
// (Dispatch & Branch Receiving) restores it as a real FK to DispatchLine,
// the first writer of DISPATCH_OUT; see milestone-5-plan.md §1.2.
// wasteLogId is the fourth — Milestone Six Session 1 restores it as a real
// FK to WasteLog (milestone-6-plan.md §1.3). The same migration adds
// `reference` (ADJ-#### on ADJUSTMENT rows) and `reversesTransactionId`
// (equal-and-opposite reversal of a superseded adjustment, Flow 12b); both
// are first written in Sessions 2/3 (milestone-6-plan.md §1.7).
model InventoryTransaction {
  id                    String                   @id @default(uuid())
  siteId        String                   @map("organization_id")
  locationId            String                   @map("location_id")
  inventoryItemId       String                   @map("inventory_item_id")
  type                  InventoryTransactionType
  quantity              Decimal                  @db.Decimal(12, 4)
  unitCost              Decimal                  @map("unit_cost") @db.Decimal(12, 4)
  reason                String?
  goodsReceiptLineId    String?                  @map("goods_receipt_line_id")
  purchaseDeliveryLineId String?                 @map("purchase_delivery_line_id") // the redone Purchasing: a received delivery line
  prepRecordId         String?                  @map("prep_record_id")
  wasteLogId            String?                  @map("waste_log_id")
  stockCountLineId      String?                  @map("stock_count_line_id")
  branchDayLineId       String?                  @map("branch_day_line_id")
  openingLineId         String?                  @map("opening_line_id")
  dispatchLineId        String?                  @map("dispatch_line_id")
  marketPurchaseLineId  String?                  @map("market_purchase_line_id")
  reference             String? // ADJ-#### on ADJUSTMENT rows (ReferenceCounter), null elsewhere
  reversesTransactionId String?                  @unique @map("reverses_transaction_id") // a row is reversed at most once
  userId                String                   @map("user_id")
  createdAt             DateTime                 @default(now()) @map("created_at")

  site     Site           @relation(fields: [siteId], references: [id])
  location         Location               @relation(fields: [locationId], references: [id])
  inventoryItem    InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  user             User                   @relation("InventoryTransactionUser", fields: [userId], references: [id])
  goodsReceiptLine GoodsReceiptLine?      @relation(fields: [goodsReceiptLineId], references: [id])
  purchaseDeliveryLine PurchaseDeliveryLine? @relation(fields: [purchaseDeliveryLineId], references: [id])
  prepRun         PrepRun?               @relation("PrepRunTransactions", fields: [prepRecordId], references: [id])
  dispatchLine     DispatchLine?          @relation(fields: [dispatchLineId], references: [id])
  wasteLog         WasteLog?              @relation(fields: [wasteLogId], references: [id])
  stockCountLine   StockCountLine?        @relation(fields: [stockCountLineId], references: [id])
  branchDayLine    BranchDayLine?         @relation(fields: [branchDayLineId], references: [id])
  openingLine      DepartmentOpeningLine? @relation(fields: [openingLineId], references: [id])
  reverses         InventoryTransaction?  @relation("InventoryTransactionReversal", fields: [reversesTransactionId], references: [id])
  reversedBy       InventoryTransaction?  @relation("InventoryTransactionReversal")

  @@index([siteId])
  @@index([locationId])
  @@index([inventoryItemId])
  @@index([type])
  @@index([goodsReceiptLineId])
  @@index([purchaseDeliveryLineId])
  @@index([prepRecordId])
  @@index([dispatchLineId])
  @@index([wasteLogId])
  @@index([stockCountLineId])
  @@index([branchDayLineId])
  @@index([openingLineId])
  @@index([locationId, inventoryItemId, createdAt]) // ledger drill: one item at one location, by time
  @@map("inventory_transactions")
}
