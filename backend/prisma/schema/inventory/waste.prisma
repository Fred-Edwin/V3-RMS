// ── Milestone Six — Counting, Closing & Discrepancies (Session 1: waste) ────
// One row per logged waste entry (the design logs one item at a time). The
// ledger's negative WASTE row points back here through
// InventoryTransaction.wasteLogId. Not signed (Appendix B). Location is
// resolved server-side from the actor — Central Store for the store roles,
// the department's own location for a department head. milestone-6-plan.md §1.3.
enum WasteReason {
  SPOILAGE
  EXPIRY
  DAMAGE_IN_STORE
  PREP_ERROR
}

enum WasteReversalReason {
  WRONG_ITEM
  WRONG_QUANTITY
  OTHER
}

/// "Log 2 items" is one batch: a repeated idempotency key returns the same batch (contract §2.4).
model WasteBatch {
  id             String   @id @default(uuid())
  siteId         String   @map("organization_id")
  userId         String   @map("user_id")
  idempotencyKey String   @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  site Site       @relation(fields: [siteId], references: [id])
  user User       @relation(fields: [userId], references: [id])
  logs WasteLog[]

  @@unique([siteId, userId, idempotencyKey])
  @@map("waste_batches")
}

model WasteLog {
  id              String               @id @default(uuid())
  siteId          String               @map("organization_id") // the location's org — hub for the Central Store, branch org for a department
  locationId      String               @map("location_id")
  inventoryItemId String               @map("inventory_item_id")
  quantity        Decimal              @db.Decimal(12, 4) // positive as entered; the ledger row carries the negative sign
  reason          WasteReason
  note            String?
  unitCost        Decimal              @map("unit_cost") @db.Decimal(12, 4) // CS: item currentCost now; department: latest DISPATCH_IN cost, else currentCost
  loggedById      String               @map("logged_by_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  // The Central Store rebuild: an entry is REVERSED when reversedAt is set; the original row and its WASTE ledger row
  // stay, and a linked reversing ledger row returns the stock.
  batchId         String?              @map("batch_id")
  reversedAt      DateTime?            @map("reversed_at")
  reversedById    String?              @map("reversed_by_id")
  reversalReason  WasteReversalReason? @map("reversal_reason")
  reversalNote    String?              @map("reversal_note")

  batch         WasteBatch?            @relation(fields: [batchId], references: [id])
  reversedBy    User?                  @relation("WasteLogReversedBy", fields: [reversedById], references: [id])
  site          Site                   @relation(fields: [siteId], references: [id])
  location      Location               @relation(fields: [locationId], references: [id])
  inventoryItem InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  loggedBy      User                   @relation("WasteLogLoggedBy", fields: [loggedById], references: [id])
  transactions  InventoryTransaction[]

  @@index([siteId, createdAt])
  @@index([locationId, createdAt])
  @@map("waste_logs")
}
