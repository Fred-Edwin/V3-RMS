// ============================================================================
// Inventory & Procurement — Phase 1 (Central Store)
// See docs/context/INVENTORY-FEATURE/INVENTORY_FEATURE_PLAN.md for the full
// spec. Location is deliberately its own entity — never Organization.isHub
// (D-1). Phase 1 creates exactly one Location row (type CENTRAL_STORE).
// Phase 2 adds one Location per (branch, department) pair.
// ============================================================================

enum LocationType {
  CENTRAL_STORE
  BRANCH_DEPARTMENT
}

enum DepartmentTag {
  KITCHEN
  PASTRY
  BARISTA
  SERVICE
  HOUSEKEEPING
}

model Location {
  id            String         @id @default(uuid())
  siteId        String         @map("organization_id")
  type          LocationType
  departmentTag DepartmentTag? @map("department_tag")
  name          String
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  site                 Site                   @relation(fields: [siteId], references: [id])
  transactions         InventoryTransaction[]
  restockLevels        RestockLevel[]
  restockLevelChanges  RestockLevelChange[]
  purchaseDeliveries   PurchaseDelivery[]
  prepRuns             PrepRun[]
  wasteLogs            WasteLog[]
  stockCounts          StockCount[]
  branchDayDepartments BranchDayDepartment[]
  departmentOpenings   DepartmentOpening[]

  // Phase 1 creates exactly one CENTRAL_STORE row per organization (feature
  // plan D-1) — this constraint enforces that invariant at the DB level.
  // Phase 2 adds one BRANCH_DEPARTMENT row per (branch org, department tag) —
  // departmentTag is null for CENTRAL_STORE and non-null for BRANCH_DEPARTMENT,
  // so the two location types never collide under this constraint.
  // A partial unique index (migration 20260731090000, not expressible in
  // Prisma DSL) additionally enforces that only ONE CENTRAL_STORE row exists
  // across all organizations — it belongs to the hub org (design doc D-15).
  @@unique([siteId, type, departmentTag])
  @@index([siteId])
  @@map("locations")
}

enum InventoryItemType {
  RAW_INGREDIENT // Central Store only — never department-scoped
  PREPPED // produced by a prep run
  STOCKED // held and issued exactly as bought (was PASS_THROUGH)
}

enum SupplierPaymentTerms {
  INVOICE_TO_FOLLOW // billed, settled later on account
  PAY_NOW // paid on the spot; no AP created
}

/// Owner-named labels for organising the catalog. Shared by items and
/// suppliers (Paper SRB-0 + SX5-0 both draw from one list).
model Category {
  id               String    @id @default(uuid())
  siteId           String    @map("organization_id")
  name             String
  parentCategoryId String?   @map("parent_category_id") // one level only, service-enforced — see docs/DATA_MODEL.md §4.48
  deletedAt        DateTime? @map("deleted_at") // retire; never hard-delete
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  site      Site            @relation(fields: [siteId], references: [id])
  items     InventoryItem[]
  suppliers Supplier[]

  // Case-insensitive uniqueness among LIVE categories only — enforced by a
  // partial unique index on lower(name) WHERE deleted_at IS NULL (raw SQL;
  // not expressible in the Prisma DSL). A retired "Seasonal" must not block
  // creating a new "Seasonal".
  @@index([siteId])
  @@map("categories")
}

model InventoryItem {
  id                  String            @id @default(uuid())
  siteId              String            @map("organization_id")
  name                String
  type                InventoryItemType
  categoryId          String?           @map("category_id")
  preferredSupplierId String?           @map("preferred_supplier_id")

  buyUnit          String   @map("buy_unit") // free text: bag, crate, jerrican, ctn
  usageUnit        String   @map("usage_unit") // free text: kg, L, ml, pcs
  conversionFactor Decimal? @map("conversion_factor") @db.Decimal(12, 4) // null = "no conversion"
  packSize         Decimal? @map("pack_size") @db.Decimal(12, 4) // null = "—"

  departmentTags DepartmentTag[] @map("department_tags") // MUST be [] when type = RAW_INGREDIENT
  currentCost    Decimal         @default(0) @map("current_cost") @db.Decimal(12, 4)
  // Days of cover the suggested restock level aims for (e.g. 1.5 for fresh dough). Null = the default of 15.
  daysOfCover    Decimal?        @map("days_of_cover") @db.Decimal(6, 2)

  deletedAt DateTime? @map("deleted_at") // retire; history preserved
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  site                   Site                    @relation(fields: [siteId], references: [id])
  category               Category?               @relation(fields: [categoryId], references: [id])
  preferredSupplier      Supplier?               @relation(fields: [preferredSupplierId], references: [id])
  restockLevels          RestockLevel[]
  restockLevelChanges    RestockLevelChange[]
  transactions           InventoryTransaction[]
  purchaseOrderLines     PurchaseOrderLine[]
  purchaseDeliveryLines  PurchaseDeliveryLine[]
  prepRunsAsOutput       PrepRun[]               @relation("PrepRunOutput")
  prepRunInputLines      PrepRunInputLine[]      @relation("PrepRunInputItem")
  requisitionLines       RequisitionLine[]
  dispatchLines          DispatchLine[]
  wasteLogs              WasteLog[]
  stockCountLines        StockCountLine[]
  branchDayLines         BranchDayLine[]
  departmentOpeningLines DepartmentOpeningLine[]
  supplierItems          SupplierItem[]
  changes                InventoryItemChange[]

  @@index([siteId])
  @@index([categoryId])
  @@index([siteId, deletedAt]) // the catalog list's default filter
  @@map("inventory_items")
}

enum InventoryItemChangeKind {
  CREATED
  UPDATED
  RETIRED
  RESTORED
  SUPPLIER_ADDED
  SUPPLIER_PRICE_SET
}

/// Append-only history of what happened to a catalog item (Session 4b): created, edited, retired, restored,
/// a supplier added, a price set by hand. `summary` is a sentence without the actor ("retired the item").
/// `before` / `after` hold only the fields that changed. `reason` is optional and never required.
model InventoryItemChange {
  id              String                  @id @default(uuid())
  siteId          String                  @map("organization_id")
  inventoryItemId String                  @map("inventory_item_id")
  kind            InventoryItemChangeKind
  summary         String
  before          Json?
  after           Json?
  reason          String?
  changedById     String                  @map("changed_by_id")
  createdAt       DateTime                @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  changedBy     User          @relation("InventoryItemChangedBy", fields: [changedById], references: [id])

  @@index([siteId, inventoryItemId, createdAt])
  @@index([siteId, kind, createdAt])
  @@map("inventory_item_changes")
}

/// Replaces ParLevel. One per (location, item). Set by whoever owns the stock:
/// Store Manager for the Central Store, each department head for their own
/// department (01-description.md §4).
model RestockLevel {
  id              String   @id @default(uuid())
  siteId          String   @map("organization_id")
  locationId      String   @map("location_id")
  inventoryItemId String   @map("inventory_item_id")
  level           Decimal  @map("level") @db.Decimal(12, 4) // in the item's usage unit
  setById         String   @map("set_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  site          Site          @relation(fields: [siteId], references: [id])
  location      Location      @relation(fields: [locationId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  setBy         User          @relation("RestockLevelSetBy", fields: [setById], references: [id])

  @@unique([locationId, inventoryItemId])
  @@index([siteId])
  @@index([inventoryItemId])
  @@map("restock_levels")
}

/// Append-only log of every restock-level change (Session 3, B10): who changed
/// which location's level for which item, from what to what. `locationId` is
/// "for whom" (a branch department or the Central Store). A null `newLevel`
/// means the level was cleared; a null `oldLevel` means none was set before.
model RestockLevelChange {
  id              String   @id @default(uuid())
  siteId          String   @map("organization_id") // the location's org (same as restock_levels)
  locationId      String   @map("location_id")
  inventoryItemId String   @map("inventory_item_id")
  oldLevel        Decimal? @map("old_level") @db.Decimal(12, 4)
  newLevel        Decimal? @map("new_level") @db.Decimal(12, 4)
  changedById     String   @map("changed_by_id")
  reason          String?
  createdAt       DateTime @default(now()) @map("created_at")

  site          Site          @relation(fields: [siteId], references: [id])
  location      Location      @relation(fields: [locationId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  changedBy     User          @relation("RestockLevelChangedBy", fields: [changedById], references: [id])

  @@index([locationId, inventoryItemId, createdAt])
  @@index([siteId])
  @@map("restock_level_changes")
}
