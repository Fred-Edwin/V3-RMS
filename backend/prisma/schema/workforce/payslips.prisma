// ---- Workforce Segment 3: what staff see (payslip code, unlock, openings, stored documents, P9) ---------------------
// New tables only. Employees, users and payslips are plain ids checked by the services (as in payroll.prisma). Nothing here holds
// a pay figure except the stored document bytes and the P9 snapshot, which are the frozen evidence themselves.
// See backend/src/modules/workforce/payslips/README.md.

/// A try at the payslip code. Never the digits. Used to count wrong tries in a 15 minute window and to alert once per window.
model PayslipCodeTry {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  deviceId  String   @map("device_id")
  success   Boolean
  confirmed Boolean // the phone is a confirmed one (always false until the device feature ships)
  alerted   Boolean  @default(false) // this try raised the "3 wrong codes" notices
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("payslip_code_tries")
}

/// One unlock of My payslips on one phone. The token is random; only its hash is stored. Idle for 10 minutes ends it.
model PayslipUnlock {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  deviceId   String    @map("device_id")
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  expiresAt  DateTime  @map("expires_at") // the hard cap; the idle rule is checked against lastUsedAt
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId, deviceId])
  @@map("payslip_unlocks")
}

/// The Director's one row per opener per day (PD5): how many other people's payslips the opener looked at that day.
model PayslipOpenDigest {
  id         String    @id @default(uuid())
  companyId  String    @map("company_id")
  openerId   String    @map("opener_id")
  day        DateTime  @db.Date
  openCount  Int       @default(0) @map("open_count")
  notifiedAt DateTime? @map("notified_at")
  firstAt    DateTime? @map("first_at") // Segment 6b: the span of the day's openings (09:12 to 11:40)
  lastAt     DateTime? @map("last_at")

  @@unique([openerId, day])
  @@index([companyId, day])
  @@map("payslip_open_digests")
}

/// The rendered A4 payslip, stored once so every download is the same bytes (PD16). `variant` ORIGINAL or REPLACED (the watermarked copy of a replaced version).
model PayslipDocument {
  id        String   @id @default(uuid())
  payslipId String   @map("payslip_id") // the payroll_payslips row (one per version)
  variant   String
  number    String
  bytes     Bytes
  hash      String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([payslipId, variant])
  @@map("payslip_documents")
}

/// The Accountant's one-time confirmation that the P9 layout matches the KRA's current form (PD14).
model P9FormatConfirmation {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  layoutVersion Int      @map("layout_version")
  confirmedById String   @map("confirmed_by_id")
  confirmedAt   DateTime @default(now()) @map("confirmed_at")

  @@unique([companyId, layoutVersion])
  @@map("p9_format_confirmations")
}

/// A generated P9 (PD13). Built once per employee and year from the payslip snapshots, stored with its hash. Insert-only.
model P9Document {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  employeeId    String   @map("employee_id")
  year          Int
  layoutVersion Int      @map("layout_version")
  number        String
  bytes         Bytes
  hash          String
  data          Json // the twelve month rows and totals the document was drawn from
  generatedById String   @map("generated_by_id")
  generatedAt   DateTime @default(now()) @map("generated_at")

  @@unique([employeeId, year, layoutVersion])
  @@index([companyId, year])
  @@map("p9_documents")
}
