// ---- Workforce Segment 3: casual pay (workers, daily pay sheets, receipts, corrections) --------------------------------
// New tables only. Casual workers have no login and no payslip. Money is Decimal(12, 2), whole shillings in practice (PD22).
// Sites, departments and users are plain ids checked by the services. See backend/src/modules/workforce/casual/README.md.

enum CasualSheetStatus {
  DRAFT // the head is recording (also after "Take it back")
  SENT // waiting for the Branch Manager (or the Director)
  SENT_BACK // the approver sent it back with a reason; editable again
  APPROVED // CPS number issued, figures frozen
  VOID // voided before any worker signed; the number stays on record
}

/// One casual worker. The national ID number is unique across the company, so a worker at two sites is one record (PD20).
model CasualWorker {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  nationalId  String   @map("national_id") // digits only, as typed once and confirmed
  fullName    String   @map("full_name")
  phone       String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lines       CasualSheetLine[]
  corrections CasualCorrection[]

  @@unique([companyId, nationalId])
  @@map("casual_workers")
}

/// One department, at one site, for one day (PD21). At most one live (not VOID) sheet per department, site and day.
model CasualSheet {
  id              String            @id @default(uuid())
  companyId       String            @map("company_id")
  siteId          String            @map("organization_id")
  departmentId    String            @map("department_id")
  workDate        DateTime          @map("work_date") @db.Date
  status          CasualSheetStatus @default(DRAFT)
  version         Int               @default(1) // bumped by every change; a stale one answers 409 CHANGED_UNDERNEATH (PD29)
  rate            Decimal           @db.Decimal(12, 2) // the day rate in force on the work date, taken when the first line is saved
  rateVersion     Int               @map("rate_version") // the Casual work rules version that supplied it (0 for defaults)
  recordedById    String            @map("recorded_by_id") // the head who started it
  sentAt          DateTime?         @map("sent_at")
  sentById        String?           @map("sent_by_id")
  sentBackAt      DateTime?         @map("sent_back_at")
  sentBackById    String?           @map("sent_back_by_id")
  sentBackReason  String?           @map("sent_back_reason")
  approvedAt      DateTime?         @map("approved_at")
  approvedById    String?           @map("approved_by_id")
  number          Int? // CPS-n, issued at approval
  total           Decimal?          @db.Decimal(12, 2) // frozen at approval
  snapshot        Json? // the frozen sheet at approval (PD16)
  documentHash    String?           @map("document_hash")
  cashHolderId    String?           @map("cash_holder_id")
  voidedAt        DateTime?         @map("voided_at")
  voidedById      String?           @map("voided_by_id")
  voidReason      String?           @map("void_reason")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  lines       CasualSheetLine[]
  corrections CasualCorrection[]

  @@unique([companyId, number])
  @@index([companyId, siteId, workDate])
  @@index([companyId, status, workDate])
  @@map("casual_sheets")
}

/// One worker's shift on a sheet. Times are minutes from midnight; `endMinute` may pass 1440 for a shift that ends after midnight.
model CasualSheetLine {
  id             String    @id @default(uuid())
  sheetId        String    @map("sheet_id")
  workerId       String    @map("worker_id")
  startMinute    Int       @map("start_minute")
  endMinute      Int       @map("end_minute")
  minutes        Int
  amount         Decimal   @db.Decimal(12, 2)
  receivedAt     DateTime? @map("received_at")
  receivedName   String?   @map("received_name") // what the worker typed on the head's phone (PD25)
  receivedById   String?   @map("received_by_id") // the head whose phone it was
  createdAt      DateTime  @default(now()) @map("created_at")

  sheet  CasualSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  worker CasualWorker @relation(fields: [workerId], references: [id])

  @@unique([sheetId, workerId])
  @@index([workerId])
  @@map("casual_sheet_lines")
}

/// A plus or minus line a head adds to a LATER sheet for a day already signed (PD26). Counts in that sheet's total and prints on it.
model CasualCorrection {
  id             String   @id @default(uuid())
  sheetId        String   @map("sheet_id") // the later sheet that carries it
  workerId       String   @map("worker_id")
  originalDate   DateTime @map("original_date") @db.Date
  amount         Decimal  @db.Decimal(12, 2) // signed
  reason         String
  idempotencyKey String   @map("idempotency_key")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  sheet  CasualSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  worker CasualWorker @relation(fields: [workerId], references: [id])

  @@unique([sheetId, idempotencyKey])
  @@map("casual_corrections")
}

/// The next CPS number for a company. Locked with FOR UPDATE inside the approving transaction; gaps are allowed (PD15).
model CasualCounter {
  companyId  String @id @map("company_id")
  lastNumber Int    @default(0) @map("last_number")

  @@map("casual_counters")
}

/// A write that already happened under this key (an offline retry makes one record). The same key answers the first result.
model CasualRequestKey {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  key       String
  action    String
  response  Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, key])
  @@map("casual_request_keys")
}
