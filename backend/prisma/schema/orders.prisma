model DeliveryZone {
  id             String       @id @default(uuid())
  siteId String       @map("organization_id")
  name           String
  fee            Decimal      @db.Decimal(10, 2)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  site   Site @relation(fields: [siteId], references: [id])
  orders         Order[]

  @@index([siteId])
  @@map("delivery_zones")
}

model Order {
  id                           String                        @id @default(uuid())
  siteId               String                        @map("organization_id")
  dailyNumber                  Int                           @map("daily_number")
  orderDate                    DateTime                      @map("order_date") @db.Date
  type                         OrderType
  status                       OrderStatus                   @default(PENDING)
  tableNumber                  String?                       @map("table_number")
  notes                        String?
  subtotal                     Decimal                       @db.Decimal(10, 2)
  deliveryFee                  Decimal                       @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  total                        Decimal                       @db.Decimal(10, 2)
  paymentMethod                PaymentMethod?                @map("payment_method")
  mpesaCode                    String?                       @map("mpesa_code")
  mpesaAmount                  Decimal?                      @map("mpesa_amount") @db.Decimal(10, 2)
  cashAmount                   Decimal?                      @map("cash_amount") @db.Decimal(10, 2)
  cardAmount                   Decimal?                      @map("card_amount") @db.Decimal(10, 2)
  splitType                    String?                       @map("split_type")
  paidAt                       DateTime?                     @map("paid_at")
  cancelReason                 String?                       @map("cancel_reason")
  cancelledById                String?                       @map("cancelled_by_id")
  deliveryZoneId               String?                       @map("delivery_zone_id")
  houseAccountId               String?                       @map("house_account_id")
  corporateAccountId           String?                       @map("corporate_account_id")
  corporateEmployeeRef         String?                       @map("corporate_employee_ref")
  customerCreditAccountId      String?                       @map("customer_credit_account_id")
  discountPercent              Decimal?                      @map("discount_percent") @db.Decimal(5, 2)
  discountAmount               Decimal?                      @map("discount_amount") @db.Decimal(10, 2)
  discountedById               String?                       @map("discounted_by_id")
  discountId                   String?                       @map("discount_id")
  createdById                  String                        @map("created_by_id")
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  closedAt                     DateTime?                     @map("closed_at")
  site                 Site                  @relation(fields: [siteId], references: [id])
  deliveryZone                 DeliveryZone?                 @relation(fields: [deliveryZoneId], references: [id])
  houseAccount                 HouseAccount?                 @relation(fields: [houseAccountId], references: [id])
  corporateAccount             CorporateAccount?             @relation(fields: [corporateAccountId], references: [id])
  customerCreditAccount        CustomerCreditAccount?        @relation(fields: [customerCreditAccountId], references: [id])
  createdBy                    User                          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  cancelledBy                  User?                         @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  discountedBy                 User?                         @relation("OrderDiscountedBy", fields: [discountedById], references: [id])
  discount                     Discount?                     @relation(fields: [discountId], references: [id])
  items                        OrderItem[]
  prepTickets                  PrepTicket[]
  modificationRequests         OrderModificationRequest[]
  incidents                    IncidentLog[]
  printJobs                    PrintJob[]
  houseAuthRequests            HouseAccountAuthRequest[]
  staffDiscountAuthRequests    StaffDiscountAuthRequest[]
  customerDiscountAuthRequests CustomerDiscountAuthRequest[]
  cancellationRequests         OrderCancellationRequest[]
  splitPaymentLines            SplitPaymentLine[]

  @@unique([siteId, dailyNumber, orderDate])
  @@index([siteId])
  @@index([siteId, status])
  @@index([siteId, orderDate])
  @@index([createdById])
  @@map("orders")
}

model OrderCancellationRequest {
  id             String                    @id @default(uuid())
  siteId String                    @map("organization_id")
  orderId        String                    @map("order_id")
  requestedById  String                    @map("requested_by_id")
  reason         String
  reasonDetail   String?                   @map("reason_detail")
  previousStatus OrderStatus               @map("previous_status")
  status         CancellationRequestStatus @default(PENDING)
  resolvedById   String?                   @map("resolved_by_id")
  resolvedAt     DateTime?                 @map("resolved_at")
  resolutionNote String?                   @map("resolution_note")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])
  requestedBy  User         @relation("OrderCancellationRequestedBy", fields: [requestedById], references: [id])
  resolvedBy   User?        @relation("OrderCancellationResolvedBy", fields: [resolvedById], references: [id])

  @@index([siteId])
  @@index([orderId])
  @@index([requestedById])
  @@index([status])
  @@map("order_cancellation_requests")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  menuItemId String   @map("menu_item_id")
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)
  notes      String?
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model SplitPaymentLine {
  id        String        @id @default(uuid())
  orderId   String        @map("order_id")
  label     String
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  mpesaCode String?       @map("mpesa_code")
  paidAt    DateTime      @default(now()) @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("split_payment_lines")
}

model PrepTicket {
  id             String           @id @default(uuid())
  siteId String           @map("organization_id")
  orderId        String           @map("order_id")
  station        PrepStation
  sequence       Int              @default(1)
  status         PrepTicketStatus @default(PENDING)
  claimedById    String?          @map("claimed_by_id")
  claimedAt      DateTime?        @map("claimed_at")
  readyAt        DateTime?        @map("ready_at")
  rejectedById   String?          @map("rejected_by_id")
  rejectedReason String?          @map("rejected_reason")
  rejectedAt     DateTime?        @map("rejected_at")
  items          Json
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  site   Site     @relation(fields: [siteId], references: [id])
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  claimedBy      User?            @relation("PrepTicketClaimedBy", fields: [claimedById], references: [id])
  rejectedBy     User?            @relation("PrepTicketRejectedBy", fields: [rejectedById], references: [id])

  @@unique([orderId, station, sequence])
  @@index([siteId])
  @@index([siteId, station, status])
  @@index([claimedById])
  @@map("prep_tickets")
}

enum PrepStation {
  KITCHEN
  BARISTA
  PIZZA
  PASTRY
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  READY
  AWAITING_AUTHORIZATION
  AWAITING_CANCELLATION_APPROVAL
  CLOSED
  CANCELLED
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PrepTicketStatus {
  PENDING
  IN_PROGRESS
  READY
  REJECTED
}

enum PaymentMethod {
  MPESA
  CASH
  CARD
  SPLIT
  GUEST_SPLIT
  HOUSE_ACCOUNT
  CORPORATE_ACCOUNT
  CUSTOMER_CREDIT
}

enum IncidentType {
  ORDER_CANCELLED
  TICKET_REJECTED
  MODIFICATION_REQUESTED
  MODIFICATION_APPROVED
  MODIFICATION_REJECTED
  TICKET_UNCLAIMED
  ORDER_STALE
  ORDER_ITEM_REMOVED
  PAYMENT_REJECTED
  ORDER_CANCELLATION_REJECTED
  ORDER_CORRECTION
}

enum ModificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model OrderModificationRequest {
  id             String                    @id @default(uuid())
  siteId String                    @map("organization_id")
  orderId        String                    @map("order_id")
  requestedById  String                    @map("requested_by_id")
  description    String
  status         ModificationRequestStatus @default(PENDING)
  reviewedById   String?                   @map("reviewed_by_id")
  reviewedAt     DateTime?                 @map("reviewed_at")
  reviewNote     String?                   @map("review_note")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  order          Order                     @relation(fields: [orderId], references: [id])
  requestedBy    User                      @relation("ModRequestedBy", fields: [requestedById], references: [id])
  reviewedBy     User?                     @relation("ModReviewedBy", fields: [reviewedById], references: [id])

  @@index([siteId])
  @@index([orderId])
  @@index([siteId, status])
  @@map("order_modification_requests")
}

model IncidentLog {
  id             String       @id @default(uuid())
  siteId String       @map("organization_id")
  orderId        String?      @map("order_id")
  type           IncidentType
  actorId        String?      @map("actor_id")
  details        Json
  createdAt      DateTime     @default(now()) @map("created_at")
  site   Site @relation(fields: [siteId], references: [id])
  order          Order?       @relation(fields: [orderId], references: [id])
  actor          User?        @relation("IncidentActor", fields: [actorId], references: [id])

  @@index([siteId])
  @@index([siteId, type])
  @@index([orderId])
  @@index([createdAt])
  @@map("incident_logs")
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  orderId   String   @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key])
  @@map("idempotency_keys")
}
