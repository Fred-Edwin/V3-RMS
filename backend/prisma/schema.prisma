// ─── Internal Communications ───────────────────────────────────────────────

enum BroadcastScope {
  COMPANY
  BRANCH
  ROLE_GROUP
}

model DirectConversation {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  participantAId String   @map("participant_a_id")
  participantBId String   @map("participant_b_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  participantA User            @relation("ConvParticipantA", fields: [participantAId], references: [id])
  participantB User            @relation("ConvParticipantB", fields: [participantBId], references: [id])
  messages     DirectMessage[]

  @@unique([organizationId, participantAId, participantBId])
  @@index([organizationId])
  @@index([participantAId])
  @@index([participantBId])
  @@map("direct_conversations")
}

model DirectMessage {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  organizationId String    @map("organization_id")
  senderId       String    @map("sender_id")
  bodyHtml       String    @map("body_html")
  attachmentUrl  String?   @map("attachment_url")
  attachmentName String?   @map("attachment_name")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  conversation DirectConversation @relation(fields: [conversationId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  sender       User               @relation("DirectMessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([organizationId])
  @@map("direct_messages")
}

model Broadcast {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  senderId       String         @map("sender_id")
  scope          BroadcastScope
  targetRole     UserRole?      @map("target_role")
  subject        String
  bodyHtml       String         @map("body_html")
  attachmentUrl  String?        @map("attachment_url")
  attachmentName String?        @map("attachment_name")
  requiresAck    Boolean        @default(false) @map("requires_ack")
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id])
  sender       User                 @relation("BroadcastSender", fields: [senderId], references: [id])
  recipients   BroadcastRecipient[]

  @@index([organizationId, createdAt])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id             String    @id @default(uuid())
  broadcastId    String    @map("broadcast_id")
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  readAt         DateTime? @map("read_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  broadcast    Broadcast    @relation(fields: [broadcastId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation("BroadcastRecipientUser", fields: [userId], references: [id])

  @@unique([broadcastId, userId])
  @@index([broadcastId])
  @@index([userId])
  @@index([organizationId])
  @@map("broadcast_recipients")
}

model FormalNotice {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  issuerId       String   @map("issuer_id")
  subject        String
  bodyHtml       String   @map("body_html")
  attachmentUrl  String?  @map("attachment_url")
  attachmentName String?  @map("attachment_name")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization            @relation(fields: [organizationId], references: [id])
  issuer       User                    @relation("FormalNoticeIssuer", fields: [issuerId], references: [id])
  recipients   FormalNoticeRecipient[]

  @@index([organizationId, createdAt])
  @@map("formal_notices")
}

model FormalNoticeRecipient {
  id                 String    @id @default(uuid())
  noticeId           String    @map("notice_id")
  organizationId     String    @map("organization_id")
  userId             String    @map("user_id")
  acknowledgedAt     DateTime? @map("acknowledged_at")
  reminder24SentAt   DateTime? @map("reminder_24_sent_at")
  escalation48SentAt DateTime? @map("escalation_48_sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  notice       FormalNotice @relation(fields: [noticeId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation("FormalNoticeRecipientUser", fields: [userId], references: [id])

  @@unique([noticeId, userId])
  @@index([noticeId])
  @@index([userId])
  @@index([organizationId])
  @@index([acknowledgedAt, createdAt])
  @@map("formal_notice_recipients")
}

// ─── HR Module ────────────────────────────────────────────────────────────────

model EmployeeProfile {
  id                 String          @id @default(uuid())
  userId             String          @unique @map("user_id")
  nationalId         String?         @map("national_id")
  dateOfBirth        DateTime?       @map("date_of_birth")
  personalPhone      String?         @map("personal_phone")
  personalEmail      String?         @map("personal_email")
  physicalAddress    String?         @map("physical_address")
  emergencyName      String?         @map("emergency_name")
  emergencyRelation  String?         @map("emergency_relation")
  emergencyPhone     String?         @map("emergency_phone")
  employmentType     EmploymentType? @map("employment_type")
  contractTypeId     String?         @map("contract_type_id")
  startDate          DateTime        @map("start_date")
  endDate            DateTime?       @map("end_date")
  probationEndDate   DateTime?       @map("probation_end_date")
  jobTitle           String?         @map("job_title")
  reportingManagerId String?         @map("reporting_manager_id")
  notes              String?
  kraPIN             String?         @map("kra_pin")
  bankName           String?         @map("bank_name")
  accountNumber      String?         @map("account_number")
  accountName        String?         @map("account_name")
  bankBranch         String?         @map("bank_branch")
  helbNumber         String?         @map("helb_number")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  user                User                 @relation("EmployeeProfileUser", fields: [userId], references: [id])
  reportingManager    User?                @relation("EmployeeProfileManager", fields: [reportingManagerId], references: [id])
  contractType        ContractType?        @relation(fields: [contractTypeId], references: [id])
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  documents           HrDocument[]
  disciplinaryRecords DisciplinaryRecord[]

  @@index([userId])
  @@index([contractTypeId])
  @@map("employee_profiles")
}

model ContractType {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  name           String
  durationMonths Int?     @map("duration_months")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization?     @relation(fields: [organizationId], references: [id])
  leavePolicies    LeavePolicy[]
  employeeProfiles EmployeeProfile[]

  @@index([organizationId])
  @@map("contract_types")
}

model LeavePolicy {
  id             String    @id @default(uuid())
  contractTypeId String    @map("contract_type_id")
  leaveType      LeaveType @map("leave_type")
  totalDays      Int       @map("total_days")

  contractType ContractType @relation(fields: [contractTypeId], references: [id], onDelete: Cascade)

  @@unique([contractTypeId, leaveType])
  @@map("leave_policies")
}

model LeaveBalance {
  id                String    @id @default(uuid())
  employeeProfileId String    @map("employee_profile_id")
  leaveType         LeaveType @map("leave_type")
  totalDays         Int       @map("total_days")
  usedDays          Decimal   @default(0) @map("used_days") @db.Decimal(5, 1)
  pendingDays       Decimal   @default(0) @map("pending_days") @db.Decimal(5, 1)
  leaveYear         Int       @map("leave_year")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id])
  leaveRequests   LeaveRequest[]

  @@unique([employeeProfileId, leaveType, leaveYear])
  @@index([employeeProfileId])
  @@map("leave_balances")
}

model LeaveRequest {
  id                String      @id @default(uuid())
  employeeProfileId String      @map("employee_profile_id")
  leaveBalanceId    String      @map("leave_balance_id")
  organizationId    String?     @map("organization_id")
  leaveType         LeaveType   @map("leave_type")
  startDate         DateTime    @map("start_date")
  endDate           DateTime    @map("end_date")
  totalDays         Decimal     @map("total_days") @db.Decimal(5, 1)
  reason            String
  status            LeaveStatus @default(PENDING)
  reviewedById      String?     @map("reviewed_by_id")
  reviewedAt        DateTime?   @map("reviewed_at")
  reviewComment     String?     @map("review_comment")
  cancelledAt       DateTime?   @map("cancelled_at")
  cancelledById     String?     @map("cancelled_by_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  employeeProfile  EmployeeProfile               @relation(fields: [employeeProfileId], references: [id])
  leaveBalance     LeaveBalance                  @relation(fields: [leaveBalanceId], references: [id])
  organization     Organization?                 @relation(fields: [organizationId], references: [id])
  reviewedBy       User?                         @relation("LeaveReviewedBy", fields: [reviewedById], references: [id])
  cancelledBy      User?                         @relation("LeaveCancelledBy", fields: [cancelledById], references: [id])
  documents        HrDocument[]
  acknowledgements LeaveRequestAcknowledgement[]

  @@index([organizationId, status])
  @@index([employeeProfileId])
  @@map("leave_requests")
}

model LeaveRequestAcknowledgement {
  id             String   @id @default(uuid())
  leaveRequestId String   @map("leave_request_id")
  userId         String   @map("user_id")
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([leaveRequestId, userId])
  @@index([userId])
  @@map("leave_request_acknowledgements")
}

model DisciplinaryRecord {
  id                String               @id @default(uuid())
  employeeProfileId String               @map("employee_profile_id")
  organizationId    String               @map("organization_id")
  incidentDate      DateTime             @map("incident_date")
  actionDate        DateTime             @map("action_date")
  category          DisciplinaryCategory
  description       String
  actionTaken       DisciplinaryAction   @map("action_taken")
  outcome           String
  issuedById        String               @map("issued_by_id")
  witnesses         String?
  acknowledged      Boolean              @default(false)
  acknowledgedAt    DateTime?            @map("acknowledged_at")
  appealed          Boolean              @default(false)
  appealOutcome     String?              @map("appeal_outcome")
  expiresAt         DateTime?            @map("expires_at")
  createdAt         DateTime             @default(now()) @map("created_at")

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id])
  organization    Organization    @relation(fields: [organizationId], references: [id])
  issuedBy        User            @relation("DisciplinaryIssuedBy", fields: [issuedById], references: [id])
  documents       HrDocument[]

  @@index([organizationId])
  @@index([employeeProfileId])
  @@map("disciplinary_records")
}

model HrDocument {
