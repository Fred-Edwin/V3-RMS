generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String           @id @default(uuid())
  name            String
  address         String
  city            String
  latitude        Decimal          @db.Decimal(10, 7)
  longitude       Decimal          @db.Decimal(10, 7)
  phone           String?          @map("phone")
  mpesaPaybill    String?          @map("mpesa_paybill")
  accountNumber   String?          @map("account_number")
  googleReviewUrl String?          @map("google_review_url")
  isHub           Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  users           User[]
  branchMenuItems BranchMenuItem[]
  deliveryZones   DeliveryZone[]
  shifts          Shift[]
  shiftAssignments ShiftAssignment[]
  orders          Order[]
  orderCounters   OrderCounter[]
  prepTickets     PrepTicket[]
  incidentLogs          IncidentLog[]
  printJobs             PrintJob[]
  printStations         PrintStation[]
  customerCreditAccounts CustomerCreditAccount[]
  requisitions           Requisition[]
  branchStock            BranchStock[]
  consumableStock        ConsumableStock[]
  stocktakeSessions      StocktakeSession[]

  @@map("organizations")
}

model OrderCounter {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  orderDate      DateTime     @db.Date @map("order_date")
  lastNumber     Int          @default(0) @map("last_number")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, orderDate])
  @@index([organizationId])
  @@map("order_counters")
}

model User {
  id                 String            @id @default(uuid())
  organizationId     String?           @map("organization_id")
  name               String
  email              String            @unique
  phone              String?
  passwordHash       String            @map("password_hash")
  fcmToken           String?           @map("fcm_token")
  role               UserRole
  isActive           Boolean           @default(true) @map("is_active")
  isTestUser         Boolean           @default(false) @map("is_test_user")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")
  organization       Organization?     @relation(fields: [organizationId], references: [id])
  ordersCreated        Order[]           @relation("OrderCreatedBy")
  ordersCancelled      Order[]           @relation("OrderCancelledBy")
  shiftAssignments     ShiftAssignment[]
  clockRecords         ClockRecord[]
  prepTicketsClaimed   PrepTicket[]      @relation("PrepTicketClaimedBy")
  prepTicketsRejected  PrepTicket[]      @relation("PrepTicketRejectedBy")
  refreshTokens        RefreshToken[]
  modRequestsCreated   OrderModificationRequest[] @relation("ModRequestedBy")
  modRequestsReviewed  OrderModificationRequest[] @relation("ModReviewedBy")
  incidentsActed              IncidentLog[]           @relation("IncidentActor")
  printJobsRequested          PrintJob[]              @relation("PrintJobRequester")
  houseAccount                HouseAccount?           @relation("HouseAccountHolder")
  houseAccountsGranted        HouseAccount[]          @relation("HouseAccountGrantedBy")
  houseAccountSettlements     HouseAccountSettlement[] @relation("HouseAccountSettledBy")
  corporateAccountsCreated    CorporateAccount[]      @relation("CorporateAccountCreatedBy")
  corporateSettlements        CorporateAccountSettlement[] @relation("CorporateAccountSettledBy")
  customerCreditAccountsCreated CustomerCreditAccount[] @relation("CustomerCreditAccountCreatedBy")
  customerCreditSettlements   CustomerCreditSettlement[] @relation("CustomerCreditSettledBy")
  supplierDeliveries          SupplierDelivery[]
  requisitionsSubmitted       Requisition[]           @relation("RequisitionSubmittedBy")
  stocktakeSessions           StocktakeSession[]

  @@index([organizationId])
  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model MenuCategory {
  id           String     @id @default(uuid())
  name         String     @unique
  prepStation   PrepStation
  displayOrder Int        @default(0) @map("display_order")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  menuItems    MenuItem[]

  @@index([prepStation])
  @@map("menu_categories")
}

model MenuItem {
  id              String           @id @default(uuid())
  categoryId      String           @map("category_id")
  name            String
  description     String?
  imageUrl        String?          @map("image_url")
  price           Decimal          @db.Decimal(10, 2)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  category        MenuCategory     @relation(fields: [categoryId], references: [id])
  branchOverrides BranchMenuItem[]
  orderItems      OrderItem[]
  conversions     IngredientConversion[]
  requisitionItems RequisitionItem[]
  branchStock     BranchStock[]
  stocktakeEntries StocktakeEntry[]

  @@index([categoryId])
  @@index([isActive])
  @@map("menu_items")
}

model BranchMenuItem {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  menuItemId     String       @map("menu_item_id")
  isAvailable    Boolean      @default(true) @map("is_available")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  updatedBy      String       @map("updated_by")
  organization   Organization @relation(fields: [organizationId], references: [id])
  menuItem       MenuItem     @relation(fields: [menuItemId], references: [id])

  @@unique([organizationId, menuItemId])
  @@index([organizationId])
  @@index([menuItemId])
  @@map("branch_menu_items")
}

model DeliveryZone {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  fee            Decimal      @db.Decimal(10, 2)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  orders         Order[]

  @@index([organizationId])
  @@map("delivery_zones")
}

model Shift {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  name           String
  startTime      String            @map("start_time")
  endTime        String            @map("end_time")
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  organization   Organization      @relation(fields: [organizationId], references: [id])
  assignments    ShiftAssignment[]

  @@index([organizationId])
  @@map("shifts")
}

model ShiftAssignment {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  shiftId        String       @map("shift_id")
  userId         String       @map("user_id")
  date           DateTime     @db.Date
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  shift          Shift        @relation(fields: [shiftId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  clockRecord    ClockRecord?

  @@unique([userId, date, shiftId])
  @@index([organizationId])
  @@index([userId])
  @@index([date])
  @@map("shift_assignments")
}

model ClockRecord {
  id                String          @id @default(uuid())
  organizationId    String          @map("organization_id")
  shiftAssignmentId String          @unique @map("shift_assignment_id")
  userId            String          @map("user_id")
  clockInAt         DateTime?       @map("clock_in_at")
  clockOutAt        DateTime?       @map("clock_out_at")
  clockInMethod     ClockMethod     @map("clock_in_method")
  clockOutMethod    ClockMethod?    @map("clock_out_method")
  overrideById      String?         @map("override_by_id")
  overrideNote      String?         @map("override_note")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  shiftAssignment   ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id])
  user              User            @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([clockInAt])
  @@map("clock_records")
}

model Order {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  dailyNumber    Int            @map("daily_number")
  orderDate      DateTime       @db.Date @map("order_date")
  type           OrderType
  status         OrderStatus    @default(PENDING)
  tableNumber    String?        @map("table_number")
  notes          String?
  subtotal       Decimal        @db.Decimal(10, 2)
  deliveryFee    Decimal        @default(0) @db.Decimal(10, 2) @map("delivery_fee")
  total          Decimal        @db.Decimal(10, 2)
  paymentMethod           PaymentMethod?        @map("payment_method")
  mpesaCode               String?               @map("mpesa_code")
  mpesaAmount             Decimal?              @db.Decimal(10, 2) @map("mpesa_amount")
  cashAmount              Decimal?              @db.Decimal(10, 2) @map("cash_amount")
  cardAmount              Decimal?              @db.Decimal(10, 2) @map("card_amount")
  splitType               String?               @map("split_type")
  paidAt                  DateTime?             @map("paid_at")
  cancelReason            String?               @map("cancel_reason")
  cancelledById           String?               @map("cancelled_by_id")
  deliveryZoneId          String?               @map("delivery_zone_id")
  houseAccountId          String?               @map("house_account_id")
  corporateAccountId      String?               @map("corporate_account_id")
  corporateEmployeeRef    String?               @map("corporate_employee_ref")
  customerCreditAccountId String?               @map("customer_credit_account_id")
  createdById             String                @map("created_by_id")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  closedAt                DateTime?             @map("closed_at")
  organization            Organization          @relation(fields: [organizationId], references: [id])
  deliveryZone            DeliveryZone?         @relation(fields: [deliveryZoneId], references: [id])
  houseAccount            HouseAccount?         @relation(fields: [houseAccountId], references: [id])
  corporateAccount        CorporateAccount?     @relation(fields: [corporateAccountId], references: [id])
  customerCreditAccount   CustomerCreditAccount? @relation(fields: [customerCreditAccountId], references: [id])
  createdBy               User                  @relation("OrderCreatedBy", fields: [createdById], references: [id])
  cancelledBy             User?                 @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  items                   OrderItem[]
  prepTickets             PrepTicket[]
  modificationRequests    OrderModificationRequest[]
  incidents               IncidentLog[]
  printJobs               PrintJob[]

  @@unique([organizationId, dailyNumber, orderDate])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, orderDate])
  @@index([createdById])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  menuItemId String   @map("menu_item_id")
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2) @map("unit_price")
  subtotal   Decimal  @db.Decimal(10, 2)
  notes      String?
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model PrepTicket {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  orderId        String           @map("order_id")
  station        PrepStation
  sequence       Int              @default(1)
  status         PrepTicketStatus @default(PENDING)
  claimedById    String?          @map("claimed_by_id")
  claimedAt      DateTime?        @map("claimed_at")
  readyAt        DateTime?        @map("ready_at")
  rejectedById   String?          @map("rejected_by_id")
  rejectedReason String?          @map("rejected_reason")
  rejectedAt     DateTime?        @map("rejected_at")
  items          Json
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id])
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  claimedBy      User?            @relation("PrepTicketClaimedBy", fields: [claimedById], references: [id])
  rejectedBy     User?            @relation("PrepTicketRejectedBy", fields: [rejectedById], references: [id])

  @@unique([orderId, station, sequence])
  @@index([organizationId])
  @@index([organizationId, station, status])
  @@index([claimedById])
  @@map("prep_tickets")
}

enum UserRole {
  SYSTEM_ADMIN
  DIRECTOR
  MANAGER
  STORE_MANAGER
  WAITER
  CHEF
  BARISTA
  KITCHEN_DISPLAY
  BARISTA_DISPLAY
}

enum RequisitionStatus {
  PENDING
  APPROVED
  DISPATCHED
  RECEIVED
  PARTIAL
}

enum StocktakeStation {
  KITCHEN
  BARISTA
  WAITER
}

enum PrepStation {
  KITCHEN
  BARISTA
  PIZZA
  PASTRY
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  READY
  CLOSED
  CANCELLED
}

enum PrepTicketStatus {
  PENDING
  IN_PROGRESS
  READY
  REJECTED
}

enum PaymentMethod {
  MPESA
  CASH
  CARD
  SPLIT
  HOUSE_ACCOUNT
  CORPORATE_ACCOUNT
  CUSTOMER_CREDIT
}

enum ClockMethod {
  GPS
  OVERRIDE
}

enum IncidentType {
  ORDER_CANCELLED
  TICKET_REJECTED
  MODIFICATION_REQUESTED
  MODIFICATION_APPROVED
  MODIFICATION_REJECTED
  TICKET_UNCLAIMED
  ORDER_STALE
}

enum ModificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model OrderModificationRequest {
  id             String                    @id @default(uuid())
  organizationId String                    @map("organization_id")
  orderId        String                    @map("order_id")
  requestedById  String                    @map("requested_by_id")
  description    String
  status         ModificationRequestStatus @default(PENDING)
  reviewedById   String?                   @map("reviewed_by_id")
  reviewedAt     DateTime?                 @map("reviewed_at")
  reviewNote     String?                   @map("review_note")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  order          Order                     @relation(fields: [orderId], references: [id])
  requestedBy    User                      @relation("ModRequestedBy", fields: [requestedById], references: [id])
  reviewedBy     User?                     @relation("ModReviewedBy", fields: [reviewedById], references: [id])

  @@index([organizationId])
  @@index([orderId])
  @@index([organizationId, status])
  @@map("order_modification_requests")
}

model IncidentLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  orderId        String?      @map("order_id")
  type           IncidentType
  actorId        String?      @map("actor_id")
  details        Json
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  order          Order?       @relation(fields: [orderId], references: [id])
  actor          User?        @relation("IncidentActor", fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([orderId])
  @@index([createdAt])
  @@map("incident_logs")
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  orderId   String   @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key])
  @@map("idempotency_keys")
}

model PrintJob {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  orderId        String          @map("order_id")
  activeKey      String?         @unique @map("active_key")
  receiptType    ReceiptType     @default(RECEIPT) @map("receipt_type")
  copies         Int             @default(1)
  status         PrintJobStatus  @default(PENDING)
  receiptData    Json            @map("receipt_data")
  requestedById  String          @map("requested_by_id")
  claimedByStationId String?     @map("claimed_by_station_id")
  claimedAt      DateTime?       @map("claimed_at")
  leaseExpiresAt DateTime?       @map("lease_expires_at")
  printAttemptCount Int          @default(0) @map("print_attempt_count")
  printedByStationId String?     @map("printed_by_station_id")
  printedAt      DateTime?       @map("printed_at")
  failureReason  String?         @map("failure_reason")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id])
  order          Order           @relation(fields: [orderId], references: [id])
  requestedBy    User            @relation("PrintJobRequester", fields: [requestedById], references: [id])
  claimedByStation PrintStation? @relation("PrintJobClaimedBy", fields: [claimedByStationId], references: [id])
  printedByStation PrintStation? @relation("PrintJobPrintedBy", fields: [printedByStationId], references: [id])

  @@index([organizationId, status])
  @@index([orderId])
  @@map("print_jobs")
}

model PrintStation {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String       @default("Default Printer")
  token          String       @unique
  isActive       Boolean      @default(true) @map("is_active")
  lastSeenAt     DateTime?    @map("last_seen_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id])
  claimedJobs    PrintJob[]   @relation("PrintJobClaimedBy")
  printedJobs    PrintJob[]   @relation("PrintJobPrintedBy")

  @@index([organizationId])
  @@index([token])
  @@map("print_stations")
}

enum PrintJobStatus {
  PENDING
  PRINTING
  COMPLETED
  FAILED
}

enum ReceiptType {
  BILL
  RECEIPT
}

// ─── Credit Account Models ────────────────────────────────────────────────────

model HouseAccount {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  creditLimit    Decimal? @db.Decimal(10, 2) @map("credit_limit")
  currentBalance Decimal  @default(0) @db.Decimal(10, 2) @map("current_balance")
  isActive       Boolean  @default(true) @map("is_active")
  grantedById    String   @map("granted_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user        User                     @relation("HouseAccountHolder", fields: [userId], references: [id])
  grantedBy   User                     @relation("HouseAccountGrantedBy", fields: [grantedById], references: [id])
  settlements HouseAccountSettlement[]
  orders      Order[]

  @@index([userId])
  @@index([isActive])
  @@map("house_accounts")
}

model HouseAccountSettlement {
  id             String       @id @default(uuid())
  houseAccountId String       @map("house_account_id")
  amount         Decimal      @db.Decimal(10, 2)
  note           String?
  settledById    String       @map("settled_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  houseAccount HouseAccount @relation(fields: [houseAccountId], references: [id])
  settledBy    User         @relation("HouseAccountSettledBy", fields: [settledById], references: [id])

  @@index([houseAccountId])
  @@map("house_account_settlements")
}

model CorporateAccount {
  id              String   @id @default(uuid())
  companyName     String   @map("company_name")
  contactName     String   @map("contact_name")
  contactPhone    String   @map("contact_phone")
  contactEmail    String?  @map("contact_email")
  creditLimit     Decimal? @db.Decimal(10, 2) @map("credit_limit")
  currentBalance  Decimal  @default(0) @db.Decimal(10, 2) @map("current_balance")
  billingCycleDay Int      @default(1) @map("billing_cycle_day")
  isActive        Boolean  @default(true) @map("is_active")
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  createdBy   User                         @relation("CorporateAccountCreatedBy", fields: [createdById], references: [id])
  settlements CorporateAccountSettlement[]
  orders      Order[]

  @@index([isActive])
  @@index([companyName])
  @@map("corporate_accounts")
}

model CorporateAccountSettlement {
  id                 String           @id @default(uuid())
  corporateAccountId String           @map("corporate_account_id")
  amount             Decimal          @db.Decimal(10, 2)
  note               String?
  settledById        String           @map("settled_by_id")
  createdAt          DateTime         @default(now()) @map("created_at")

  corporateAccount CorporateAccount @relation(fields: [corporateAccountId], references: [id])
  settledBy        User             @relation("CorporateAccountSettledBy", fields: [settledById], references: [id])

  @@index([corporateAccountId])
  @@map("corporate_account_settlements")
}

model CustomerCreditAccount {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  customerName   String       @map("customer_name")
  customerPhone  String       @map("customer_phone")
  creditLimit    Decimal      @db.Decimal(10, 2) @map("credit_limit")
  currentBalance Decimal      @default(0) @db.Decimal(10, 2) @map("current_balance")
  notes          String?
  isActive       Boolean      @default(true) @map("is_active")
  createdById    String       @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization               @relation(fields: [organizationId], references: [id])
  createdBy    User                       @relation("CustomerCreditAccountCreatedBy", fields: [createdById], references: [id])
  settlements  CustomerCreditSettlement[]
  orders       Order[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([customerPhone])
  @@map("customer_credit_accounts")
}

model CustomerCreditSettlement {
  id                      String                @id @default(uuid())
  customerCreditAccountId String                @map("customer_credit_account_id")
  amount                  Decimal               @db.Decimal(10, 2)
  note                    String?
  settledById             String                @map("settled_by_id")
  createdAt               DateTime              @default(now()) @map("created_at")

  customerCreditAccount CustomerCreditAccount @relation(fields: [customerCreditAccountId], references: [id])
  settledBy             User                 @relation("CustomerCreditSettledBy", fields: [settledById], references: [id])

  @@index([customerCreditAccountId])
  @@map("customer_credit_settlements")
}

// ─── Inventory Models (V2.1) ──────────────────────────────────────────────────

model Supplier {
  id         String   @id @default(uuid())
  name       String
  phone      String?
  email      String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  deliveries SupplierDelivery[]

  @@map("suppliers")
}

model RawIngredient {
  id               String   @id @default(uuid())
  name             String   @unique
  unit             String
  currentStockCk   Decimal  @default(0) @db.Decimal(10, 3) @map("current_stock_ck")
  reorderThreshold Decimal  @default(0) @db.Decimal(10, 3) @map("reorder_threshold")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  deliveries  SupplierDelivery[]
  conversions IngredientConversion[]

  @@map("raw_ingredients")
}

model IngredientConversion {
  id                 String   @id @default(uuid())
  menuItemId         String   @map("menu_item_id")
  ingredientId       String   @map("ingredient_id")
  quantityPerPortion Decimal  @db.Decimal(10, 4) @map("quantity_per_portion")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  menuItem   MenuItem      @relation(fields: [menuItemId], references: [id])
  ingredient RawIngredient @relation(fields: [ingredientId], references: [id])

  @@unique([menuItemId, ingredientId])
  @@map("ingredient_conversions")
}

model SupplierDelivery {
  id           String   @id @default(uuid())
  ingredientId String   @map("ingredient_id")
  supplierId   String   @map("supplier_id")
  quantity     Decimal  @db.Decimal(10, 3)
  deliveredAt  DateTime @default(now()) @map("delivered_at")
  loggedById   String   @map("logged_by_id")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  ingredient RawIngredient @relation(fields: [ingredientId], references: [id])
  supplier   Supplier      @relation(fields: [supplierId], references: [id])
  loggedBy   User          @relation(fields: [loggedById], references: [id])

  @@index([ingredientId])
  @@index([supplierId])
  @@index([deliveredAt])
  @@map("supplier_deliveries")
}

model Requisition {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  submittedById  String            @map("submitted_by_id")
  status         RequisitionStatus @default(PENDING)
  notes          String?
  isMidDay       Boolean           @default(false) @map("is_mid_day")
  submittedAt    DateTime          @default(now()) @map("submitted_at")
  dispatchedAt   DateTime?         @map("dispatched_at")
  receivedAt     DateTime?         @map("received_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  submittedBy  User             @relation("RequisitionSubmittedBy", fields: [submittedById], references: [id])
  items        RequisitionItem[]

  @@index([organizationId, status])
  @@index([status, submittedAt])
  @@map("requisitions")
}

model RequisitionItem {
  id             String   @id @default(uuid())
  requisitionId  String   @map("requisition_id")
  menuItemId     String   @map("menu_item_id")
  requestedQty   Int      @map("requested_qty")
  dispatchedQty  Int?     @map("dispatched_qty")
  receivedQty    Int?     @map("received_qty")
  hasDiscrepancy Boolean  @default(false) @map("has_discrepancy")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  menuItem    MenuItem    @relation(fields: [menuItemId], references: [id])

  @@index([requisitionId])
  @@map("requisition_items")
}

model BranchStock {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  menuItemId       String   @map("menu_item_id")
  currentQty       Int      @default(0) @map("current_qty")
  lowStockThreshold Int     @default(5) @map("low_stock_threshold")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  menuItem     MenuItem      @relation(fields: [menuItemId], references: [id])

  @@unique([organizationId, menuItemId])
  @@index([organizationId])
  @@map("branch_stock")
}

model Consumable {
  id        String           @id @default(uuid())
  name      String           @unique
  unit      String
  station   StocktakeStation
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  branchStocks   ConsumableStock[]
  stocktakeEntries StocktakeEntry[]

  @@map("consumables")
}

model ConsumableStock {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  consumableId   String   @map("consumable_id")
  currentQty     Decimal  @default(0) @db.Decimal(10, 2) @map("current_qty")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  consumable   Consumable   @relation(fields: [consumableId], references: [id])

  @@unique([organizationId, consumableId])
  @@index([organizationId])
  @@map("consumable_stock")
}

model StocktakeSession {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  conductedById  String    @map("conducted_by_id")
  date           DateTime  @db.Date
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  conductedBy  User             @relation(fields: [conductedById], references: [id])
  entries      StocktakeEntry[]

  @@unique([organizationId, date])
  @@index([organizationId])
  @@map("stocktake_sessions")
}

model StocktakeEntry {
  id           String           @id @default(uuid())
  sessionId    String           @map("session_id")
  station      StocktakeStation
  menuItemId   String?          @map("menu_item_id")
  consumableId String?          @map("consumable_id")
  expectedQty  Decimal          @db.Decimal(10, 2) @map("expected_qty")
  actualQty    Decimal          @db.Decimal(10, 2) @map("actual_qty")
  variance     Decimal          @db.Decimal(10, 2)
  note         String?
  createdAt    DateTime         @default(now()) @map("created_at")

  session    StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  menuItem   MenuItem?        @relation(fields: [menuItemId], references: [id])
  consumable Consumable?      @relation(fields: [consumableId], references: [id])

  @@index([sessionId])
  @@map("stocktake_entries")
}
