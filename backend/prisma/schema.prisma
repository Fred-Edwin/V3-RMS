// ============================================================================
// Inventory & Procurement — Phase 1 (Central Store)
// See docs/context/INVENTORY-FEATURE/INVENTORY_FEATURE_PLAN.md for the full
// spec. Location is deliberately its own entity — never Organization.isHub
// (D-1). Phase 1 creates exactly one Location row (type CENTRAL_STORE).
// Phase 2 adds one Location per (branch, department) pair.
// ============================================================================

enum LocationType {
  CENTRAL_STORE
  BRANCH_DEPARTMENT
}

enum DepartmentTag {
  KITCHEN
  PASTRY
  BARISTA
  SERVICE
  HOUSEKEEPING
}

model Location {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  type           LocationType
  name           String
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization           @relation(fields: [organizationId], references: [id])
  transactions   InventoryTransaction[]
  stockCounts    StockCount[]
  wasteLogs      WasteLog[]
  prepRecords    PrepRecord[]
  purchaseOrders PurchaseOrder[]

  // Phase 1 creates exactly one CENTRAL_STORE row per organization (feature
  // plan D-1) — this constraint enforces that invariant at the DB level.
  // Phase 2's BRANCH_DEPARTMENT rows are per (branch, department) and won't
  // collide with this since department is not part of this model yet.
  // A partial unique index (migration 20260731090000, not expressible in
  // Prisma DSL) additionally enforces that only ONE CENTRAL_STORE row exists
  // across all organizations — it belongs to the hub org (design doc D-15).
  @@unique([organizationId, type])
  @@index([organizationId])
  @@map("locations")
}

enum InventoryItemType {
  RAW
  PREPPED
  PASS_THROUGH
}

model InventoryItem {
  id               String            @id @default(uuid()) @map("id")
  organizationId   String            @map("organization_id")
  name             String
  type             InventoryItemType
  buyUnit          String            @map("buy_unit")
  usageUnit        String            @map("usage_unit")
  conversionFactor Decimal           @map("conversion_factor") @db.Decimal(12, 4)
  reorderLevel     Decimal           @map("reorder_level") @db.Decimal(12, 4)
  departmentTags   DepartmentTag[]   @map("department_tags")
  currentCost      Decimal           @default(0) @map("current_cost") @db.Decimal(12, 4)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  organization        Organization           @relation(fields: [organizationId], references: [id])
  supplierItems       SupplierItem[]
  purchaseOrderLines  PurchaseOrderLine[]
  transactions        InventoryTransaction[]
  prepRecipesAsOutput PrepRecipe[]           @relation("PrepRecipeOutputItem")
  prepRecipeLines     PrepRecipeLine[]       @relation("PrepRecipeLineInputItem")
  prepRecordsAsOutput PrepRecord[]           @relation("PrepRecordOutputItem")
  prepRecordLines     PrepRecordLine[]       @relation("PrepRecordLineInputItem")
  stockCountLines     StockCountLine[]
  wasteLogs           WasteLog[]

  @@index([organizationId])
  @@map("inventory_items")
}

model Supplier {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  contactName    String?  @map("contact_name")
  phone          String?
  email          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  supplierItems    SupplierItem[]
  purchaseOrders   PurchaseOrder[]
  supplierInvoices SupplierInvoice[]

  @@index([organizationId])
  @@map("suppliers")
}

model SupplierItem {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  supplierId      String   @map("supplier_id")
  inventoryItemId String   @map("inventory_item_id")
  isDefault       Boolean  @default(false) @map("is_default")
  lastPrice       Decimal? @map("last_price") @db.Decimal(12, 4)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id])
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([supplierId, inventoryItemId])
  @@index([organizationId])
  @@index([inventoryItemId])
  @@map("supplier_items")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  supplierId     String              @map("supplier_id")
  locationId     String              @map("location_id")
  poNumber       String              @map("po_number")
  status         PurchaseOrderStatus @default(DRAFT)
  createdById    String              @map("created_by_id")
  sentAt         DateTime?           @map("sent_at")
  cancelledAt    DateTime?           @map("cancelled_at")
  closedAt       DateTime?           @map("closed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization     Organization        @relation(fields: [organizationId], references: [id])
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  location         Location            @relation(fields: [locationId], references: [id])
  createdBy        User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  lines            PurchaseOrderLine[]
  supplierInvoices SupplierInvoice[]

  @@unique([organizationId, poNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([locationId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  purchaseOrderId String    @map("purchase_order_id")
  inventoryItemId String    @map("inventory_item_id")
  orderedQty      Decimal   @map("ordered_qty") @db.Decimal(12, 4)
  receivedQty     Decimal   @default(0) @map("received_qty") @db.Decimal(12, 4)
  unitPrice       Decimal   @map("unit_price") @db.Decimal(12, 4)
  invoicePrice    Decimal?  @map("invoice_price") @db.Decimal(12, 4)
  receivedAt      DateTime? @map("received_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization  Organization           @relation(fields: [organizationId], references: [id])
  purchaseOrder PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  transactions  InventoryTransaction[]

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([inventoryItemId])
  @@map("purchase_order_lines")
}

enum SupplierInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model SupplierInvoice {
  id              String                @id @default(uuid())
  organizationId  String                @map("organization_id")
  supplierId      String                @map("supplier_id")
  purchaseOrderId String?               @map("purchase_order_id")
  referenceNumber String                @map("reference_number")
  amount          Decimal               @db.Decimal(12, 2)
  amountPaid      Decimal               @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status          SupplierInvoiceStatus @default(UNPAID)
  invoiceDate     DateTime              @map("invoice_date")
  createdById     String                @map("created_by_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  organization  Organization      @relation(fields: [organizationId], references: [id])
  supplier      Supplier          @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  createdBy     User              @relation("SupplierInvoiceCreatedBy", fields: [createdById], references: [id])
  payments      SupplierPayment[]

  @@index([organizationId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("supplier_invoices")
}

model SupplierPayment {
  id                String        @id @default(uuid())
  organizationId    String        @map("organization_id")
  supplierInvoiceId String        @map("supplier_invoice_id")
  amount            Decimal       @db.Decimal(12, 2)
  method            PaymentMethod
  paidAt            DateTime      @map("paid_at")
  recordedById      String        @map("recorded_by_id")
  createdAt         DateTime      @default(now()) @map("created_at")

  organization    Organization    @relation(fields: [organizationId], references: [id])
  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  recordedBy      User            @relation("SupplierPaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([organizationId])
  @@index([supplierInvoiceId])
  @@map("supplier_payments")
}

model PrepRecipe {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  outputItemId   String   @map("output_item_id")
  name           String
  expectedYield  Decimal  @map("expected_yield") @db.Decimal(12, 4)
  batchLabel     String?  @map("batch_label")
  instructions   String?
  promotedFromId String?  @unique @map("promoted_from_id")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  outputItem   InventoryItem    @relation("PrepRecipeOutputItem", fields: [outputItemId], references: [id])
  createdBy    User             @relation("PrepRecipeCreatedBy", fields: [createdById], references: [id])
  promotedFrom PrepRecord?      @relation("PrepRecordPromotedTo", fields: [promotedFromId], references: [id])
  lines        PrepRecipeLine[]

  @@index([organizationId])
  @@index([outputItemId])
  @@map("prep_recipes")
}

model PrepRecipeLine {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  prepRecipeId   String  @map("prep_recipe_id")
  inputItemId    String  @map("input_item_id")
  quantity       Decimal @db.Decimal(12, 4)

  organization Organization  @relation(fields: [organizationId], references: [id])
  prepRecipe   PrepRecipe    @relation(fields: [prepRecipeId], references: [id], onDelete: Cascade)
  inputItem    InventoryItem @relation("PrepRecipeLineInputItem", fields: [inputItemId], references: [id])

  @@index([organizationId])
  @@index([prepRecipeId])
  @@index([inputItemId])
  @@map("prep_recipe_lines")
}

model PrepRecord {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  locationId     String   @map("location_id")
  outputItemId   String   @map("output_item_id")
  actualYield    Decimal  @map("actual_yield") @db.Decimal(12, 4)
  /**
   * Recipe's expected yield scaled by the average actual÷recipe ratio across
   * this run's ingredient lines — null when no recipe existed for the output
   * item at the time of this run. Stored (not recomputed at report read-time)
   * so a later recipe edit never retroactively changes historical variance —
   * see UI_UX_DESIGN_AUDIT.md Flow 3, "Left open" #3.
   */
  scaledExpectedYield Decimal? @map("scaled_expected_yield") @db.Decimal(12, 4)
  unitCost       Decimal  @map("unit_cost") @db.Decimal(12, 4)
  recordedById   String   @map("recorded_by_id")
  recordedAt     DateTime @default(now()) @map("recorded_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization           @relation(fields: [organizationId], references: [id])
  location     Location               @relation(fields: [locationId], references: [id])
  outputItem   InventoryItem          @relation("PrepRecordOutputItem", fields: [outputItemId], references: [id])
  recordedBy   User                   @relation("PrepRecordRecordedBy", fields: [recordedById], references: [id])
  lines        PrepRecordLine[]
  promotedTo   PrepRecipe?            @relation("PrepRecordPromotedTo")
  transactions InventoryTransaction[]

  @@index([organizationId])
  @@index([locationId])
  @@index([outputItemId])
  @@map("prep_records")
}

model PrepRecordLine {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  prepRecordId   String  @map("prep_record_id")
  inputItemId    String  @map("input_item_id")
  quantity       Decimal @db.Decimal(12, 4)
  unitCost       Decimal @map("unit_cost") @db.Decimal(12, 4)

  organization Organization  @relation(fields: [organizationId], references: [id])
  prepRecord   PrepRecord    @relation(fields: [prepRecordId], references: [id], onDelete: Cascade)
  inputItem    InventoryItem @relation("PrepRecordLineInputItem", fields: [inputItemId], references: [id])

  @@index([organizationId])
  @@index([prepRecordId])
  @@index([inputItemId])
  @@map("prep_record_lines")
}

enum StockCountStatus {
  IN_PROGRESS
  SUBMITTED
  APPROVED
}

model StockCount {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  locationId     String           @map("location_id")
  label          String
  status         StockCountStatus @default(IN_PROGRESS)
  scheduledDate  DateTime         @map("scheduled_date")
  createdById    String           @map("created_by_id")
  submittedById  String?          @map("submitted_by_id")
  submittedAt    DateTime?        @map("submitted_at")
  approvedById   String?          @map("approved_by_id")
  approvedAt     DateTime?        @map("approved_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  location     Location         @relation(fields: [locationId], references: [id])
  createdBy    User             @relation("StockCountCreatedBy", fields: [createdById], references: [id])
  submittedBy  User?            @relation("StockCountSubmittedBy", fields: [submittedById], references: [id])
  approvedBy   User?            @relation("StockCountApprovedBy", fields: [approvedById], references: [id])
  lines        StockCountLine[]

  @@index([organizationId])
  @@index([locationId])
  @@map("stock_counts")
}

model StockCountLine {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  stockCountId    String   @map("stock_count_id")
  inventoryItemId String   @map("inventory_item_id")
  sequence        Int      @default(1)
  expectedQty     Decimal? @map("expected_qty") @db.Decimal(12, 4)
  countedQty      Decimal? @map("counted_qty") @db.Decimal(12, 4)
  gapQty          Decimal? @map("gap_qty") @db.Decimal(12, 4)

  organization  Organization           @relation(fields: [organizationId], references: [id])
  stockCount    StockCount             @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  transactions  InventoryTransaction[]

  @@index([organizationId])
  @@index([stockCountId])
  @@index([inventoryItemId])
  @@map("stock_count_lines")
}

enum WasteReason {
  SPOILED
  PREP_ERROR
  DROPPED
  EXPIRED
  OTHER
}

model WasteLog {
  id              String      @id @default(uuid())
  organizationId  String      @map("organization_id")
  locationId      String      @map("location_id")
  inventoryItemId String      @map("inventory_item_id")
  quantity        Decimal     @db.Decimal(12, 4)
  reason          WasteReason
  note            String?
  loggedById      String      @map("logged_by_id")
  loggedAt        DateTime    @default(now()) @map("logged_at")

  organization  Organization           @relation(fields: [organizationId], references: [id])
  location      Location               @relation(fields: [locationId], references: [id])
  inventoryItem InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  loggedBy      User                   @relation("WasteLogLoggedBy", fields: [loggedById], references: [id])
  transactions  InventoryTransaction[]

  @@index([organizationId])
  @@index([locationId])
  @@index([inventoryItemId])
  @@map("waste_logs")
}

// Full ledger enum ships now per feature plan §1 — only receive, prep_consume,
// prep_produce, waste, adjustment are written in Phase 1. dispatch_out,
// dispatch_in, market_receive, sale are reserved for Phase 2/3 and must not
// be restructured when those phases land.
enum InventoryTransactionType {
  RECEIVE
  PREP_CONSUME
  PREP_PRODUCE
  WASTE
  ADJUSTMENT
  DISPATCH_OUT
  DISPATCH_IN
  MARKET_RECEIVE
  SALE
}

model InventoryTransaction {
  id                  String                   @id @default(uuid())
  organizationId      String                   @map("organization_id")
  locationId          String                   @map("location_id")
  inventoryItemId     String                   @map("inventory_item_id")
  type                InventoryTransactionType
  quantity            Decimal                  @db.Decimal(12, 4)
  unitCost            Decimal                  @map("unit_cost") @db.Decimal(12, 4)
  reason              String?
  purchaseOrderLineId String?                  @map("purchase_order_line_id")
  prepRecordId        String?                  @map("prep_record_id")
  wasteLogId          String?                  @map("waste_log_id")
  stockCountLineId    String?                  @map("stock_count_line_id")
  userId              String                   @map("user_id")
  createdAt           DateTime                 @default(now()) @map("created_at")

  organization      Organization       @relation(fields: [organizationId], references: [id])
  location          Location           @relation(fields: [locationId], references: [id])
  inventoryItem     InventoryItem      @relation(fields: [inventoryItemId], references: [id])
  prepRecord        PrepRecord?        @relation(fields: [prepRecordId], references: [id])
  wasteLog          WasteLog?          @relation(fields: [wasteLogId], references: [id])
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  stockCountLine    StockCountLine?    @relation(fields: [stockCountLineId], references: [id])
  user              User               @relation("InventoryTransactionUser", fields: [userId], references: [id])

  @@index([organizationId])
  @@index([locationId])
  @@index([inventoryItemId])
  @@index([type])
  @@map("inventory_transactions")
}
