  order         Order        @relation(fields: [orderId], references: [id])
  requestedBy   User         @relation("StaffDiscountRequestedBy", fields: [requestedById], references: [id])
  resolvedBy    User?        @relation("StaffDiscountResolvedBy", fields: [resolvedById], references: [id])

  @@index([organizationId])
  @@index([orderId])
  @@index([status])
  @@map("staff_discount_auth_requests")
}

model CustomerDiscountAuthRequest {
  id              String                      @id @default(uuid())
  organizationId  String                      @map("organization_id")
  orderId         String                      @map("order_id")
  discountId      String                      @map("discount_id")
  requestedById   String                      @map("requested_by_id")
  discountPercent Decimal?                    @db.Decimal(5, 2)  @map("discount_percent")
