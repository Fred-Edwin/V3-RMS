  organization Organization       @relation(fields: [organizationId], references: [id])
  branch       Organization?      @relation("OtherIncomeCategoryBranch", fields: [branchId], references: [id])
  entries      OtherIncomeEntry[]

  @@index([organizationId])
  @@index([branchId])
  @@map("other_income_categories")
}

model OtherIncomeEntry {
  id             String                   @id @default(uuid())
  organizationId String                   @map("organization_id")
  branchId       String                   @map("branch_id")
  categoryId     String                   @map("category_id")
  amount         Decimal                  @db.Decimal(10, 2)
  paymentMethod  OtherIncomePaymentMethod @map("payment_method")
  mpesaCode      String?                  @map("mpesa_code")
  mpesaAmount    Decimal?                 @db.Decimal(10, 2) @map("mpesa_amount")
