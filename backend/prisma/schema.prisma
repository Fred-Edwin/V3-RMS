generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                           String                        @id @default(uuid())
  name                         String
  address                      String
  city                         String
  latitude                     Decimal                       @db.Decimal(10, 7)
  longitude                    Decimal                       @db.Decimal(10, 7)
  phone                        String?                       @map("phone")
  mpesaPaybill                 String?                       @map("mpesa_paybill")
  accountNumber                String?                       @map("account_number")
  googleReviewUrl              String?                       @map("google_review_url")
  kraPIN                       String?                       @map("kra_pin")
  isHub                        Boolean                       @default(false)
  isActive                     Boolean                       @default(true)
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  users                        User[]
  branchMenuItems              BranchMenuItem[]
  deliveryZones                DeliveryZone[]
  shifts                       Shift[]
  shiftAssignments             ShiftAssignment[]
  orders                       Order[]
  orderCounters                OrderCounter[]
  prepTickets                  PrepTicket[]
  incidentLogs                 IncidentLog[]
  printJobs                    PrintJob[]
  printStations                PrintStation[]
  customerCreditAccounts       CustomerCreditAccount[]
  otherIncomeCategories        OtherIncomeCategory[]
  otherIncomeCategoriesBranch  OtherIncomeCategory[]         @relation("OtherIncomeCategoryBranch")
  otherIncomeEntries           OtherIncomeEntry[]
  otherIncomeEntriesBranch     OtherIncomeEntry[]            @relation("OtherIncomeEntryBranch")
  staffDiscountAuthRequests    StaffDiscountAuthRequest[]
  orderCancellationRequests    OrderCancellationRequest[]
  discounts                    Discount[]
  customerDiscountAuthRequests CustomerDiscountAuthRequest[]
  directConversations          DirectConversation[]
  directMessages               DirectMessage[]
  broadcasts                   Broadcast[]
  broadcastRecipients          BroadcastRecipient[]
  formalNotices                FormalNotice[]
  formalNoticeRecipients       FormalNoticeRecipient[]
  leaveRequests                LeaveRequest[]
  disciplinaryRecords          DisciplinaryRecord[]
  payslips                     Payslip[]
  staffTransfersFrom           StaffTransfer[]               @relation("StaffTransferFrom")
  staffTransfersTo             StaffTransfer[]               @relation("StaffTransferTo")
  contractTypes                ContractType[]
  locations                    Location[]
  categories                   Category[]
  inventoryItems               InventoryItem[]
  suppliers                    Supplier[]
  restockLevels                RestockLevel[]
  inventoryTransactions        InventoryTransaction[]
  referenceCounters            ReferenceCounter[]
  expectedDeliveries           ExpectedDelivery[]
  goodsReceipts                GoodsReceipt[]
  supplierInvoices             SupplierInvoice[]
  supplierPayments             SupplierPayment[]
  prepRuns                     PrepRun[]
  requisitions                 Requisition[]
  dispatchesFrom               Dispatch[]                    @relation("DispatchFrom")
  dispatchesTo                 Dispatch[]                    @relation("DispatchTo")
  wasteLogs                    WasteLog[]
  stockCounts                  StockCount[]
  countingThresholds           CountingThresholds?
  branchDays                   BranchDay[]

  @@map("organizations")
}

model OrderCounter {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  orderDate      DateTime     @map("order_date") @db.Date
  lastNumber     Int          @default(0) @map("last_number")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, orderDate])
  @@index([organizationId])
  @@map("order_counters")
}

model User {
  id                                  String                        @id @default(uuid())
  organizationId                      String?                       @map("organization_id")
  name                                String
  email                               String                        @unique
  phone                               String?
  passwordHash                        String                        @map("password_hash")
  /**
   * 4-digit numeric PIN, bcrypt-hashed like passwordHash. Null until the user sets one via POST /users/me/pin. Used for in-app re-authentication (e.g. signing a Goods Receipt) distinct from the login password.
   */
  pinHash                             String?                       @map("pin_hash")
  fcmToken                            String?                       @map("fcm_token")
  role                                UserRole
  departmentTag                       DepartmentTag?                @map("department_tag")
  isDepartmentHead                    Boolean                       @default(false) @map("is_department_head")
  previousRole                        UserRole?                     @map("previous_role")
  isActive                            Boolean                       @default(true) @map("is_active")
  isTestUser                          Boolean                       @default(false) @map("is_test_user")
  createdAt                           DateTime                      @default(now()) @map("created_at")
  updatedAt                           DateTime                      @updatedAt @map("updated_at")
  deletedAt                           DateTime?                     @map("deleted_at")
  organization                        Organization?                 @relation(fields: [organizationId], references: [id])
  ordersCreated                       Order[]                       @relation("OrderCreatedBy")
  ordersCancelled                     Order[]                       @relation("OrderCancelledBy")
  orderCancellationRequestsRequested  OrderCancellationRequest[]    @relation("OrderCancellationRequestedBy")
  orderCancellationRequestsResolved   OrderCancellationRequest[]    @relation("OrderCancellationResolvedBy")
  shiftAssignments                    ShiftAssignment[]
  clockRecords                        ClockRecord[]
  prepTicketsClaimed                  PrepTicket[]                  @relation("PrepTicketClaimedBy")
  prepTicketsRejected                 PrepTicket[]                  @relation("PrepTicketRejectedBy")
  refreshTokens                       RefreshToken[]
  modRequestsCreated                  OrderModificationRequest[]    @relation("ModRequestedBy")
  modRequestsReviewed                 OrderModificationRequest[]    @relation("ModReviewedBy")
  incidentsActed                      IncidentLog[]                 @relation("IncidentActor")
  printJobsRequested                  PrintJob[]                    @relation("PrintJobRequester")
  houseAccount                        HouseAccount?                 @relation("HouseAccountHolder")
  houseAccountsGranted                HouseAccount[]                @relation("HouseAccountGrantedBy")
  houseAccountSettlements             HouseAccountSettlement[]      @relation("HouseAccountSettledBy")
  houseAuthRequestsRequested          HouseAccountAuthRequest[]     @relation("HouseAuthRequestedBy")
  houseAuthRequestsResolved           HouseAccountAuthRequest[]     @relation("HouseAuthResolvedBy")
  corporateAccountsCreated            CorporateAccount[]            @relation("CorporateAccountCreatedBy")
  corporateSettlements                CorporateAccountSettlement[]  @relation("CorporateAccountSettledBy")
  customerCreditAccountsCreated       CustomerCreditAccount[]       @relation("CustomerCreditAccountCreatedBy")
  customerCreditSettlements           CustomerCreditSettlement[]    @relation("CustomerCreditSettledBy")
  otherIncomeEntries                  OtherIncomeEntry[]            @relation("OtherIncomeRecordedBy")
  otherIncomeEntryEdits               OtherIncomeEntryEdit[]        @relation("OtherIncomeEntryEditedBy")
  ordersDiscounted                    Order[]                       @relation("OrderDiscountedBy")
  staffDiscountRequestsRequested      StaffDiscountAuthRequest[]    @relation("StaffDiscountRequestedBy")
  staffDiscountRequestsResolved       StaffDiscountAuthRequest[]    @relation("StaffDiscountResolvedBy")
  discountsCreated                    Discount[]                    @relation("DiscountCreatedBy")
  customerDiscountRequestsRequested   CustomerDiscountAuthRequest[] @relation("CustomerDiscountRequestedBy")
  customerDiscountRequestsResolved    CustomerDiscountAuthRequest[] @relation("CustomerDiscountResolvedBy")
  directConversationsAsA              DirectConversation[]          @relation("ConvParticipantA")
  directConversationsAsB              DirectConversation[]          @relation("ConvParticipantB")
  directMessagesSent                  DirectMessage[]               @relation("DirectMessageSender")
  broadcastsSent                      Broadcast[]                   @relation("BroadcastSender")
  broadcastRecipients                 BroadcastRecipient[]          @relation("BroadcastRecipientUser")
  formalNoticesIssued                 FormalNotice[]                @relation("FormalNoticeIssuer")
  formalNoticeRecipients              FormalNoticeRecipient[]       @relation("FormalNoticeRecipientUser")
  employeeProfile                     EmployeeProfile?              @relation("EmployeeProfileUser")
  managedEmployeeProfiles             EmployeeProfile[]             @relation("EmployeeProfileManager")
  leaveRequestsReviewed               LeaveRequest[]                @relation("LeaveReviewedBy")
  leaveRequestsCancelled              LeaveRequest[]                @relation("LeaveCancelledBy")
  leaveRequestAcknowledgements        LeaveRequestAcknowledgement[]
  disciplinaryRecordsIssued           DisciplinaryRecord[]          @relation("DisciplinaryIssuedBy")
  hrDocumentsUploaded                 HrDocument[]                  @relation("HrDocumentUploadedBy")
  payslips                            Payslip[]                     @relation("StaffPayslips")
  createdPayslips                     Payslip[]                     @relation("PayslipsCreated")
  staffTransfers                      StaffTransfer[]               @relation("StaffTransferUser")
  staffTransfersAuthorized            StaffTransfer[]               @relation("StaffTransferAuthorizedBy")
  inventoryTransactions               InventoryTransaction[]        @relation("InventoryTransactionUser")
  restockLevelsSet                    RestockLevel[]                @relation("RestockLevelSetBy")
  wasteLogsLogged                     WasteLog[]                    @relation("WasteLogLoggedBy")
  stockCountsCounted                  StockCount[]                  @relation("StockCountCounter")
  stockCountsVerified                 StockCount[]                  @relation("StockCountVerifier")
  stockCountsReturned                 StockCount[]                  @relation("StockCountReturnedBy")
  countingThresholdsUpdated           CountingThresholds[]          @relation("CountingThresholdsUpdatedBy")
  branchDaysClosed                    BranchDay[]                   @relation("BranchDayClosedBy")
  branchDayDepartmentsCounted         BranchDayDepartment[]         @relation("BranchDayDepartmentCountedBy")
  branchDayReopens                    BranchDayReopen[]             @relation("BranchDayReopenedBy")
  departmentOpeningsAccepted          DepartmentOpening[]           @relation("DepartmentOpeningAcceptedBy")
  countingThresholdsDirectorUpdated   CountingThresholds[]          @relation("CountingThresholdsDirectorUpdatedBy")
  expectedDeliveriesCreated           ExpectedDelivery[]            @relation("ExpectedDeliveryCreatedBy")
  goodsReceiptsSigned                 GoodsReceipt[]                @relation("GoodsReceiptSignedBy")
  goodsReceiptsCreated                GoodsReceipt[]                @relation("GoodsReceiptCreatedBy")
  goodsReceiptLinePriceAlertsAccepted GoodsReceiptLine[]            @relation("GoodsReceiptLinePriceAlertAcceptedBy")
  supplierInvoicesRecorded            SupplierInvoice[]             @relation("SupplierInvoiceRecordedBy")
  supplierInvoiceAdjustmentsRecorded  SupplierInvoiceAdjustment[]   @relation("SupplierInvoiceAdjustmentRecordedBy")
  supplierPaymentsRecorded            SupplierPayment[]             @relation("SupplierPaymentRecordedBy")
  prepRunsCreated                     PrepRun[]                     @relation("PrepRunCreatedBy")
  requisitionsOpened                  Requisition[]                 @relation("RequisitionOpenedBy")
  requisitionsApproved                Requisition[]                 @relation("RequisitionApprovedBy")
  dispatchesDispatched                Dispatch[]                    @relation("DispatchDispatchedBy")
  dispatchesConfirmed                 Dispatch[]                    @relation("DispatchConfirmedBy")
  discrepanciesResolved               Discrepancy[]                 @relation("DiscrepancyResolvedBy")
  requisitionSectionsSubmitted        RequisitionSection[]          @relation("RequisitionSectionSubmittedBy")
  requisitionLinesEdited              RequisitionLine[]             @relation("RequisitionLineEditedBy")

  @@index([organizationId])
  @@index([email])
  @@index([role])
  @@map("users")
}

model StaffTransfer {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  fromOrganizationId String?  @map("from_organization_id")
  toOrganizationId   String   @map("to_organization_id")
  notes              String?
  transferredAt      DateTime @default(now()) @map("transferred_at")
  authorizedById     String   @map("authorized_by_id")

  user             User          @relation("StaffTransferUser", fields: [userId], references: [id])
  fromOrganization Organization? @relation("StaffTransferFrom", fields: [fromOrganizationId], references: [id])
  toOrganization   Organization  @relation("StaffTransferTo", fields: [toOrganizationId], references: [id])
  authorizedBy     User          @relation("StaffTransferAuthorizedBy", fields: [authorizedById], references: [id])

  @@index([userId])
  @@index([fromOrganizationId])
  @@index([toOrganizationId])
  @@map("staff_transfers")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model MenuCategory {
  id           String      @id @default(uuid())
  name         String      @unique
  prepStation  PrepStation
  displayOrder Int         @default(0) @map("display_order")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  menuItems    MenuItem[]

  @@index([prepStation])
  @@map("menu_categories")
}

model MenuItem {
  id              String           @id @default(uuid())
  categoryId      String           @map("category_id")
  name            String
  description     String?
  imageUrl        String?          @map("image_url")
  price           Decimal          @db.Decimal(10, 2)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  category        MenuCategory     @relation(fields: [categoryId], references: [id])
  branchOverrides BranchMenuItem[]
  orderItems      OrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("menu_items")
}

model BranchMenuItem {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  menuItemId     String       @map("menu_item_id")
  isAvailable    Boolean      @default(true) @map("is_available")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  updatedBy      String       @map("updated_by")
  organization   Organization @relation(fields: [organizationId], references: [id])
  menuItem       MenuItem     @relation(fields: [menuItemId], references: [id])

  @@unique([organizationId, menuItemId])
  @@index([organizationId])
  @@index([menuItemId])
  @@map("branch_menu_items")
}

model DeliveryZone {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  fee            Decimal      @db.Decimal(10, 2)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  orders         Order[]

  @@index([organizationId])
  @@map("delivery_zones")
}

model Shift {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  name           String
  startTime      String            @map("start_time")
  endTime        String            @map("end_time")
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  organization   Organization      @relation(fields: [organizationId], references: [id])
  assignments    ShiftAssignment[]

  @@index([organizationId])
  @@map("shifts")
}

model ShiftAssignment {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  shiftId        String       @map("shift_id")
  userId         String       @map("user_id")
  date           DateTime     @db.Date
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  shift          Shift        @relation(fields: [shiftId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  clockRecord    ClockRecord?

  @@unique([userId, date, shiftId])
  @@index([organizationId])
  @@index([userId])
  @@index([date])
  @@map("shift_assignments")
}

model ClockRecord {
  id                String          @id @default(uuid())
  organizationId    String          @map("organization_id")
  shiftAssignmentId String          @unique @map("shift_assignment_id")
  userId            String          @map("user_id")
  clockInAt         DateTime?       @map("clock_in_at")
  clockOutAt        DateTime?       @map("clock_out_at")
  clockInMethod     ClockMethod     @map("clock_in_method")
  clockOutMethod    ClockMethod?    @map("clock_out_method")
  overrideById      String?         @map("override_by_id")
  overrideNote      String?         @map("override_note")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  shiftAssignment   ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id])
  user              User            @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([clockInAt])
  @@map("clock_records")
}

model Order {
  id                           String                        @id @default(uuid())
  organizationId               String                        @map("organization_id")
  dailyNumber                  Int                           @map("daily_number")
  orderDate                    DateTime                      @map("order_date") @db.Date
  type                         OrderType
  status                       OrderStatus                   @default(PENDING)
  tableNumber                  String?                       @map("table_number")
  notes                        String?
  subtotal                     Decimal                       @db.Decimal(10, 2)
  deliveryFee                  Decimal                       @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  total                        Decimal                       @db.Decimal(10, 2)
  paymentMethod                PaymentMethod?                @map("payment_method")
  mpesaCode                    String?                       @map("mpesa_code")
  mpesaAmount                  Decimal?                      @map("mpesa_amount") @db.Decimal(10, 2)
  cashAmount                   Decimal?                      @map("cash_amount") @db.Decimal(10, 2)
  cardAmount                   Decimal?                      @map("card_amount") @db.Decimal(10, 2)
  splitType                    String?                       @map("split_type")
  paidAt                       DateTime?                     @map("paid_at")
  cancelReason                 String?                       @map("cancel_reason")
  cancelledById                String?                       @map("cancelled_by_id")
  deliveryZoneId               String?                       @map("delivery_zone_id")
  houseAccountId               String?                       @map("house_account_id")
  corporateAccountId           String?                       @map("corporate_account_id")
  corporateEmployeeRef         String?                       @map("corporate_employee_ref")
  customerCreditAccountId      String?                       @map("customer_credit_account_id")
  discountPercent              Decimal?                      @map("discount_percent") @db.Decimal(5, 2)
  discountAmount               Decimal?                      @map("discount_amount") @db.Decimal(10, 2)
  discountedById               String?                       @map("discounted_by_id")
  discountId                   String?                       @map("discount_id")
  createdById                  String                        @map("created_by_id")
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  closedAt                     DateTime?                     @map("closed_at")
  organization                 Organization                  @relation(fields: [organizationId], references: [id])
  deliveryZone                 DeliveryZone?                 @relation(fields: [deliveryZoneId], references: [id])
  houseAccount                 HouseAccount?                 @relation(fields: [houseAccountId], references: [id])
  corporateAccount             CorporateAccount?             @relation(fields: [corporateAccountId], references: [id])
  customerCreditAccount        CustomerCreditAccount?        @relation(fields: [customerCreditAccountId], references: [id])
  createdBy                    User                          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  cancelledBy                  User?                         @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  discountedBy                 User?                         @relation("OrderDiscountedBy", fields: [discountedById], references: [id])
  discount                     Discount?                     @relation(fields: [discountId], references: [id])
  items                        OrderItem[]
  prepTickets                  PrepTicket[]
  modificationRequests         OrderModificationRequest[]
  incidents                    IncidentLog[]
  printJobs                    PrintJob[]
  houseAuthRequests            HouseAccountAuthRequest[]
  staffDiscountAuthRequests    StaffDiscountAuthRequest[]
  customerDiscountAuthRequests CustomerDiscountAuthRequest[]
  cancellationRequests         OrderCancellationRequest[]
  splitPaymentLines            SplitPaymentLine[]

  @@unique([organizationId, dailyNumber, orderDate])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, orderDate])
  @@index([createdById])
  @@map("orders")
}

model OrderCancellationRequest {
  id             String                    @id @default(uuid())
  organizationId String                    @map("organization_id")
  orderId        String                    @map("order_id")
  requestedById  String                    @map("requested_by_id")
  reason         String
  reasonDetail   String?                   @map("reason_detail")
  previousStatus OrderStatus               @map("previous_status")
  status         CancellationRequestStatus @default(PENDING)
  resolvedById   String?                   @map("resolved_by_id")
  resolvedAt     DateTime?                 @map("resolved_at")
  resolutionNote String?                   @map("resolution_note")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])
  requestedBy  User         @relation("OrderCancellationRequestedBy", fields: [requestedById], references: [id])
  resolvedBy   User?        @relation("OrderCancellationResolvedBy", fields: [resolvedById], references: [id])

  @@index([organizationId])
  @@index([orderId])
  @@index([requestedById])
  @@index([status])
  @@map("order_cancellation_requests")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  menuItemId String   @map("menu_item_id")
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)
  notes      String?
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model SplitPaymentLine {
  id        String        @id @default(uuid())
  orderId   String        @map("order_id")
  label     String
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  mpesaCode String?       @map("mpesa_code")
  paidAt    DateTime      @default(now()) @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("split_payment_lines")
}

model PrepTicket {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  orderId        String           @map("order_id")
  station        PrepStation
  sequence       Int              @default(1)
  status         PrepTicketStatus @default(PENDING)
  claimedById    String?          @map("claimed_by_id")
  claimedAt      DateTime?        @map("claimed_at")
  readyAt        DateTime?        @map("ready_at")
  rejectedById   String?          @map("rejected_by_id")
  rejectedReason String?          @map("rejected_reason")
  rejectedAt     DateTime?        @map("rejected_at")
  items          Json
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id])
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  claimedBy      User?            @relation("PrepTicketClaimedBy", fields: [claimedById], references: [id])
  rejectedBy     User?            @relation("PrepTicketRejectedBy", fields: [rejectedById], references: [id])

  @@unique([orderId, station, sequence])
  @@index([organizationId])
  @@index([organizationId, station, status])
  @@index([claimedById])
  @@map("prep_tickets")
}

enum UserRole {
  SYSTEM_ADMIN
  DIRECTOR
  HR_MANAGER
  MANAGER
  ACCOUNTANT
  WAITER
  CHEF
  BARISTA
  KITCHEN_DISPLAY
  BARISTA_DISPLAY
  STEWARD
  HOUSEKEEPING
  STORE_MANAGER
  STORE_ATTENDANT
  DEPARTMENT_HEAD
}

enum PrepStation {
  KITCHEN
  BARISTA
  PIZZA
  PASTRY
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  READY
  AWAITING_AUTHORIZATION
  AWAITING_CANCELLATION_APPROVAL
  CLOSED
  CANCELLED
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HouseAccountAuthStatus {
  PENDING
  APPROVED
  REJECTED
  TIMED_OUT
}

enum PrepTicketStatus {
  PENDING
  IN_PROGRESS
  READY
  REJECTED
}

enum PaymentMethod {
  MPESA
  CASH
  CARD
  SPLIT
  GUEST_SPLIT
  HOUSE_ACCOUNT
  CORPORATE_ACCOUNT
  CUSTOMER_CREDIT
}

enum ClockMethod {
  GPS
  OVERRIDE
}

enum IncidentType {
  ORDER_CANCELLED
  TICKET_REJECTED
  MODIFICATION_REQUESTED
  MODIFICATION_APPROVED
  MODIFICATION_REJECTED
  TICKET_UNCLAIMED
  ORDER_STALE
  ORDER_ITEM_REMOVED
  PAYMENT_REJECTED
  ORDER_CANCELLATION_REJECTED
  ORDER_CORRECTION
}

enum ModificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model OrderModificationRequest {
  id             String                    @id @default(uuid())
  organizationId String                    @map("organization_id")
  orderId        String                    @map("order_id")
  requestedById  String                    @map("requested_by_id")
  description    String
  status         ModificationRequestStatus @default(PENDING)
  reviewedById   String?                   @map("reviewed_by_id")
  reviewedAt     DateTime?                 @map("reviewed_at")
  reviewNote     String?                   @map("review_note")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  order          Order                     @relation(fields: [orderId], references: [id])
  requestedBy    User                      @relation("ModRequestedBy", fields: [requestedById], references: [id])
  reviewedBy     User?                     @relation("ModReviewedBy", fields: [reviewedById], references: [id])

  @@index([organizationId])
  @@index([orderId])
  @@index([organizationId, status])
  @@map("order_modification_requests")
}

model IncidentLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  orderId        String?      @map("order_id")
  type           IncidentType
  actorId        String?      @map("actor_id")
  details        Json
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  order          Order?       @relation(fields: [orderId], references: [id])
  actor          User?        @relation("IncidentActor", fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([orderId])
  @@index([createdAt])
  @@map("incident_logs")
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  orderId   String   @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key])
  @@map("idempotency_keys")
}

model PrintJob {
  id                           String         @id @default(uuid())
  organizationId               String         @map("organization_id")
  orderId                      String?        @map("order_id")
  corporateAccountSettlementId String?        @map("corporate_account_settlement_id")
  activeKey                    String?        @unique @map("active_key")
  receiptType                  ReceiptType    @default(RECEIPT) @map("receipt_type")
  copies                       Int            @default(1)
  status                       PrintJobStatus @default(PENDING)
  receiptData                  Json           @map("receipt_data")
  requestedById                String         @map("requested_by_id")
  targetStationId              String?        @map("target_station_id")
  claimedByStationId           String?        @map("claimed_by_station_id")
  claimedAt                    DateTime?      @map("claimed_at")
  leaseExpiresAt               DateTime?      @map("lease_expires_at")
  printAttemptCount            Int            @default(0) @map("print_attempt_count")
  printedByStationId           String?        @map("printed_by_station_id")
  printedAt                    DateTime?      @map("printed_at")
  failureReason                String?        @map("failure_reason")
  createdAt                    DateTime       @default(now()) @map("created_at")
  updatedAt                    DateTime       @updatedAt @map("updated_at")

  organization               Organization                @relation(fields: [organizationId], references: [id])
  order                      Order?                      @relation(fields: [orderId], references: [id])
  corporateAccountSettlement CorporateAccountSettlement? @relation(fields: [corporateAccountSettlementId], references: [id])
  requestedBy                User                        @relation("PrintJobRequester", fields: [requestedById], references: [id])
  targetStation              PrintStation?               @relation("PrintJobTargetStation", fields: [targetStationId], references: [id])
  claimedByStation           PrintStation?               @relation("PrintJobClaimedBy", fields: [claimedByStationId], references: [id])
  printedByStation           PrintStation?               @relation("PrintJobPrintedBy", fields: [printedByStationId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, status, targetStationId])
  @@index([orderId])
  @@index([corporateAccountSettlementId])
  @@map("print_jobs")
}

model PrintStation {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String    @default("Default Printer")
  token          String    @unique
  isActive       Boolean   @default(true) @map("is_active")
  lastSeenAt     DateTime? @map("last_seen_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  targetedJobs PrintJob[]   @relation("PrintJobTargetStation")
  claimedJobs  PrintJob[]   @relation("PrintJobClaimedBy")
  printedJobs  PrintJob[]   @relation("PrintJobPrintedBy")

  @@index([organizationId])
  @@index([token])
  @@map("print_stations")
}

enum PrintJobStatus {
  PENDING
  PRINTING
  COMPLETED
  FAILED
}

enum ReceiptType {
  BILL
  RECEIPT
  SETTLEMENT
}

// ─── Credit Account Models ────────────────────────────────────────────────────

model HouseAccount {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  creditLimit    Decimal? @map("credit_limit") @db.Decimal(10, 2)
  currentBalance Decimal  @default(0) @map("current_balance") @db.Decimal(10, 2)
  isActive       Boolean  @default(true) @map("is_active")
  grantedById    String   @map("granted_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User                      @relation("HouseAccountHolder", fields: [userId], references: [id])
  grantedBy    User                      @relation("HouseAccountGrantedBy", fields: [grantedById], references: [id])
  settlements  HouseAccountSettlement[]
  orders       Order[]
  authRequests HouseAccountAuthRequest[]

  @@index([userId])
  @@index([isActive])
  @@map("house_accounts")
}

model HouseAccountSettlement {
  id             String   @id @default(uuid())
  houseAccountId String   @map("house_account_id")
  amount         Decimal  @db.Decimal(10, 2)
  note           String?
  settledById    String   @map("settled_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  houseAccount HouseAccount @relation(fields: [houseAccountId], references: [id])
  settledBy    User         @relation("HouseAccountSettledBy", fields: [settledById], references: [id])

  @@index([houseAccountId])
  @@map("house_account_settlements")
}

model HouseAccountAuthRequest {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  orderId        String                 @map("order_id")
  houseAccountId String                 @map("house_account_id")
  requestedById  String                 @map("requested_by_id")
  amount         Decimal                @db.Decimal(10, 2)
  status         HouseAccountAuthStatus @default(PENDING)
  bullmqJobId    String?                @map("bullmq_job_id")
  expiresAt      DateTime               @map("expires_at")
  resolvedById   String?                @map("resolved_by_id")
  resolvedAt     DateTime?              @map("resolved_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  order        Order        @relation(fields: [orderId], references: [id])
  houseAccount HouseAccount @relation(fields: [houseAccountId], references: [id])
  requestedBy  User         @relation("HouseAuthRequestedBy", fields: [requestedById], references: [id])
  resolvedBy   User?        @relation("HouseAuthResolvedBy", fields: [resolvedById], references: [id])

  @@index([organizationId])
  @@index([orderId])
  @@index([houseAccountId])
  @@index([status])
  @@map("house_account_auth_requests")
}

model CorporateAccount {
  id              String   @id @default(uuid())
  companyName     String   @map("company_name")
  contactName     String   @map("contact_name")
  contactPhone    String   @map("contact_phone")
  contactEmail    String?  @map("contact_email")
  creditLimit     Decimal? @map("credit_limit") @db.Decimal(10, 2)
  currentBalance  Decimal  @default(0) @map("current_balance") @db.Decimal(10, 2)
  billingCycleDay Int      @default(1) @map("billing_cycle_day")
  isActive        Boolean  @default(true) @map("is_active")
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  createdBy   User                         @relation("CorporateAccountCreatedBy", fields: [createdById], references: [id])
  settlements CorporateAccountSettlement[]
  orders      Order[]

  @@index([isActive])
  @@index([companyName])
  @@map("corporate_accounts")
}

model CorporateAccountSettlement {
  id                 String        @id @default(uuid())
  corporateAccountId String        @map("corporate_account_id")
  amount             Decimal       @db.Decimal(10, 2)
  paymentMethod      PaymentMethod @map("payment_method")
  note               String?
  settledById        String        @map("settled_by_id")
  createdAt          DateTime      @default(now()) @map("created_at")

  corporateAccount CorporateAccount @relation(fields: [corporateAccountId], references: [id])
  settledBy        User             @relation("CorporateAccountSettledBy", fields: [settledById], references: [id])
  printJobs        PrintJob[]

  @@index([corporateAccountId])
  @@map("corporate_account_settlements")
}

model CustomerCreditAccount {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  customerName   String   @map("customer_name")
  customerPhone  String   @map("customer_phone")
  creditLimit    Decimal  @map("credit_limit") @db.Decimal(10, 2)
  currentBalance Decimal  @default(0) @map("current_balance") @db.Decimal(10, 2)
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization               @relation(fields: [organizationId], references: [id])
  createdBy    User                       @relation("CustomerCreditAccountCreatedBy", fields: [createdById], references: [id])
  settlements  CustomerCreditSettlement[]
  orders       Order[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([customerPhone])
  @@map("customer_credit_accounts")
}

model CustomerCreditSettlement {
  id                      String   @id @default(uuid())
  customerCreditAccountId String   @map("customer_credit_account_id")
  amount                  Decimal  @db.Decimal(10, 2)
  note                    String?
  settledById             String   @map("settled_by_id")
  createdAt               DateTime @default(now()) @map("created_at")

  customerCreditAccount CustomerCreditAccount @relation(fields: [customerCreditAccountId], references: [id])
  settledBy             User                  @relation("CustomerCreditSettledBy", fields: [settledById], references: [id])

  @@index([customerCreditAccountId])
  @@map("customer_credit_settlements")
}

// ─── Other Income ─────────────────────────────────────────────────────────────

enum OtherIncomePaymentMethod {
  CASH
  MPESA
  CARD
  SPLIT
}

model OtherIncomeCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  branchId       String?  @map("branch_id") // null = available to all branches in the org
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id])
  branch       Organization?      @relation("OtherIncomeCategoryBranch", fields: [branchId], references: [id])
  entries      OtherIncomeEntry[]

  @@index([organizationId])
  @@index([branchId])
  @@map("other_income_categories")
}

model OtherIncomeEntry {
  id             String                   @id @default(uuid())
  organizationId String                   @map("organization_id")
  branchId       String                   @map("branch_id")
  categoryId     String                   @map("category_id")
  amount         Decimal                  @db.Decimal(10, 2)
  paymentMethod  OtherIncomePaymentMethod @map("payment_method")
  mpesaCode      String?                  @map("mpesa_code")
  mpesaAmount    Decimal?                 @map("mpesa_amount") @db.Decimal(10, 2)
  cashAmount     Decimal?                 @map("cash_amount") @db.Decimal(10, 2)
  cardAmount     Decimal?                 @map("card_amount") @db.Decimal(10, 2)
  splitType      String?                  @map("split_type")
  description    String?
  entryDate      DateTime                 @map("entry_date") @db.Date
  recordedById   String                   @map("recorded_by_id")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id])
  branch       Organization           @relation("OtherIncomeEntryBranch", fields: [branchId], references: [id])
  category     OtherIncomeCategory    @relation(fields: [categoryId], references: [id])
  recordedBy   User                   @relation("OtherIncomeRecordedBy", fields: [recordedById], references: [id])
  edits        OtherIncomeEntryEdit[]

  @@index([organizationId])
  @@index([branchId])
  @@index([organizationId, entryDate])
  @@index([categoryId])
  @@map("other_income_entries")
}

/// Audit trail for corrections made to an OtherIncomeEntry after it was recorded.
/// One row per edit action; `changes` holds an array of { field, from, to } objects.
model OtherIncomeEntryEdit {
  id         String   @id @default(uuid())
  entryId    String   @map("entry_id")
  editedById String   @map("edited_by_id")
  changes    Json
  createdAt  DateTime @default(now()) @map("created_at")

  entry    OtherIncomeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  editedBy User             @relation("OtherIncomeEntryEditedBy", fields: [editedById], references: [id])

  @@index([entryId])
  @@map("other_income_entry_edits")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CustomerDiscountAuthStatus {
  PENDING
  APPROVED
  REJECTED
}

model Discount {
  id               String       @id @default(uuid())
  // organizationId is null when the discount is scoped to ALL branches (hub-level)
  organizationId   String?      @map("organization_id")
  name             String
  type             DiscountType
  value            Decimal      @db.Decimal(5, 2)
  requiresApproval Boolean      @default(false) @map("requires_approval")
  isActive         Boolean      @default(true) @map("is_active")
  createdById      String       @map("created_by_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization                 Organization?                 @relation(fields: [organizationId], references: [id])
  createdBy                    User                          @relation("DiscountCreatedBy", fields: [createdById], references: [id])
  orders                       Order[]
  customerDiscountAuthRequests CustomerDiscountAuthRequest[]

  @@index([organizationId])
  @@index([isActive])
  @@map("discounts")
}

enum StaffDiscountAuthStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model StaffDiscountAuthRequest {
  id              String                  @id @default(uuid())
  organizationId  String                  @map("organization_id")
  orderId         String                  @map("order_id")
  requestedById   String                  @map("requested_by_id")
  discountPercent Decimal                 @map("discount_percent") @db.Decimal(5, 2)
  originalAmount  Decimal                 @map("original_amount") @db.Decimal(10, 2)
  discountAmount  Decimal                 @map("discount_amount") @db.Decimal(10, 2)
  status          StaffDiscountAuthStatus @default(PENDING)
  resolvedById    String?                 @map("resolved_by_id")
  resolvedAt      DateTime?               @map("resolved_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])
  requestedBy  User         @relation("StaffDiscountRequestedBy", fields: [requestedById], references: [id])
  resolvedBy   User?        @relation("StaffDiscountResolvedBy", fields: [resolvedById], references: [id])

  @@index([organizationId])
  @@index([orderId])
  @@index([status])
  @@map("staff_discount_auth_requests")
}

model CustomerDiscountAuthRequest {
  id              String                     @id @default(uuid())
  organizationId  String                     @map("organization_id")
  orderId         String                     @map("order_id")
  discountId      String                     @map("discount_id")
  requestedById   String                     @map("requested_by_id")
  discountPercent Decimal?                   @map("discount_percent") @db.Decimal(5, 2)
  discountFixed   Decimal?                   @map("discount_fixed") @db.Decimal(10, 2)
  originalAmount  Decimal                    @map("original_amount") @db.Decimal(10, 2)
  discountAmount  Decimal                    @map("discount_amount") @db.Decimal(10, 2)
  status          CustomerDiscountAuthStatus @default(PENDING)
  resolvedById    String?                    @map("resolved_by_id")
  resolvedAt      DateTime?                  @map("resolved_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])
  discount     Discount     @relation(fields: [discountId], references: [id])
  requestedBy  User         @relation("CustomerDiscountRequestedBy", fields: [requestedById], references: [id])
  resolvedBy   User?        @relation("CustomerDiscountResolvedBy", fields: [resolvedById], references: [id])

  @@index([organizationId])
  @@index([orderId])
  @@index([status])
  @@map("customer_discount_auth_requests")
}

// ─── Internal Communications ───────────────────────────────────────────────

enum BroadcastScope {
  COMPANY
  BRANCH
  ROLE_GROUP
}

model DirectConversation {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  participantAId String   @map("participant_a_id")
  participantBId String   @map("participant_b_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  participantA User            @relation("ConvParticipantA", fields: [participantAId], references: [id])
  participantB User            @relation("ConvParticipantB", fields: [participantBId], references: [id])
  messages     DirectMessage[]

  @@unique([organizationId, participantAId, participantBId])
  @@index([organizationId])
  @@index([participantAId])
  @@index([participantBId])
  @@map("direct_conversations")
}

model DirectMessage {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  organizationId String    @map("organization_id")
  senderId       String    @map("sender_id")
  bodyHtml       String    @map("body_html")
  attachmentUrl  String?   @map("attachment_url")
  attachmentName String?   @map("attachment_name")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  conversation DirectConversation @relation(fields: [conversationId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  sender       User               @relation("DirectMessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([organizationId])
  @@map("direct_messages")
}

model Broadcast {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  senderId       String         @map("sender_id")
  scope          BroadcastScope
  targetRole     UserRole?      @map("target_role")
  subject        String
  bodyHtml       String         @map("body_html")
  attachmentUrl  String?        @map("attachment_url")
  attachmentName String?        @map("attachment_name")
  requiresAck    Boolean        @default(false) @map("requires_ack")
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id])
  sender       User                 @relation("BroadcastSender", fields: [senderId], references: [id])
  recipients   BroadcastRecipient[]

  @@index([organizationId, createdAt])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id             String    @id @default(uuid())
  broadcastId    String    @map("broadcast_id")
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  readAt         DateTime? @map("read_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  broadcast    Broadcast    @relation(fields: [broadcastId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation("BroadcastRecipientUser", fields: [userId], references: [id])

  @@unique([broadcastId, userId])
  @@index([broadcastId])
  @@index([userId])
  @@index([organizationId])
  @@map("broadcast_recipients")
}

model FormalNotice {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  issuerId       String   @map("issuer_id")
  subject        String
  bodyHtml       String   @map("body_html")
  attachmentUrl  String?  @map("attachment_url")
  attachmentName String?  @map("attachment_name")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization            @relation(fields: [organizationId], references: [id])
  issuer       User                    @relation("FormalNoticeIssuer", fields: [issuerId], references: [id])
  recipients   FormalNoticeRecipient[]

  @@index([organizationId, createdAt])
  @@map("formal_notices")
}

model FormalNoticeRecipient {
  id                 String    @id @default(uuid())
  noticeId           String    @map("notice_id")
  organizationId     String    @map("organization_id")
  userId             String    @map("user_id")
  acknowledgedAt     DateTime? @map("acknowledged_at")
  reminder24SentAt   DateTime? @map("reminder_24_sent_at")
  escalation48SentAt DateTime? @map("escalation_48_sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  notice       FormalNotice @relation(fields: [noticeId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation("FormalNoticeRecipientUser", fields: [userId], references: [id])

  @@unique([noticeId, userId])
  @@index([noticeId])
  @@index([userId])
  @@index([organizationId])
  @@index([acknowledgedAt, createdAt])
  @@map("formal_notice_recipients")
}

// ─── HR Module ────────────────────────────────────────────────────────────────

model EmployeeProfile {
  id                 String          @id @default(uuid())
  userId             String          @unique @map("user_id")
  nationalId         String?         @map("national_id")
  dateOfBirth        DateTime?       @map("date_of_birth")
  personalPhone      String?         @map("personal_phone")
  personalEmail      String?         @map("personal_email")
  physicalAddress    String?         @map("physical_address")
  emergencyName      String?         @map("emergency_name")
  emergencyRelation  String?         @map("emergency_relation")
  emergencyPhone     String?         @map("emergency_phone")
  employmentType     EmploymentType? @map("employment_type")
  contractTypeId     String?         @map("contract_type_id")
  startDate          DateTime        @map("start_date")
  endDate            DateTime?       @map("end_date")
  probationEndDate   DateTime?       @map("probation_end_date")
  jobTitle           String?         @map("job_title")
  reportingManagerId String?         @map("reporting_manager_id")
  notes              String?
  kraPIN             String?         @map("kra_pin")
  shifNhifNumber     String?         @map("shif_nhif_number")
  nssfNumber         String?         @map("nssf_number")
  bankName           String?         @map("bank_name")
  accountNumber      String?         @map("account_number")
  accountName        String?         @map("account_name")
  bankBranch         String?         @map("bank_branch")
  helbNumber         String?         @map("helb_number")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  user                User                 @relation("EmployeeProfileUser", fields: [userId], references: [id])
  reportingManager    User?                @relation("EmployeeProfileManager", fields: [reportingManagerId], references: [id])
  contractType        ContractType?        @relation(fields: [contractTypeId], references: [id])
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  documents           HrDocument[]
  disciplinaryRecords DisciplinaryRecord[]

  @@index([userId])
  @@index([contractTypeId])
  @@map("employee_profiles")
}

model ContractType {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  name           String
  durationMonths Int?     @map("duration_months")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization?     @relation(fields: [organizationId], references: [id])
  leavePolicies    LeavePolicy[]
  employeeProfiles EmployeeProfile[]

  @@index([organizationId])
  @@map("contract_types")
}

model LeavePolicy {
  id             String    @id @default(uuid())
  contractTypeId String    @map("contract_type_id")
  leaveType      LeaveType @map("leave_type")
  totalDays      Int       @map("total_days")

  contractType ContractType @relation(fields: [contractTypeId], references: [id], onDelete: Cascade)

  @@unique([contractTypeId, leaveType])
  @@map("leave_policies")
}

model LeaveBalance {
  id                String    @id @default(uuid())
  employeeProfileId String    @map("employee_profile_id")
  leaveType         LeaveType @map("leave_type")
  totalDays         Int       @map("total_days")
  usedDays          Decimal   @default(0) @map("used_days") @db.Decimal(5, 1)
  pendingDays       Decimal   @default(0) @map("pending_days") @db.Decimal(5, 1)
  leaveYear         Int       @map("leave_year")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id])
  leaveRequests   LeaveRequest[]

  @@unique([employeeProfileId, leaveType, leaveYear])
  @@index([employeeProfileId])
  @@map("leave_balances")
}

model LeaveRequest {
  id                String      @id @default(uuid())
  employeeProfileId String      @map("employee_profile_id")
  leaveBalanceId    String      @map("leave_balance_id")
  organizationId    String?     @map("organization_id")
  leaveType         LeaveType   @map("leave_type")
  startDate         DateTime    @map("start_date")
  endDate           DateTime    @map("end_date")
  totalDays         Decimal     @map("total_days") @db.Decimal(5, 1)
  reason            String
  status            LeaveStatus @default(PENDING)
  reviewedById      String?     @map("reviewed_by_id")
  reviewedAt        DateTime?   @map("reviewed_at")
  reviewComment     String?     @map("review_comment")
  cancelledAt       DateTime?   @map("cancelled_at")
  cancelledById     String?     @map("cancelled_by_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  employeeProfile  EmployeeProfile               @relation(fields: [employeeProfileId], references: [id])
  leaveBalance     LeaveBalance                  @relation(fields: [leaveBalanceId], references: [id])
  organization     Organization?                 @relation(fields: [organizationId], references: [id])
  reviewedBy       User?                         @relation("LeaveReviewedBy", fields: [reviewedById], references: [id])
  cancelledBy      User?                         @relation("LeaveCancelledBy", fields: [cancelledById], references: [id])
  documents        HrDocument[]
  acknowledgements LeaveRequestAcknowledgement[]

  @@index([organizationId, status])
  @@index([employeeProfileId])
  @@map("leave_requests")
}

model LeaveRequestAcknowledgement {
  id             String   @id @default(uuid())
  leaveRequestId String   @map("leave_request_id")
  userId         String   @map("user_id")
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([leaveRequestId, userId])
  @@index([userId])
  @@map("leave_request_acknowledgements")
}

model DisciplinaryRecord {
  id                String               @id @default(uuid())
  employeeProfileId String               @map("employee_profile_id")
  organizationId    String               @map("organization_id")
  incidentDate      DateTime             @map("incident_date")
  actionDate        DateTime             @map("action_date")
  category          DisciplinaryCategory
  description       String
  actionTaken       DisciplinaryAction   @map("action_taken")
  outcome           String
  issuedById        String               @map("issued_by_id")
  witnesses         String?
  acknowledged      Boolean              @default(false)
  acknowledgedAt    DateTime?            @map("acknowledged_at")
  appealed          Boolean              @default(false)
  appealOutcome     String?              @map("appeal_outcome")
  expiresAt         DateTime?            @map("expires_at")
  createdAt         DateTime             @default(now()) @map("created_at")

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id])
  organization    Organization    @relation(fields: [organizationId], references: [id])
  issuedBy        User            @relation("DisciplinaryIssuedBy", fields: [issuedById], references: [id])
  documents       HrDocument[]

  @@index([organizationId])
  @@index([employeeProfileId])
  @@map("disciplinary_records")
}

model HrDocument {
  id                   String         @id @default(uuid())
  employeeProfileId    String         @map("employee_profile_id")
  leaveRequestId       String?        @map("leave_request_id")
  disciplinaryRecordId String?        @map("disciplinary_record_id")
  documentType         HrDocumentType @map("document_type")
  fileName             String         @map("file_name")
  fileUrl              String         @map("file_url")
  uploadedById         String         @map("uploaded_by_id")
  createdAt            DateTime       @default(now()) @map("created_at")

  employeeProfile    EmployeeProfile     @relation(fields: [employeeProfileId], references: [id])
  leaveRequest       LeaveRequest?       @relation(fields: [leaveRequestId], references: [id])
  disciplinaryRecord DisciplinaryRecord? @relation(fields: [disciplinaryRecordId], references: [id])
  uploadedBy         User                @relation("HrDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([employeeProfileId])
  @@index([leaveRequestId])
  @@index([disciplinaryRecordId])
  @@map("hr_documents")
}

model Payslip {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  userId          String   @map("user_id")
  payPeriod       String   @map("pay_period")
  payDate         DateTime @map("pay_date")
  grossPay        Decimal  @map("gross_pay") @db.Decimal(10, 2)
  paye            Decimal  @db.Decimal(10, 2)
  sha             Decimal  @db.Decimal(10, 2)
  nssfTier1       Decimal  @map("nssf_tier1") @db.Decimal(10, 2)
  nssfTier2       Decimal  @map("nssf_tier2") @db.Decimal(10, 2)
  housingLevy     Decimal  @map("housing_levy") @db.Decimal(10, 2)
  helb            Decimal? @db.Decimal(10, 2)
  advance         Decimal? @db.Decimal(10, 2)
  incentives      Decimal? @db.Decimal(10, 2)
  overtime        Decimal? @db.Decimal(10, 2)
  allowances      Decimal? @db.Decimal(10, 2)
  otherDeductions Json?    @map("other_deductions")
  totalDeductions Decimal  @map("total_deductions") @db.Decimal(10, 2)
  netPay          Decimal  @map("net_pay") @db.Decimal(10, 2)
  isLocked        Boolean  @default(false) @map("is_locked")
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation("StaffPayslips", fields: [userId], references: [id])
  createdBy    User         @relation("PayslipsCreated", fields: [createdById], references: [id])

  @@unique([organizationId, userId, payPeriod])
  @@index([organizationId, payPeriod])
  @@index([userId])
  @@map("payslips")
}

// ─── HR Enums ─────────────────────────────────────────────────────────────────

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CASUAL
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DisciplinaryCategory {
  INSUBORDINATION
  ATTENDANCE
  MISCONDUCT
  PERFORMANCE
  POLICY_VIOLATION
  OTHER
}

enum DisciplinaryAction {
  VERBAL_WARNING
  WRITTEN_WARNING
  FINAL_WARNING
  SUSPENSION
  TERMINATION
}

enum HrDocumentType {
  CONTRACT
  ID_COPY
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  CERTIFICATE
  MEDICAL_CERTIFICATE
  INCIDENT_REPORT
  WARNING_LETTER
  OTHER
}

// ============================================================================
// Inventory & Procurement — Phase 1 (Central Store)
// See docs/context/INVENTORY-FEATURE/INVENTORY_FEATURE_PLAN.md for the full
// spec. Location is deliberately its own entity — never Organization.isHub
// (D-1). Phase 1 creates exactly one Location row (type CENTRAL_STORE).
// Phase 2 adds one Location per (branch, department) pair.
// ============================================================================

enum LocationType {
  CENTRAL_STORE
  BRANCH_DEPARTMENT
}

enum DepartmentTag {
  KITCHEN
  PASTRY
  BARISTA
  SERVICE
  HOUSEKEEPING
}

model Location {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  type           LocationType
  departmentTag  DepartmentTag? @map("department_tag")
  name           String
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization         Organization           @relation(fields: [organizationId], references: [id])
  transactions         InventoryTransaction[]
  restockLevels        RestockLevel[]
  goodsReceipts        GoodsReceipt[]
  prepRuns             PrepRun[]
  wasteLogs            WasteLog[]
  stockCounts          StockCount[]
  branchDayDepartments BranchDayDepartment[]
  departmentOpenings   DepartmentOpening[]

  // Phase 1 creates exactly one CENTRAL_STORE row per organization (feature
  // plan D-1) — this constraint enforces that invariant at the DB level.
  // Phase 2 adds one BRANCH_DEPARTMENT row per (branch org, department tag) —
  // departmentTag is null for CENTRAL_STORE and non-null for BRANCH_DEPARTMENT,
  // so the two location types never collide under this constraint.
  // A partial unique index (migration 20260731090000, not expressible in
  // Prisma DSL) additionally enforces that only ONE CENTRAL_STORE row exists
  // across all organizations — it belongs to the hub org (design doc D-15).
  @@unique([organizationId, type, departmentTag])
  @@index([organizationId])
  @@map("locations")
}

enum InventoryItemType {
  RAW_INGREDIENT // Central Store only — never department-scoped
  PREPPED // produced by a prep run
  STOCKED // held and issued exactly as bought (was PASS_THROUGH)
}

enum SupplierPaymentTerms {
  INVOICE_TO_FOLLOW // billed, settled later on account
  PAY_NOW // paid on the spot; no AP created
}

/// Owner-named labels for organising the catalog. Shared by items and
/// suppliers (Paper SRB-0 + SX5-0 both draw from one list).
model Category {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  name             String
  parentCategoryId String?   @map("parent_category_id") // one level only, service-enforced — see docs/DATA_MODEL.md §4.48
  deletedAt        DateTime? @map("deleted_at") // retire; never hard-delete
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  items        InventoryItem[]
  suppliers    Supplier[]

  // Case-insensitive uniqueness among LIVE categories only — enforced by a
  // partial unique index on lower(name) WHERE deleted_at IS NULL (raw SQL;
  // not expressible in the Prisma DSL). A retired "Seasonal" must not block
  // creating a new "Seasonal".
  @@index([organizationId])
  @@map("categories")
}

// ── Milestone Four — Requisition & Branch Approval ─────────────────────────
// A requisition is one document per branch-day-slot with exactly five
// sections, one per DepartmentTag. This milestone never writes to the
// inventory ledger — see docs/features/inventory/milestone-4-plan.md §0.
enum RequisitionType {
  MORNING
  AFTERNOON
  EVENING
  AD_HOC
}

enum RequisitionStatus {
  OPEN // sections still being filled; nothing submitted yet is fine
  PENDING_APPROVAL // at least one section submitted, not yet signed
  APPROVED // signed; visible in Central Store dispatch queue
}

enum RequisitionSectionStatus {
  NOT_STARTED
  DRAFT // head has unsaved/in-progress edits
  SUBMITTED
  RETURNED // bounced back by branch manager with a note
}

model Requisition {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id") // branch org
  type           RequisitionType
  note           String? // optional free text, e.g. distinguishing two same-day AD_HOC requisitions
  status         RequisitionStatus @default(OPEN)
  openedById     String            @map("opened_by_id")
  openedAt       DateTime          @default(now()) @map("opened_at")
  approvedById   String?           @map("approved_by_id")
  approvedAt     DateTime?         @map("approved_at")

  organization Organization         @relation(fields: [organizationId], references: [id])
  openedBy     User                 @relation("RequisitionOpenedBy", fields: [openedById], references: [id])
  approvedBy   User?                @relation("RequisitionApprovedBy", fields: [approvedById], references: [id])
  sections     RequisitionSection[]
  dispatches   Dispatch[]

  @@index([organizationId, status])
  @@map("requisitions")
}

model RequisitionSection {
  id            String                   @id @default(uuid())
  requisitionId String                   @map("requisition_id")
  departmentTag DepartmentTag            @map("department_tag")
  status        RequisitionSectionStatus @default(NOT_STARTED)
  submittedById String?                  @map("submitted_by_id")
  submittedAt   DateTime?                @map("submitted_at")
  returnedNote  String?                  @map("returned_note") // branch manager's reason, cleared on resubmit
  managerNote   String?                  @map("manager_note") // dept head's free-text "note for the manager"

  requisition Requisition       @relation(fields: [requisitionId], references: [id])
  submittedBy User?             @relation("RequisitionSectionSubmittedBy", fields: [submittedById], references: [id])
  lines       RequisitionLine[]

  @@unique([requisitionId, departmentTag])
  @@map("requisition_sections")
}

model RequisitionLine {
  id                   String    @id @default(uuid())
  requisitionSectionId String    @map("requisition_section_id")
  inventoryItemId      String    @map("inventory_item_id")
  parAtRequest         Decimal?  @map("par_at_request") @db.Decimal(12, 4) // reference only — null when no RestockLevel exists yet; see §0 deviation note
  requestedQty         Decimal?  @map("requested_qty") @db.Decimal(12, 4) // null = manager-added, head never asked
  approvedQty          Decimal?  @map("approved_qty") @db.Decimal(12, 4) // null until manager reviews
  addedFromNote        Boolean   @default(false) @map("added_from_note") // manager converted a note line to a real line
  editedById           String?   @map("edited_by_id") // who last changed approvedQty, if different from requestedQty
  editReason           String?   @map("edit_reason") // required by Flow 8 whenever approvedQty != requestedQty
  deletedAt            DateTime? @map("deleted_at") // manager delete — soft, keeps the audit trail

  section  RequisitionSection @relation(fields: [requisitionSectionId], references: [id])
  item     InventoryItem      @relation(fields: [inventoryItemId], references: [id])
  editedBy User?              @relation("RequisitionLineEditedBy", fields: [editedById], references: [id])

  @@index([requisitionSectionId])
  @@map("requisition_lines")
}

// ── Milestone Five — Dispatch & Branch Receiving (Session A) ───────────────
// One Dispatch per department per requisition (Flow 9 step 4), mirroring
// StaffTransfer's two-org pattern: organizationId = hub (Central Store owns
// the document), toOrganizationId = branch. sequenceLabel is a daily
// per-branch display label computed at write time, not a persistent
// ReferenceCounter id — see milestone-5-sessions/session-a-plan.md decision #1.
enum DispatchStatus {
  AWAITING // not yet signed by the store
  IN_TRANSIT // signed, dispatch_out written, not yet confirmed
  CONFIRMED // dispatch_in written, no discrepancy
  DISCREPANCY_OPEN // dispatch_in written but a line mismatched — stays open per Flow 10a
}

model Dispatch {
  id                String         @id @default(uuid())
  organizationId    String         @map("organization_id") // hub org — Central Store owns this document
  toOrganizationId  String         @map("to_organization_id") // branch org
  requisitionId     String         @map("requisition_id")
  departmentTag     DepartmentTag  @map("department_tag") // one Dispatch per department, per Flow 9 step 4
  sequenceLabel     String         @map("sequence_label") // "Dispatch 4 · Nyeri Town · 17 Sep" — daily per-branch sequence, not a persistent ID
  status            DispatchStatus @default(AWAITING)
  dispatchedById    String?        @map("dispatched_by_id")
  dispatchedAt      DateTime?      @map("dispatched_at")
  confirmedById     String?        @map("confirmed_by_id") // may differ from the department head if confirmed-on-behalf (Flow 10b)
  confirmedAt       DateTime?      @map("confirmed_at")
  confirmedOnBehalf Boolean        @default(false) @map("confirmed_on_behalf")

  organization             Organization   @relation("DispatchFrom", fields: [organizationId], references: [id])
  toOrganization           Organization   @relation("DispatchTo", fields: [toOrganizationId], references: [id])
  requisition              Requisition    @relation(fields: [requisitionId], references: [id])
  dispatchedBy             User?          @relation("DispatchDispatchedBy", fields: [dispatchedById], references: [id])
  confirmedBy              User?          @relation("DispatchConfirmedBy", fields: [confirmedById], references: [id])
  lines                    DispatchLine[]
  followUpForDiscrepancies Discrepancy[]  @relation("DiscrepancyFollowUpDispatch")

  @@index([organizationId, status])
  @@index([toOrganizationId, departmentTag, status])
  @@index([requisitionId])
  @@map("dispatches")
}

model DispatchLine {
  id                String   @id @default(uuid())
  dispatchId        String   @map("dispatch_id")
  requisitionLineId String?  @map("requisition_line_id") // null for a substitute line (Flow 9b)
  inventoryItemId   String   @map("inventory_item_id")
  requestedQty      Decimal? @map("requested_qty") @db.Decimal(12, 4)
  dispatchedQty     Decimal  @map("dispatched_qty") @db.Decimal(12, 4)
  confirmedQty      Decimal? @map("confirmed_qty") @db.Decimal(12, 4)
  costAtDispatch    Decimal  @map("cost_at_dispatch") @db.Decimal(12, 4) // frozen per line, per Flow 9 step 6
  isSubstitute      Boolean  @default(false) @map("is_substitute")
  substituteNote    String?  @map("substitute_note")

  dispatch      Dispatch               @relation(fields: [dispatchId], references: [id])
  item          InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  transactions  InventoryTransaction[]
  discrepancies Discrepancy[]

  @@index([dispatchId])
  @@map("dispatch_lines")
}

// ── Milestone Five — Dispatch & Branch Receiving (Session B) ───────────────
// Automatic on mismatched confirm (Flow 10a), never a separate user action.
// Numbered via ReferenceCounter ('DSC', hub-scoped) — same mechanism as
// GRN/ADJ, deliberately not Dispatch.sequenceLabel's daily-label scheme.
enum DiscrepancyStatus {
  OPEN
  RESOLVED
}

enum DiscrepancyOutcome {
  FOUND_REDELIVERED
  TRANSIT_LOSS_WRITEOFF
  MISCOUNT_CORRECTED
}

model Discrepancy {
  id                 String              @id @default(uuid())
  dispatchLineId     String              @map("dispatch_line_id")
  referenceNumber    String              @map("reference_number") // DSC-#### via ReferenceCounter
  gapQty             Decimal             @map("gap_qty") @db.Decimal(12, 4) // confirmed - dispatched, signed
  status             DiscrepancyStatus   @default(OPEN)
  outcome            DiscrepancyOutcome?
  resolutionNote     String?             @map("resolution_note")
  resolvedById       String?             @map("resolved_by_id")
  resolvedAt         DateTime?           @map("resolved_at")
  followUpDispatchId String?             @map("follow_up_dispatch_id")
  createdAt          DateTime            @default(now()) @map("created_at")

  dispatchLine     DispatchLine @relation(fields: [dispatchLineId], references: [id])
  resolvedBy       User?        @relation("DiscrepancyResolvedBy", fields: [resolvedById], references: [id])
  followUpDispatch Dispatch?    @relation("DiscrepancyFollowUpDispatch", fields: [followUpDispatchId], references: [id])

  @@index([status])
  @@index([dispatchLineId])
  @@map("discrepancies")
}

model InventoryItem {
  id                  String            @id @default(uuid())
  organizationId      String            @map("organization_id")
  name                String
  type                InventoryItemType
  categoryId          String?           @map("category_id")
  preferredSupplierId String?           @map("preferred_supplier_id")

  buyUnit          String   @map("buy_unit") // free text: bag, crate, jerrican, ctn
  usageUnit        String   @map("usage_unit") // free text: kg, L, ml, pcs
  conversionFactor Decimal? @map("conversion_factor") @db.Decimal(12, 4) // null = "no conversion"
  packSize         Decimal? @map("pack_size") @db.Decimal(12, 4) // null = "—"

  departmentTags DepartmentTag[] @map("department_tags") // MUST be [] when type = RAW_INGREDIENT
  currentCost    Decimal         @default(0) @map("current_cost") @db.Decimal(12, 4)

  deletedAt DateTime? @map("deleted_at") // retire; history preserved
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization           Organization            @relation(fields: [organizationId], references: [id])
  category               Category?               @relation(fields: [categoryId], references: [id])
  preferredSupplier      Supplier?               @relation(fields: [preferredSupplierId], references: [id])
  restockLevels          RestockLevel[]
  transactions           InventoryTransaction[]
  expectedDeliveryLines  ExpectedDeliveryLine[]
  goodsReceiptLines      GoodsReceiptLine[]
  prepRunsAsOutput       PrepRun[]               @relation("PrepRunOutput")
  prepRunInputLines      PrepRunInputLine[]      @relation("PrepRunInputItem")
  requisitionLines       RequisitionLine[]
  dispatchLines          DispatchLine[]
  wasteLogs              WasteLog[]
  stockCountLines        StockCountLine[]
  branchDayLines         BranchDayLine[]
  departmentOpeningLines DepartmentOpeningLine[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([organizationId, deletedAt]) // the catalog list's default filter
  @@map("inventory_items")
}

model Supplier {
  id                  String               @id @default(uuid())
  organizationId      String               @map("organization_id")
  name                String
  contactName         String?              @map("contact_name")
  categoryId          String?              @map("category_id")
  phone               String?
  email               String?
  location            String? // free text, e.g. "Nyeri town"
  defaultPaymentTerms SupplierPaymentTerms @default(INVOICE_TO_FOLLOW) @map("default_payment_terms")
  // Milestone Two (Receiving & Supplier AP), added 20260916: what makes an
  // invoice overdue. SupplierPaymentTerms says only WHETHER a supplier bills
  // on account, never WHEN it's due — the "what we owe" screens bucket
  // invoices by days overdue, which needs a due date to measure from.
  // Editable on the supplier form; default backfills existing rows (30 is a
  // starting assumption, not researched from real terms — review against
  // production suppliers before relying on it). See milestone-2-plan.md §1.3,
  // §7 Q3(b).
  paymentDays         Int                  @default(30) @map("payment_days")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id])
  category           Category?          @relation(fields: [categoryId], references: [id])
  preferredForItems  InventoryItem[]
  expectedDeliveries ExpectedDelivery[]
  goodsReceipts      GoodsReceipt[]
  supplierInvoices   SupplierInvoice[]
  supplierPayments   SupplierPayment[]

  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("suppliers")
}

/// Replaces ParLevel. One per (location, item). Set by whoever owns the stock:
/// Store Manager for the Central Store, each department head for their own
/// department (01-description.md §4).
model RestockLevel {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  locationId      String   @map("location_id")
  inventoryItemId String   @map("inventory_item_id")
  level           Decimal  @map("level") @db.Decimal(12, 4) // in the item's usage unit
  setById         String   @map("set_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id])
  location      Location      @relation(fields: [locationId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  setBy         User          @relation("RestockLevelSetBy", fields: [setById], references: [id])

  @@unique([locationId, inventoryItemId])
  @@index([organizationId])
  @@index([inventoryItemId])
  @@map("restock_levels")
}

// Full ledger enum ships now per feature plan §1 — only receive, prep_consume,
// prep_produce, waste, adjustment are written in Phase 1. dispatch_out,
// dispatch_in, market_receive, sale are reserved for Phase 2/3 and must not
// be restructured when those phases land.
enum InventoryTransactionType {
  RECEIVE
  PREP_CONSUME
  PREP_PRODUCE
  WASTE
  ADJUSTMENT
  DISPATCH_OUT
  DISPATCH_IN
  MARKET_RECEIVE
  SALE
}

// stockCountLineId/marketPurchaseLineId are retained as unlinked
// nullable columns: the models they referenced were dropped by Milestone One
// (plan §1.3/§4), and those ledger paths are still out of scope. Each is
// restored as a real FK when the milestone that rebuilds that flow lands.
// goodsReceiptLineId (formerly purchaseOrderLineId) was the first of these
// restored — Milestone Two (Receiving & Supplier AP) is the first writer to
// this ledger; see milestone-2-plan.md §1.6. prepRecordId is the second —
// Milestone Three (Prep) restores it as a real FK to PrepRun; see
// milestone-3-plan.md §1.2. dispatchLineId is the third — Milestone Five
// (Dispatch & Branch Receiving) restores it as a real FK to DispatchLine,
// the first writer of DISPATCH_OUT; see milestone-5-plan.md §1.2.
// wasteLogId is the fourth — Milestone Six Session 1 restores it as a real
// FK to WasteLog (milestone-6-plan.md §1.3). The same migration adds
// `reference` (ADJ-#### on ADJUSTMENT rows) and `reversesTransactionId`
// (equal-and-opposite reversal of a superseded adjustment, Flow 12b); both
// are first written in Sessions 2/3 (milestone-6-plan.md §1.7).
model InventoryTransaction {
  id                    String                   @id @default(uuid())
  organizationId        String                   @map("organization_id")
  locationId            String                   @map("location_id")
  inventoryItemId       String                   @map("inventory_item_id")
  type                  InventoryTransactionType
  quantity              Decimal                  @db.Decimal(12, 4)
  unitCost              Decimal                  @map("unit_cost") @db.Decimal(12, 4)
  reason                String?
  goodsReceiptLineId    String?                  @map("goods_receipt_line_id")
  prepRecordId          String?                  @map("prep_record_id")
  wasteLogId            String?                  @map("waste_log_id")
  stockCountLineId      String?                  @map("stock_count_line_id")
  branchDayLineId       String?                  @map("branch_day_line_id")
  openingLineId         String?                  @map("opening_line_id")
  dispatchLineId        String?                  @map("dispatch_line_id")
  marketPurchaseLineId  String?                  @map("market_purchase_line_id")
  reference             String? // ADJ-#### on ADJUSTMENT rows (ReferenceCounter), null elsewhere
  reversesTransactionId String?                  @unique @map("reverses_transaction_id") // a row is reversed at most once
  userId                String                   @map("user_id")
  createdAt             DateTime                 @default(now()) @map("created_at")

  organization     Organization           @relation(fields: [organizationId], references: [id])
  location         Location               @relation(fields: [locationId], references: [id])
  inventoryItem    InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  user             User                   @relation("InventoryTransactionUser", fields: [userId], references: [id])
  goodsReceiptLine GoodsReceiptLine?      @relation(fields: [goodsReceiptLineId], references: [id])
  prepRun          PrepRun?               @relation("PrepRunTransactions", fields: [prepRecordId], references: [id])
  dispatchLine     DispatchLine?          @relation(fields: [dispatchLineId], references: [id])
  wasteLog         WasteLog?              @relation(fields: [wasteLogId], references: [id])
  stockCountLine   StockCountLine?        @relation(fields: [stockCountLineId], references: [id])
  branchDayLine    BranchDayLine?         @relation(fields: [branchDayLineId], references: [id])
  openingLine      DepartmentOpeningLine? @relation(fields: [openingLineId], references: [id])
  reverses         InventoryTransaction?  @relation("InventoryTransactionReversal", fields: [reversesTransactionId], references: [id])
  reversedBy       InventoryTransaction?  @relation("InventoryTransactionReversal")

  @@index([organizationId])
  @@index([locationId])
  @@index([inventoryItemId])
  @@index([type])
  @@index([goodsReceiptLineId])
  @@index([prepRecordId])
  @@index([dispatchLineId])
  @@index([wasteLogId])
  @@index([stockCountLineId])
  @@index([branchDayLineId])
  @@index([openingLineId])
  @@index([locationId, inventoryItemId, createdAt]) // ledger drill: one item at one location, by time
  @@map("inventory_transactions")
}

// ── Milestone Six — Counting, Closing & Discrepancies (Session 1: waste) ────
// One row per logged waste entry (the design logs one item at a time). The
// ledger's negative WASTE row points back here through
// InventoryTransaction.wasteLogId. Not signed (Appendix B). Location is
// resolved server-side from the actor — Central Store for the store roles,
// the department's own location for a department head. milestone-6-plan.md §1.3.
enum WasteReason {
  SPOILAGE
  EXPIRY
  DAMAGE_IN_STORE
  PREP_ERROR
}

model WasteLog {
  id              String      @id @default(uuid())
  organizationId  String      @map("organization_id") // the location's org — hub for the Central Store, branch org for a department
  locationId      String      @map("location_id")
  inventoryItemId String      @map("inventory_item_id")
  quantity        Decimal     @db.Decimal(12, 4) // positive as entered; the ledger row carries the negative sign
  reason          WasteReason
  note            String?
  unitCost        Decimal     @map("unit_cost") @db.Decimal(12, 4) // CS: item currentCost now; department: latest DISPATCH_IN cost, else currentCost
  loggedById      String      @map("logged_by_id")
  createdAt       DateTime    @default(now()) @map("created_at")

  organization  Organization           @relation(fields: [organizationId], references: [id])
  location      Location               @relation(fields: [locationId], references: [id])
  inventoryItem InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  loggedBy      User                   @relation("WasteLogLoggedBy", fields: [loggedById], references: [id])
  transactions  InventoryTransaction[]

  @@index([organizationId, createdAt])
  @@index([locationId, createdAt])
  @@map("waste_logs")
}

// ── Milestone Six — Session 2: Central Store counting + thresholds ───────────
// One StockCount per (Central Store, business day) for DAILY — enforced by a
// partial unique index in the migration SQL (not expressible in the Prisma
// DSL); SPOT counts are unconstrained and are created VERIFIED in one step.
// expectedQty / unitCost / reasonRequired are snapshotted server-side at the
// attendant's sign (counterSignedAt) and never serialized to STORE_ATTENDANT.
// milestone-6-plan.md §1.1, §1.2, §1.9.
enum StockCountKind {
  DAILY
  SPOT
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
  RETURNED
  VERIFIED
}

enum CountLineDecision {
  PENDING
  ACCEPTED
  QUERIED
}

enum CountReason {
  SUSPECTED_MISCOUNT
  UNLOGGED_SPOILAGE
  SUSPECTED_LOSS
  WITHIN_NORMAL_RANGE
  OTHER
}

model StockCount {
  id               String           @id @default(uuid())
  organizationId   String           @map("organization_id") // hub org (D-15)
  locationId       String           @map("location_id") // Central Store
  kind             StockCountKind
  countDate        DateTime         @map("count_date") @db.Date // business date, Africa/Nairobi
  status           StockCountStatus @default(DRAFT)
  reference        String // CNT-YYYY-MMDD (daily) | SPT-#### (spot, ReferenceCounter)
  counterId        String           @map("counter_id") // attendant (daily) / Store Manager (spot)
  counterSignedAt  DateTime?        @map("counter_signed_at")
  verifierId       String?          @map("verifier_id")
  verifiedAt       DateTime?        @map("verified_at")
  returnNote       String?          @map("return_note")
  returnedAt       DateTime?        @map("returned_at")
  returnedById     String?          @map("returned_by_id")
  directorNotified Boolean          @default(false) @map("director_notified")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  location     Location         @relation(fields: [locationId], references: [id])
  counter      User             @relation("StockCountCounter", fields: [counterId], references: [id])
  verifier     User?            @relation("StockCountVerifier", fields: [verifierId], references: [id])
  returnedBy   User?            @relation("StockCountReturnedBy", fields: [returnedById], references: [id])
  lines        StockCountLine[]

  @@index([organizationId, kind, status])
  @@index([locationId, countDate])
  @@map("stock_counts")
}

model StockCountLine {
  id              String            @id @default(uuid())
  stockCountId    String            @map("stock_count_id")
  inventoryItemId String            @map("inventory_item_id")
  countedQty      Decimal?          @map("counted_qty") @db.Decimal(12, 4) // null = not counted; uncounted lines are never adjusted
  firstCountedQty Decimal?          @map("first_counted_qty") @db.Decimal(12, 4) // the figure before a send-back cleared it for a blind recount
  expectedQty     Decimal?          @map("expected_qty") @db.Decimal(12, 4) // ledger on-hand at counterSignedAt; never sent to the attendant
  unitCost        Decimal?          @map("unit_cost") @db.Decimal(12, 4) // frozen with the snapshot
  decision        CountLineDecision @default(PENDING)
  reason          CountReason?
  reasonNote      String?           @map("reason_note")
  reasonRequired  Boolean           @default(false) @map("reason_required") // judged against the threshold in force at submit
  queryNote       String?           @map("query_note") // per-line note to the attendant; never states the expected figure
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  stockCount    StockCount             @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  transactions  InventoryTransaction[]

  @@unique([stockCountId, inventoryItemId])
  @@index([inventoryItemId])
  @@map("stock_count_lines")
}

/// One row per organization, created lazily with defaults (plan §1.9). Values
/// are whole KES of |variance| × unit cost. Hub row: reasonRequiredKes (Store
/// Manager) + directorAlertKes (Director, company-wide). Branch rows (Session
/// 3): reasonRequiredKes + overnightAlertKes.
model CountingThresholds {
  id                  String    @id @default(uuid())
  organizationId      String    @unique @map("organization_id")
  reasonRequiredKes   Int       @map("reason_required_kes")
  overnightAlertKes   Int?      @map("overnight_alert_kes")
  directorAlertKes    Int?      @map("director_alert_kes")
  updatedById         String?   @map("updated_by_id")
  directorUpdatedById String?   @map("director_updated_by_id")
  directorUpdatedAt   DateTime? @map("director_updated_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization      Organization @relation(fields: [organizationId], references: [id])
  updatedBy         User?        @relation("CountingThresholdsUpdatedBy", fields: [updatedById], references: [id])
  directorUpdatedBy User?        @relation("CountingThresholdsDirectorUpdatedBy", fields: [directorUpdatedById], references: [id])

  @@map("counting_thresholds")
}

// ── Milestone Six, Session 3 — Branch day close (plan §1.4–1.5) ─────────────
// One BranchDay per (branch org, business date). The Branch Manager counts
// each department's stock, gives a reason for any gap at/above the branch
// threshold, and signs; the close posts one ADJUSTMENT per non-zero gap.
// BLOCKED is never stored — it is derived at read time from IN_TRANSIT
// dispatches to the department.
enum BranchDayStatus {
  OPEN
  CLOSED
}

enum BranchDayDepartmentStatus {
  NOT_STARTED
  COUNTED
}

enum GapReason {
  CONSUMPTION
  UNLOGGED_WASTE
  WALK_IN_COMP
  SUSPECTED_LOSS
  OTHER
}

model BranchDay {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id") // branch org
  businessDate   DateTime        @map("business_date") @db.Date // Africa/Nairobi
  status         BranchDayStatus @default(OPEN)
  reference      String // DAY-#### (ReferenceCounter)
  closedById     String?         @map("closed_by_id")
  closedAt       DateTime?       @map("closed_at")
  reopenCount    Int             @default(0) @map("reopen_count")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id])
  closedBy     User?                 @relation("BranchDayClosedBy", fields: [closedById], references: [id])
  departments  BranchDayDepartment[]
  reopens      BranchDayReopen[]
  openings     DepartmentOpening[]

  @@unique([organizationId, businessDate])
  @@index([organizationId, status])
  @@map("branch_days")
}

model BranchDayDepartment {
  id            String                    @id @default(uuid())
  branchDayId   String                    @map("branch_day_id")
  departmentTag DepartmentTag             @map("department_tag")
  locationId    String                    @map("location_id")
  status        BranchDayDepartmentStatus @default(NOT_STARTED)
  countedById   String?                   @map("counted_by_id")
  countedAt     DateTime?                 @map("counted_at")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")

  branchDay BranchDay       @relation(fields: [branchDayId], references: [id], onDelete: Cascade)
  location  Location        @relation(fields: [locationId], references: [id])
  countedBy User?           @relation("BranchDayDepartmentCountedBy", fields: [countedById], references: [id])
  lines     BranchDayLine[]

  @@unique([branchDayId, departmentTag])
  @@map("branch_day_departments")
}

model BranchDayLine {
  id                    String     @id @default(uuid())
  branchDayDepartmentId String     @map("branch_day_department_id")
  inventoryItemId       String     @map("inventory_item_id")
  countedQty            Decimal?   @map("counted_qty") @db.Decimal(12, 4) // null = not counted; uncounted lines are never adjusted
  expectedQty           Decimal    @map("expected_qty") @db.Decimal(12, 4) // department on-hand when this count was saved, excluding this day's own close adjustments
  unitCost              Decimal    @map("unit_cost") @db.Decimal(12, 4) // cost carried into the department, frozen with the snapshot
  reason                GapReason?
  reasonNote            String?    @map("reason_note")
  reasonRequired        Boolean    @default(false) @map("reason_required") // judged against the threshold in force when saved
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  department    BranchDayDepartment    @relation(fields: [branchDayDepartmentId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  transactions  InventoryTransaction[]

  @@unique([branchDayDepartmentId, inventoryItemId])
  @@index([inventoryItemId])
  @@map("branch_day_lines")
}

/// Immutable, append-only audit of every reopen (plan §1.5).
model BranchDayReopen {
  id           String   @id @default(uuid())
  branchDayId  String   @map("branch_day_id")
  reopenedById String   @map("reopened_by_id")
  reopenedAt   DateTime @default(now()) @map("reopened_at")
  reason       String

  branchDay  BranchDay @relation(fields: [branchDayId], references: [id], onDelete: Cascade)
  reopenedBy User      @relation("BranchDayReopenedBy", fields: [reopenedById], references: [id])

  @@index([branchDayId])
  @@map("branch_day_reopens")
}

/// Next-morning opening (Flow 12c, plan §1.6): the department head accepts the
/// morning figures. Created only on accept — "not accepted yet" is no row.
model DepartmentOpening {
  id            String        @id @default(uuid())
  branchDayId   String        @map("branch_day_id") // the day being opened
  departmentTag DepartmentTag @map("department_tag")
  locationId    String        @map("location_id")
  acceptedById  String        @map("accepted_by_id")
  acceptedAt    DateTime      @map("accepted_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  branchDay  BranchDay               @relation(fields: [branchDayId], references: [id], onDelete: Cascade)
  location   Location                @relation(fields: [locationId], references: [id])
  acceptedBy User                    @relation("DepartmentOpeningAcceptedBy", fields: [acceptedById], references: [id])
  lines      DepartmentOpeningLine[]

  @@unique([branchDayId, departmentTag])
  @@map("department_openings")
}

model DepartmentOpeningLine {
  id                String   @id @default(uuid())
  openingId         String   @map("opening_id")
  inventoryItemId   String   @map("inventory_item_id")
  prefilledQty      Decimal  @map("prefilled_qty") @db.Decimal(12, 4) // department on-hand the ledger showed (last night's close)
  acceptedQty       Decimal  @map("accepted_qty") @db.Decimal(12, 4) // what the department head counted; authoritative
  overnightVariance Decimal  @map("overnight_variance") @db.Decimal(12, 4) // accepted − prefilled
  unitCost          Decimal  @map("unit_cost") @db.Decimal(12, 4)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  opening       DepartmentOpening      @relation(fields: [openingId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  transactions  InventoryTransaction[]

  @@unique([openingId, inventoryItemId])
  @@index([inventoryItemId])
  @@map("department_opening_lines")
}

// ============================================================================
// Milestone Two — Receiving & Supplier AP
// Stage 1 (Buying/estimate), Stage 2 (Receiving), Stage 10 (Supplier payment).
// Plan: docs/features/inventory/milestone-2-plan.md.
// ============================================================================

/// Reference-number counters (GRN-, EXP-, …), one row per (org, prefix).
/// Incremented inside the same transaction as the document it numbers, so
/// numbers stay gap-free — a printed, signed document with a missing number
/// looks like a lost record with no way to prove otherwise. Same pattern as
/// OrderCounter, generalized across document types instead of reset per day.
model ReferenceCounter {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  prefix         String // "GRN", "EXP"
  lastNumber     Int      @default(0) @map("last_number")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, prefix])
  @@index([organizationId])
  @@map("reference_counters")
}

enum ExpectedDeliveryStatus {
  AWAITING
  FULFILLED
  CANCELLED
}

/// Stage 1 (Buying) — an estimate, explicitly NOT a purchase order
/// (01-description.md §3 Stage 1, §7: "Purchase orders are removed
/// entirely"). Writes no ledger entry; the goods receipt (below) is the only
/// thing that ever moves stock.
model ExpectedDelivery {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  reference      String // "EXP-0091", generated via ReferenceCounter
  // AMENDMENT 2026-09-17 (New purchase redesign, receiving-validators.ts):
  // nullable — a purchase list may be saved with no supplier (a pure shopping
  // list). paymentTerms is nullable in lockstep: terms are meaningless without
  // a supplier to owe them to, and the New-purchase screen greys the field out
  // until a supplier is picked. See receiving-validators.ts's header comment
  // for the full amendment record.
  supplierId     String?                @map("supplier_id")
  paymentTerms   SupplierPaymentTerms?  @map("payment_terms") // defaulted from supplier, per-record; null when supplierId is null
  status         ExpectedDeliveryStatus @default(AWAITING)
  expectedDate   DateTime?              @map("expected_date")
  // Stored, not derived: an estimate that never needs to reconcile with
  // anything (the receipt supersedes it) — storing avoids a per-row line
  // aggregation on the Purchasing hub's hottest query. See plan §1.1.
  estimatedTotal Decimal                @default(0) @map("estimated_total") @db.Decimal(12, 2)
  createdById    String                 @map("created_by_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  organization  Organization           @relation(fields: [organizationId], references: [id])
  supplier      Supplier?              @relation(fields: [supplierId], references: [id])
  createdBy     User                   @relation("ExpectedDeliveryCreatedBy", fields: [createdById], references: [id])
  lines         ExpectedDeliveryLine[]
  goodsReceipts GoodsReceipt[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([supplierId])
  @@map("expected_deliveries")
}

model ExpectedDeliveryLine {
  id                 String  @id @default(uuid())
  expectedDeliveryId String  @map("expected_delivery_id")
  inventoryItemId    String  @map("inventory_item_id")
  quantity           Decimal @db.Decimal(12, 4) // in the item's BUY unit
  estimatedUnitPrice Decimal @map("estimated_unit_price") @db.Decimal(12, 4)
  lineOrder          Int     @map("line_order")

  expectedDelivery ExpectedDelivery @relation(fields: [expectedDeliveryId], references: [id], onDelete: Cascade)
  inventoryItem    InventoryItem    @relation(fields: [inventoryItemId], references: [id])

  @@index([expectedDeliveryId])
  @@index([inventoryItemId])
  @@map("expected_delivery_lines")
}

/// DRAFT holds an unsigned receipt (UQE-0's "Save draft" vs "Sign & save");
/// no ledger rows exist while DRAFT. RECEIVED_INVOICE_PENDING vs RECEIVED_PAID
/// is the payment-terms branch that decides whether AP is ever created
/// (01-description.md §3 Stage 2). INVOICE_RECORDED is set once Flow 14 runs.
enum GoodsReceiptStatus {
  DRAFT
  RECEIVED_INVOICE_PENDING
  RECEIVED_PAID
  INVOICE_RECORDED
  CANCELLED
}

/// Stage 2 (Receiving) — every item entering the company lands here first
/// (01-description.md §3 Stage 2: "There is no other inbound path"). The
/// first writer to InventoryTransaction (plan §0, §1.6).
model GoodsReceipt {
  id                 String               @id @default(uuid())
  organizationId     String               @map("organization_id")
  reference          String // "GRN-1042", generated via ReferenceCounter
  supplierId         String               @map("supplier_id")
  expectedDeliveryId String?              @map("expected_delivery_id") // nullable: receiving without an estimate is allowed (Flow 1)
  paymentTerms       SupplierPaymentTerms @map("payment_terms") // defaulted from supplier, editable per receipt
  status             GoodsReceiptStatus   @default(DRAFT)
  supplierDocNumber  String?              @map("supplier_doc_number") // "INVOICE / DELIVERY NOTE No." — nullable per Flow 2a
  supplierDocDate    DateTime?            @map("supplier_doc_date")
  receiptTotal       Decimal              @default(0) @map("receipt_total") @db.Decimal(12, 2) // snapshot at signing, immutable
  locationId         String               @map("location_id") // the CENTRAL_STORE location
  signedById         String?              @map("signed_by_id")
  signedAt           DateTime?            @map("signed_at")
  createdById        String               @map("created_by_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  organization     Organization             @relation(fields: [organizationId], references: [id])
  supplier         Supplier                 @relation(fields: [supplierId], references: [id])
  expectedDelivery ExpectedDelivery?        @relation(fields: [expectedDeliveryId], references: [id])
  location         Location                 @relation(fields: [locationId], references: [id])
  signedBy         User?                    @relation("GoodsReceiptSignedBy", fields: [signedById], references: [id])
  createdBy        User                     @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id])
  lines            GoodsReceiptLine[]
  invoices         SupplierInvoiceReceipt[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([supplierId])
  @@index([expectedDeliveryId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                     String   @id @default(uuid())
  goodsReceiptId         String   @map("goods_receipt_id")
  inventoryItemId        String   @map("inventory_item_id")
  quantityBuyUnit        Decimal  @map("quantity_buy_unit") @db.Decimal(12, 4) // as entered ("18.0 kg", "2 pkt")
  quantityUsageUnit      Decimal  @map("quantity_usage_unit") @db.Decimal(12, 4) // computed at save via conversionFactor; what hits the ledger
  unitPrice              Decimal  @map("unit_price") @db.Decimal(12, 4) // per BUY unit, as invoiced
  lineTotal              Decimal  @map("line_total") @db.Decimal(12, 2)
  lineOrder              Int      @map("line_order")
  // Price-alert snapshot — persisted, never recomputed. By the time the
  // signed receipt is read back, latest-price costing has already
  // overwritten InventoryItem.currentCost, so the comparison price is gone.
  // See plan §1.2.
  priceAlertPct          Decimal? @map("price_alert_pct") @db.Decimal(6, 2) // null = no alert fired
  priceAlertPrevPrice    Decimal? @map("price_alert_prev_price") @db.Decimal(12, 4)
  priceAlertAcceptedById String?  @map("price_alert_accepted_by_id")

  goodsReceipt         GoodsReceipt           @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  inventoryItem        InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  priceAlertAcceptedBy User?                  @relation("GoodsReceiptLinePriceAlertAcceptedBy", fields: [priceAlertAcceptedById], references: [id])
  ledgerTransactions   InventoryTransaction[]

  @@index([goodsReceiptId])
  @@index([inventoryItemId])
  @@map("goods_receipt_lines")
}

enum SupplierInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

/// Deliberately NOT folded into SupplierInvoiceStatus — a disputed invoice
/// still ages and can still be paid (Flow 17a), so dispute and payment status
/// must be independently representable. See plan §1.3.
enum DisputeStatus {
  OPEN
  RESOLVED
}

/// Stage 10 (Supplier payment) — a running tab per supplier, Flow 14.
model SupplierInvoice {
  id               String                @id @default(uuid())
  organizationId   String                @map("organization_id")
  supplierId       String                @map("supplier_id")
  invoiceNumber    String                @map("invoice_number") // supplier's own number
  invoiceDate      DateTime              @map("invoice_date")
  // Computed once at creation as invoiceDate + supplier.paymentDays, then
  // stored — a later change to the supplier's terms must not retroactively
  // shift the due date of an invoice already on the books. See plan §1.3.
  dueDate          DateTime              @map("due_date")
  amountBilled     Decimal               @map("amount_billed") @db.Decimal(12, 2) // as stated on their document
  status           SupplierInvoiceStatus @default(UNPAID)
  disputeStatus    DisputeStatus?        @map("dispute_status")
  disputeOurFigure Decimal?              @map("dispute_our_figure") @db.Decimal(12, 2)
  disputeReason    String?               @map("dispute_reason")
  recordedById     String                @map("recorded_by_id")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  organization Organization                @relation(fields: [organizationId], references: [id])
  supplier     Supplier                    @relation(fields: [supplierId], references: [id])
  recordedBy   User                        @relation("SupplierInvoiceRecordedBy", fields: [recordedById], references: [id])
  receipts     SupplierInvoiceReceipt[]
  adjustments  SupplierInvoiceAdjustment[]
  allocations  SupplierPaymentAllocation[]

  @@unique([organizationId, supplierId, invoiceNumber])
  @@index([organizationId, status])
  @@index([supplierId, dueDate])
  @@map("supplier_invoices")
}

/// Join — an invoice bundles MANY receipts (UZJ-0's "RECEIPTS TO BUNDLE"
/// checkbox list; Flow 14: "One invoice covers multiple receipts").
model SupplierInvoiceReceipt {
  supplierInvoiceId String @map("supplier_invoice_id")
  goodsReceiptId    String @map("goods_receipt_id")

  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  goodsReceipt    GoodsReceipt    @relation(fields: [goodsReceiptId], references: [id])

  @@id([supplierInvoiceId, goodsReceiptId])
  @@index([goodsReceiptId])
  @@map("supplier_invoice_receipts")
}

/// The Accountant's reconciliation adjustment (Flow 17) — mandatory reason,
/// changes the invoice's outstanding figure. No stock ledger entry; the
/// Accountant cannot move stock (01-description.md §2).
model SupplierInvoiceAdjustment {
  id                String   @id @default(uuid())
  supplierInvoiceId String   @map("supplier_invoice_id")
  amount            Decimal  @db.Decimal(12, 2)
  reason            String
  recordedById      String   @map("recorded_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  recordedBy      User            @relation("SupplierInvoiceAdjustmentRecordedBy", fields: [recordedById], references: [id])

  @@index([supplierInvoiceId])
  @@map("supplier_invoice_adjustments")
}

enum SupplierPaymentMethod {
  BANK
  CASH
  MPESA
}

/// Flow 15 — payments are immutable once saved; a correction is a reversal
/// (negative allocation) with a reason, never an edit or delete.
model SupplierPayment {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  supplierId     String                @map("supplier_id")
  amount         Decimal               @db.Decimal(12, 2) // may exceed the sum of allocations -> credit
  paidAt         DateTime              @map("paid_at")
  method         SupplierPaymentMethod
  reference      String? // "EFT-88213"
  reversalOfId   String?               @map("reversal_of_id")
  reversalReason String?               @map("reversal_reason")
  recordedById   String                @map("recorded_by_id")
  createdAt      DateTime              @default(now()) @map("created_at")

  organization Organization                @relation(fields: [organizationId], references: [id])
  supplier     Supplier                    @relation(fields: [supplierId], references: [id])
  recordedBy   User                        @relation("SupplierPaymentRecordedBy", fields: [recordedById], references: [id])
  reversalOf   SupplierPayment?            @relation("SupplierPaymentReversal", fields: [reversalOfId], references: [id])
  reversals    SupplierPayment[]           @relation("SupplierPaymentReversal")
  allocations  SupplierPaymentAllocation[]

  @@index([organizationId, supplierId])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id                String  @id @default(uuid())
  supplierPaymentId String  @map("supplier_payment_id")
  supplierInvoiceId String  @map("supplier_invoice_id")
  amount            Decimal @db.Decimal(12, 2) // negative allowed ONLY on a reversal payment's allocation

  supplierPayment SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id])

  @@unique([supplierPaymentId, supplierInvoiceId])
  @@index([supplierInvoiceId])
  @@map("supplier_payment_allocations")
}

// ============================================================================
// Milestone Three — Prep
// Stage 3 (after-the-fact prep run recording: inputs consumed -> output
// produced, one atomic ledger transaction). Second writer to the stock
// ledger after Milestone Two, and the first writer of a negative-signed
// ledger row (PREP_CONSUME) — see PrepRunInputLine's comment.
// Plan: docs/features/inventory/milestone-3-plan.md §1.
// ============================================================================

/// One run = one output item produced from N input lines, in one atomic
/// transaction. No reference number (unlike GoodsReceipt/ExpectedDelivery) —
/// checked against all 8 approved Paper screens, none show one; a run is
/// identified by when/output/attendant instead (plan §1.1). No updatedAt, no
/// status enum, no signature fields — immutable from the instant it's
/// confirmed (Flow 3's "prep runs are immutable once confirmed... to keep the
/// ledger append-only"); there is no PATCH/DELETE endpoint, ever.
model PrepRun {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  outputItemId          String   @map("output_item_id")
  actualYield           Decimal  @map("actual_yield") @db.Decimal(12, 4)
  /// Snapshot: totalInputCost / actualYield. Becomes InventoryItem.currentCost
  /// on the output item at write time (latest-price costing, no averaging).
  outputUnitCost        Decimal  @map("output_unit_cost") @db.Decimal(12, 4)
  /// Snapshot, sum of input lines' lineCost — stored, not derived, so an
  /// immutable record doesn't drift if a later query changes how it's
  /// computed (same rationale as GoodsReceipt.receiptTotal).
  totalInputCost        Decimal  @map("total_input_cost") @db.Decimal(12, 2)
  /// The rolling-average figure shown on the Confirm screen at the moment of
  /// this run, snapshotted — null only when no prior runs exist for this
  /// output item yet (plan §1.3). Never recomputed against a later, now-
  /// different rolling average.
  typicalYieldAtRunTime Decimal? @map("typical_yield_at_run_time") @db.Decimal(12, 4)
  /// 'normal' | 'low yield' | 'high yield', derived at write time from
  /// actualYield vs typicalYieldAtRunTime against the ±15% warn threshold
  /// (plan §6 Q1). Null ONLY when typicalYieldAtRunTime is null (no data to
  /// compare against, unflaggable) — once a typical exists, this is always
  /// one of the three string values, never left null, so a 'normal' run and
  /// an "insufficient data" run stay distinguishable (contract gap resolved
  /// at S0 build time, prep-validators.ts's own header comment).
  yieldVarianceLabel    String?  @map("yield_variance_label")
  /// Did this run cross the ±35% notify-Store-Manager threshold (plan §6
  /// Q1)? Records the fact only — no notification delivery is built this
  /// milestone (plan §0).
  notifiedStoreManager  Boolean  @default(false) @map("notified_store_manager")
  locationId            String   @map("location_id") // Central Store, same pattern as GoodsReceipt.locationId
  createdById           String   @map("created_by_id") // the Attendant (or SM, desktop) who recorded it
  createdAt             DateTime @default(now()) @map("created_at")

  organization Organization           @relation(fields: [organizationId], references: [id])
  outputItem   InventoryItem          @relation("PrepRunOutput", fields: [outputItemId], references: [id])
  location     Location               @relation(fields: [locationId], references: [id])
  createdBy    User                   @relation("PrepRunCreatedBy", fields: [createdById], references: [id])
  inputLines   PrepRunInputLine[]
  transactions InventoryTransaction[] @relation("PrepRunTransactions")

  @@index([organizationId])
  @@index([organizationId, outputItemId]) // rolling-average query, History "Output" filter
  @@index([locationId])
  @@map("prep_runs")
}

model PrepRunInputLine {
  id                String  @id @default(uuid())
  prepRunId         String  @map("prep_run_id")
  /// May itself be a prepped item — two-stage prep is allowed (Flow 3): the
  /// output of one PrepRun can be the input of another.
  inputItemId       String  @map("input_item_id")
  quantity          Decimal @db.Decimal(12, 4)
  /// Snapshot of InventoryItem.currentCost at the moment consumed — must
  /// never be recomputed later, since the input's cost keeps moving after
  /// this run (more receipts, more prep). Same immutability principle as
  /// GoodsReceiptLine.priceAlertPrevPrice.
  unitCostAtRunTime Decimal @map("unit_cost_at_run_time") @db.Decimal(12, 4)
  /// quantity * unitCostAtRunTime, stored.
  lineCost          Decimal @map("line_cost") @db.Decimal(12, 2)
  lineOrder         Int     @map("line_order")

  prepRun   PrepRun       @relation(fields: [prepRunId], references: [id], onDelete: Cascade)
  inputItem InventoryItem @relation("PrepRunInputItem", fields: [inputItemId], references: [id])

  @@index([prepRunId])
  @@index([inputItemId])
  @@map("prep_run_input_lines")
}
